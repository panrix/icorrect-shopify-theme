[Unit]
Description=iCorrect public same-day eligibility + slot reserve
After=network.target

[Service]
Type=simple
User=ricky
WorkingDirectory=/home/ricky/apps/same-day-eligibility-proxy
EnvironmentFile=-/home/ricky/config/api-keys/.env
Environment=PORT=8061
Environment=SAME_DAY_PROTOTYPE_STOCK=0
Environment=SAME_DAY_BANDS_JSON=/home/ricky/apps/same-day-eligibility-proxy/courier-london-bands.json
Environment=SAME_DAY_HANDLE_MAP=/home/ricky/apps/same-day-eligibility-proxy/handle-map.json
Environment=SAME_DAY_SLOTS_JSON=/home/ricky/apps/same-day-eligibility-proxy/data/slots.json
Environment=SAME_DAY_PRODUCTS_BOARD_ID=2477699024
Environment=SAME_DAY_PRODUCT_ID_COLUMN=text_mkzdte13
ExecStart=/usr/bin/node /home/ricky/apps/same-day-eligibility-proxy/server.js
Restart=on-failure
RestartSec=3
StandardOutput=journal
StandardError=journal
SyslogIdentifier=same-day-eligibility

[Install]
WantedBy=multi-user.target
