{%- comment -%}
  Decides the part-quality badge for a repair product, without guessing.

  Order of precedence:
  1. Product metafield custom.part_badge (free text) — per-product override.
     Tag "no-part-badge" hides the badge entirely.
  2. The title's own qualifier, e.g. "(Genuine OLED)", "(Original
     Specification)". Only genuine / original wording shows as a green
     badge; anything else ("Soft OLED", "No Power or Liquid Damage") shows
     as a neutral note.
  3. The default for the repair type from Theme settings > Repair pages >
     Part badges ("repair-type: label" per line). Screens, displays, glass
     and batteries have no default on purpose: they are sold in genuine and
     aftermarket variants, so the title must say which.
  Titles or tags containing "aftermarket" never receive a default badge.

  Accepts:
  - product: {Object} product
  - repair: {String} repair key from repair-meta
  - qualifier: {String} qualifier from repair-meta

  A neutral title note ("Rear Glass Repair") does not block the default
  badge; both are returned.

  Outputs "kind|label" entries joined by "~" (kind is ok or note), or nothing.
{%- endcomment -%}
{%- liquid
  assign out = ''
  assign done = false

  if product.tags contains 'no-part-badge'
    assign done = true
  endif

  if done == false
    assign override = product.metafields.custom.part_badge.value | default: product.metafields.custom.part_badge
    if override != blank
      assign out = 'ok|' | append: override
      assign done = true
    endif
  endif

  assign tl = product.title | downcase
  assign tag_text = product.tags | join: ' ' | downcase
  assign aftermarket = false
  if tl contains 'aftermarket' or tag_text contains 'aftermarket'
    assign aftermarket = true
  endif

  assign note = ''
  if done == false and qualifier != blank
    assign ql = qualifier | downcase
    assign note = 'note|' | append: qualifier
    if aftermarket == false
      if ql contains 'genuine' or ql contains 'original' or ql contains 'apple'
        assign out = 'ok|' | append: qualifier
        assign note = ''
        assign done = true
      endif
    endif
    if note != blank and aftermarket
      assign done = true
    endif
  endif

  if done == false and aftermarket == false
    assign defaults = settings.repair_part_badges
    if defaults == nil
      assign defaults = 'charging-port: Genuine charging port|rear-glass: Genuine rear glass|rear-camera: Genuine rear camera|rear-camera-lens: Genuine camera lens|front-camera: Genuine front camera|earpiece: Genuine earpiece speaker|loudspeaker: Genuine loudspeaker|microphone: Genuine microphone|button: Genuine buttons|heart-rate: Genuine heart-rate sensor|trackpad: Genuine trackpad|keyboard: Genuine keys'
    endif
    assign lines = defaults | newline_to_br | replace: '<br />', '|' | split: '|'
    for line in lines
      assign l = line | strip
      assign l_key_raw = l | split: ':' | first
      assign l_key = l_key_raw | strip | downcase
      if l_key == repair
        assign label = l | remove_first: l_key_raw | remove_first: ':' | strip
        if label != blank
          assign out = 'ok|' | append: label
        endif
      endif
    endfor
  endif

  if note != blank
    if out != blank
      assign out = out | append: '~' | append: note
    else
      assign out = note
    endif
  endif
  echo out
-%}
