{% doc %}
  Starting price and one courier line for a MacBook page.
  Price line is 14px semi-bold in the brand colour. Courier line is 14px regular.
  Both are centred under the H1. Courier wording matches the site.
  Collection is not described as free, because that only applies once the repair is £200 or more.

  @param {collection} [price_collection] - Collection to price. Defaults to the current collection, or the screen price list on the MacBook repairs page.
  @param {boolean} [show_klarna] - Show the Klarna placement under the from-price.
{% enddoc %}
{%- liquid
  assign price_source = price_collection
  if price_source == blank and request.page_type == 'page' and page.handle == 'macbook-repairs'
    assign price_source = collections['macbook-screen-repair-prices']
  endif
  if price_source == blank
    assign price_source = collection
  endif

  assign show_offer = false
  assign offer_handle = price_source.handle | default: ''
  if request.page_type == 'page' and page.handle == 'macbook-repairs'
    assign show_offer = true
    assign offer_handle = 'macbook-repairs'
  elsif offer_handle contains 'macbook'
    unless offer_handle contains 'london'
      assign show_offer = true
    endunless
  endif
-%}
{%- if show_offer -%}
  {%- capture from_cents_raw -%}{%- render 'macbook-from-cents', price_collection: price_source -%}{%- endcapture -%}
  {%- assign from_cents = from_cents_raw | strip | plus: 0 -%}
  {%- if from_cents > 0 -%}
    {%- liquid
      assign from_label = 'Repairs from'
      if offer_handle contains 'screen' or offer_handle == 'macbook-repairs'
        assign from_label = 'Screen replacement from'
      elsif offer_handle contains 'keyboard'
        assign from_label = 'Keyboard replacement from'
      elsif offer_handle contains 'battery'
        assign from_label = 'Battery replacement from'
      elsif offer_handle contains 'trackpad'
        assign from_label = 'Trackpad repair from'
      elsif offer_handle contains 'flexgate'
        assign from_label = 'Flexgate repair from'
      elsif offer_handle contains 'dustgate'
        assign from_label = 'Dustgate repair from'
      elsif offer_handle contains 'touch-bar' or offer_handle contains 'touchbar'
        assign from_label = 'Touch Bar repair from'
      elsif offer_handle contains 'charging' or offer_handle contains 'c-port'
        assign from_label = 'Charging port repair from'
      elsif offer_handle contains 'diagnostic'
        assign from_label = 'Diagnostic from'
      endif
      assign from_money = from_cents | money_without_trailing_zeros
    -%}
    <p class="macbook-from-price">{{ from_label }} {{ from_money }}</p>
    {%- if show_klarna -%}
      {% render 'macbook-klarna-placement', purchase_amount: from_cents %}
    {%- endif -%}
  {%- endif -%}
  <p class="macbook-benefit">Courier collection across London, tracked mail-in nationwide.</p>
  <style>
    /* Beat section paragraph rules (.about-info-row p is 0,2,1).
       body p in base.css no longer matches these classes, so the 16px and 17px sizes do not apply. */
    .about-info-row p.macbook-from-price.macbook-from-price,
    .parent-categories-info p.macbook-from-price.macbook-from-price,
    .repair-section-header p.macbook-from-price.macbook-from-price,
    .qw-section p.macbook-from-price.macbook-from-price,
    .page-width p.macbook-from-price.macbook-from-price,
    .about-info-row p.macbook-benefit.macbook-benefit,
    .parent-categories-info p.macbook-benefit.macbook-benefit,
    .repair-section-header p.macbook-benefit.macbook-benefit,
    .qw-section p.macbook-benefit.macbook-benefit,
    .page-width p.macbook-benefit.macbook-benefit {
      display: block;
      width: 100%;
      margin: 0 0 6px;
      font-size: 14px;
      line-height: 1.4;
      letter-spacing: 0;
      font-weight: 600;
      color: #1d1d1f;
      text-align: center;
    }
    .about-info-row p.macbook-benefit.macbook-benefit,
    .parent-categories-info p.macbook-benefit.macbook-benefit,
    .repair-section-header p.macbook-benefit.macbook-benefit,
    .qw-section p.macbook-benefit.macbook-benefit,
    .page-width p.macbook-benefit.macbook-benefit {
      font-weight: 400;
      color: #6e6e73;
      margin-bottom: 0;
    }
  </style>
{%- endif -%}
