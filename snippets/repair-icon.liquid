{%- comment -%}
  Line icon set for repair types, device families and trust facts.
  Drawn on the same 24px / 1.5 stroke grid as the Quote Wizard icons so both
  read as one system. Unknown keys fall back to the wrench.

  Accepts:
  - icon: {String} repair key from repair-meta, a family key, or a utility key
    (check, shield, clock, courier, arrow)
  - family: {String} device family; changes the outline used by "screen"
  - size: {Number} pixel size (default 24)
  - class: {String} extra class names

  Usage:
  {% render 'repair-icon', icon: 'battery', size: 22 %}
{%- endcomment -%}
{%- liquid
  assign size = size | default: 24
  case icon
    when 'screen', 'glass', 'display'
      case family
        when 'macbook'
          assign outline = '<rect x="3" y="3.5" width="18" height="12" rx="1.5"/><path d="M1.5 19.5h21"/>'
          assign mark_crack = '<path d="M11 6.5l1.6 2.4-2 1.6 2.6 2.8"/>'
          assign mark_shatter = '<path d="M13 9.5l-2-2.5M13 9.5l2.5-2M13 9.5l2.5 1.5M13 9.5l-.5 3M13 9.5l-3 1"/>'
          assign mark_display = '<path d="M8 3.5v12M10 3.5v12"/><circle cx="15" cy="11" r="1.6"/>'
        when 'ipad'
          assign outline = '<rect x="4" y="2" width="16" height="20" rx="2.5"/>'
          assign mark_crack = '<path d="M11 6l1.8 3-2.3 2 3 3.5"/>'
          assign mark_shatter = '<path d="M13 9l-2.5-3M13 9l3-2.5M13 9l3 1.5M13 9l-1 3.5M13 9l-3.5 1"/>'
          assign mark_display = '<path d="M8.5 2v20M10.5 2v20"/><circle cx="15" cy="15" r="1.8"/>'
        when 'watch'
          assign outline = '<rect x="5" y="5.5" width="14" height="13" rx="4"/><path d="M8.5 5.5V2.5h7v3M8.5 18.5v3h7v-3"/>'
          assign mark_crack = '<path d="M11 8.5l1.5 2-1.5 1.5 2 2"/>'
          assign mark_shatter = '<path d="M13 11l-2-2.5M13 11l2-1.8M13 11l2.2 1.2M13 11l-.4 2.6M13 11l-2.6.8"/>'
          assign mark_display = '<path d="M9 5.5v13M11 5.5v13"/><circle cx="15" cy="14" r="1.4"/>'
        else
          assign outline = '<rect x="6" y="2" width="12" height="20" rx="2.6"/><path d="M10.5 5.5h3"/>'
          assign mark_crack = '<path d="M11 8.5l1.8 2.6-2.1 1.7 2.6 3.2"/>'
          assign mark_shatter = '<path d="M13 10.5l-2-3M13 10.5l2.5-2.2M13 10.5l2.5 1.2M13 10.5l-.6 3.2M13 10.5l-3 1.2"/>'
          assign mark_display = '<path d="M9 7v14M10.8 7v14"/><circle cx="14.5" cy="15.5" r="1.6"/>'
      endcase
      case icon
        when 'glass'
          assign paths = outline | append: mark_shatter
        when 'display'
          assign paths = outline | append: mark_display
        else
          assign paths = outline | append: mark_crack
      endcase
    when 'battery'
      assign paths = '<rect x="2.5" y="7" width="17" height="10" rx="2.2"/><path d="M21.5 10.5v3"/><path d="M11.8 9.2l-2 3h3l-2 3"/>'
    when 'charging-port'
      assign paths = '<path d="M9 2.5v4.5M15 2.5v4.5"/><path d="M6.5 7h11v3a5.5 5.5 0 0 1-11 0V7z"/><path d="M12 15.5v6"/>'
    when 'rear-camera'
      assign paths = '<path d="M3 8.5a2 2 0 0 1 2-2h2.2l1.6-2.5h6.4l1.6 2.5H19a2 2 0 0 1 2 2V18a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><circle cx="12" cy="13" r="3.8"/>'
    when 'rear-camera-lens'
      assign paths = '<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="4.5"/><path d="M10 9.4a3 3 0 0 1 2.2-.9"/>'
    when 'front-camera'
      assign paths = '<path d="M4 8V5a1 1 0 0 1 1-1h3M16 4h3a1 1 0 0 1 1 1v3M20 16v3a1 1 0 0 1-1 1h-3M8 20H5a1 1 0 0 1-1-1v-3"/><circle cx="12" cy="10" r="2.6"/><path d="M7.5 17.2a4.5 4.5 0 0 1 9 0"/>'
    when 'face-id'
      assign paths = '<path d="M4 8V5a1 1 0 0 1 1-1h3M16 4h3a1 1 0 0 1 1 1v3M20 16v3a1 1 0 0 1-1 1h-3M8 20H5a1 1 0 0 1-1-1v-3"/><path d="M9 9v1.5M15 9v1.5M12.5 9v3.8h-1M9.5 15.8a3.6 3.6 0 0 0 5 0"/>'
    when 'rear-glass'
      assign paths = '<rect x="6" y="2" width="12" height="20" rx="2.6"/><rect x="8.4" y="4.4" width="4.6" height="4.6" rx="1.3"/><path d="M12.5 12.5l1.6 2.2-1.2 1.4 1.6 2.3"/>'
    when 'earpiece'
      assign paths = '<path d="M6.5 9a5.5 5.5 0 1 1 11 0c0 2.8-1.8 3.8-2.8 5.2-.9 1.3-.9 2.6-1.2 3.6a2.8 2.8 0 0 1-5.3.6"/><path d="M9.5 9.3a2.5 2.5 0 1 1 5 0c0 1.3-1.3 1.8-1.3 3.1"/>'
    when 'loudspeaker'
      assign paths = '<path d="M11 5L6.5 8.5H3.5v7h3L11 19V5z"/><path d="M15.2 9a4.2 4.2 0 0 1 0 6M18.2 6a8.4 8.4 0 0 1 0 12"/>'
    when 'microphone'
      assign paths = '<rect x="9" y="2.5" width="6" height="11" rx="3"/><path d="M18.5 10.5v1a6.5 6.5 0 0 1-13 0v-1M12 18v3.5M8.5 21.5h7"/>'
    when 'button'
      assign paths = '<rect x="7" y="2" width="10" height="20" rx="2.6"/><path d="M4.6 6.5v2.6M4.6 11v2.6M19.4 7.5v4"/>'
    when 'crown'
      assign paths = '<rect x="4.5" y="6" width="12" height="12" rx="3.6"/><path d="M7.5 6V3h6v3M7.5 18v3h6v-3"/><path d="M16.5 10.2h2.6v3.6h-2.6"/>'
    when 'keyboard'
      assign paths = '<rect x="2" y="5" width="20" height="14" rx="2.2"/><path d="M6 9h.01M9.3 9h.01M12.6 9h.01M15.9 9h.01M18 9h.01M6 12.3h.01M9.3 12.3h.01M12.6 12.3h.01M15.9 12.3h.01M18 12.3h.01M8 15.8h8"/>'
    when 'trackpad'
      assign paths = '<rect x="3" y="4" width="18" height="16" rx="2.6"/><path d="M12 9.2v3.4M10.3 10.9h3.4"/>'
    when 'touch-bar'
      assign paths = '<rect x="2" y="9" width="20" height="6" rx="3"/><path d="M6.5 12h.01M10 12h.01M13.5 12h.01M17 12h.01"/>'
    when 'flexgate'
      assign paths = '<rect x="3" y="3.5" width="18" height="12" rx="1.5"/><path d="M1.5 19.5h21"/><path d="M6 12.5l1.5-2 1.5 2 1.5-2 1.5 2 1.5-2 1.5 2 1.5-2 1.5 2"/>'
    when 'dustgate'
      assign paths = '<rect x="3" y="3.5" width="18" height="12" rx="1.5"/><path d="M1.5 19.5h21"/><path d="M7 12.5h.01M9.5 11.5h.01M12 12.6h.01M14.5 11.4h.01M17 12.4h.01"/>'
    when 'heart-rate'
      assign paths = '<path d="M20.5 8.8a4.8 4.8 0 0 0-8.5-3.1 4.8 4.8 0 0 0-8.5 3.1c0 5.2 8.5 10.7 8.5 10.7s8.5-5.5 8.5-10.7z"/><path d="M4.5 12h3.3l1.5-2.4 2.4 4.8 1.5-2.4h6.3"/>'
    when 'diagnostic'
      assign paths = '<circle cx="10.5" cy="10.5" r="7"/><path d="M20.5 20.5l-5-5"/><path d="M6.3 10.5h1.9l1-2 2 4 1-2h1.6"/>'
    when 'data'
      assign paths = '<ellipse cx="12" cy="5.5" rx="7.5" ry="2.8"/><path d="M4.5 5.5v13c0 1.5 3.4 2.8 7.5 2.8s7.5-1.3 7.5-2.8v-13M4.5 12c0 1.5 3.4 2.8 7.5 2.8s7.5-1.3 7.5-2.8"/>'
    when 'liquid'
      assign paths = '<path d="M12 2.7l5.7 5.7a8 8 0 1 1-11.3 0z"/>'
    when 'iphone'
      assign paths = '<rect x="6" y="1.5" width="12" height="21" rx="2.6"/><path d="M10.2 4.3h3.6"/>'
    when 'ipad'
      assign paths = '<rect x="4" y="2" width="16" height="20" rx="2.2"/><path d="M11.4 4.4h1.2"/>'
    when 'macbook'
      assign paths = '<rect x="3.5" y="4" width="17" height="11.5" rx="1.5"/><path d="M1.5 18.5h21l-1.2 1.5H2.7z"/>'
    when 'watch'
      assign paths = '<rect x="5.5" y="5.5" width="13" height="13" rx="4"/><path d="M8.5 5.5V2.5h7v3M8.5 18.5v3h7v-3M18.5 10.5h1.2v3h-1.2"/>'
    when 'check'
      assign paths = '<path d="M20 6.5L9.5 17 4 11.5"/>'
    when 'shield'
      assign paths = '<path d="M12 3l8 3v5c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10V6l8-3z"/><path d="M9 12l2 2 4-4"/>'
    when 'clock'
      assign paths = '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>'
    when 'courier'
      assign paths = '<path d="M2 5.5h12v10H2zM14 9h4l3.5 3.5v3H14z"/><circle cx="6" cy="17.5" r="2"/><circle cx="17.5" cy="17.5" r="2"/>'
    when 'parts'
      assign paths = '<rect x="6" y="6" width="12" height="12" rx="2"/><rect x="9.5" y="9.5" width="5" height="5" rx="1"/><path d="M9.5 2.5V6M14.5 2.5V6M9.5 18v3.5M14.5 18v3.5M2.5 9.5H6M2.5 14.5H6M18 9.5h3.5M18 14.5h3.5"/>'
    when 'arrow'
      assign paths = '<path d="M5 12h14M13 6l6 6-6 6"/>'
    else
      assign paths = '<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>'
  endcase
-%}
<svg class="repair-icon{% if class %} {{ class }}{% endif %}" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">{{ paths }}</svg>
