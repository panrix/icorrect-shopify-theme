{% comment %}
  Shared Click-to-Play 3-Video Panel (snippets/icorrect-video-panel.liquid)
  Replaces heavy eager-loaded YouTube Shorts iframes across 82 templates with
  lightweight click-to-play facades (0 KB YouTube JS/cookies on initial load).
  Uses Dawn color scheme variables (--color-foreground / --color-background) so
  headings, subtitles, and badges stay high-contrast on both dark (scheme-4) and
  light (scheme-1) sections.
{% endcomment %}

{%- liquid
  assign vp_id = section.id
  assign vp_kicker = kicker | default: 'Inside Our Fitzrovia Workshop · Never Outsourced'
  assign vp_badge = badge | default: 'Fitzrovia Bench · In-House'
  assign vp_tag_prefix = tag_prefix | default: 'Fitzrovia Bench'
  assign vp_pad_top = pad_top | default: section.settings.padding_top | default: 36
  assign vp_pad_bottom = pad_bottom | default: section.settings.padding_bottom | default: 64
  assign vp_heading = section.settings.heading | default: default_heading
  assign vp_subtitle = section.settings.subtitle | default: default_subtitle
-%}

{%- style -%}
  .ic-vp-{{ vp_id }} {
    padding-top: {{ vp_pad_top }}px;
    padding-bottom: {{ vp_pad_bottom }}px;
    color: rgb(var(--color-foreground, 17, 24, 39));
  }
  .ic-vp-{{ vp_id }} .ic-vp__container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
    width: 100%;
    box-sizing: border-box;
  }
  .ic-vp-{{ vp_id }} .ic-vp__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    margin: 0 0 28px 0;
  }
  .ic-vp-{{ vp_id }} .ic-vp__head-copy {
    max-width: 680px;
  }
  .ic-vp-{{ vp_id }} .ic-vp__kicker {
    display: block;
    margin: 0 0 6px 0;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: rgba(var(--color-foreground, 17, 24, 39), 0.78);
    font-family: "Geist Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
  }
  .ic-vp-{{ vp_id }} .ic-vp__heading {
    margin: 0 0 8px 0;
    font-size: clamp(26px, 3vw, 34px);
    line-height: 1.14;
    letter-spacing: -0.03em;
    font-weight: 600;
    color: rgb(var(--color-foreground, 17, 24, 39));
  }
  .ic-vp-{{ vp_id }} .ic-vp__subtitle {
    margin: 0;
    font-size: 15.5px;
    line-height: 1.55;
    color: rgba(var(--color-foreground, 17, 24, 39), 0.8);
  }
  .ic-vp-{{ vp_id }} .ic-vp__badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 12px;
    border-radius: 999px;
    background: rgba(var(--color-foreground, 17, 24, 39), 0.08);
    border: 1px solid rgba(var(--color-foreground, 17, 24, 39), 0.2);
    color: rgb(var(--color-foreground, 17, 24, 39));
    font-family: "Geist Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .ic-vp-{{ vp_id }} .ic-vp__badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #3b82f6;
    flex-shrink: 0;
  }
  .ic-vp-{{ vp_id }} .ic-vp__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }
  .ic-vp-{{ vp_id }} .ic-vp__card {
    background: #ffffff;
    border: 1px solid rgba(var(--color-foreground, 17, 24, 39), 0.14);
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.08), 0 12px 28px -18px rgba(0, 0, 0, 0.22);
    display: flex;
    flex-direction: column;
    color: #111827;
    transition: border-color 180ms ease, box-shadow 180ms ease, transform 180ms ease;
  }
  .ic-vp-{{ vp_id }} .ic-vp__card:hover {
    border-color: rgba(var(--color-foreground, 17, 24, 39), 0.28);
    box-shadow: 0 8px 24px -12px rgba(0, 0, 0, 0.26);
  }
  .ic-vp-{{ vp_id }} .ic-vp__media {
    position: relative;
    aspect-ratio: 4 / 5;
    background: #0f172a;
    overflow: hidden;
    cursor: pointer;
    outline: none;
  }
  .ic-vp-{{ vp_id }} .ic-vp__media:focus-visible {
    box-shadow: inset 0 0 0 3px #3b82f6;
  }
  .ic-vp-{{ vp_id }} .ic-vp__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: brightness(0.88);
    transition: transform 240ms ease, filter 240ms ease;
  }
  .ic-vp-{{ vp_id }} .ic-vp__card:hover .ic-vp__media img {
    transform: scale(1.03);
    filter: brightness(0.95);
  }
  .ic-vp-{{ vp_id }} .ic-vp__media iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .ic-vp-{{ vp_id }} .ic-vp__tag {
    position: absolute;
    top: 12px;
    left: 12px;
    padding: 4px 10px;
    border-radius: 999px;
    background: rgba(17, 24, 39, 0.84);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    border: 1px solid rgba(255, 255, 255, 0.18);
    color: #ffffff;
    font-family: "Geist Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    pointer-events: none;
  }
  .ic-vp-{{ vp_id }} .ic-vp__play {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: 56px;
    height: 56px;
    border-radius: 999px;
    background: rgba(17, 24, 39, 0.88);
    border: 1.5px solid rgba(255, 255, 255, 0.34);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 10px 26px rgba(0, 0, 0, 0.36);
    transition: transform 160ms ease, background 160ms ease, border-color 160ms ease;
    pointer-events: none;
  }
  .ic-vp-{{ vp_id }} .ic-vp__card:hover .ic-vp__play,
  .ic-vp-{{ vp_id }} .ic-vp__media:focus-visible .ic-vp__play {
    transform: translate(-50%, -50%) scale(1.07);
    background: #0b63ce;
    border-color: #93c5fd;
  }
  .ic-vp-{{ vp_id }} .ic-vp__body {
    padding: 16px 18px 18px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .ic-vp-{{ vp_id }} .ic-vp__title {
    margin: 0;
    font-size: 16.5px;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.28;
    color: #111827;
  }
  .ic-vp-{{ vp_id }} .ic-vp__desc {
    margin: 0;
    font-size: 13.5px;
    line-height: 1.5;
    color: #4b5563;
  }
  @media (max-width: 820px) {
    .ic-vp-{{ vp_id }} .ic-vp__grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }
    .ic-vp-{{ vp_id }} .ic-vp__header {
      margin-bottom: 20px;
    }
  }
{%- endstyle -%}

<section class="ic-vp-{{ vp_id }} color-{{ section.settings.color_scheme | default: 'scheme-1' }} gradient">
  <div class="ic-vp__container">
    <div class="ic-vp__header">
      <div class="ic-vp__head-copy">
        <span class="ic-vp__kicker">{{ vp_kicker | escape }}</span>
        <h2 class="ic-vp__heading">{{ vp_heading | escape }}</h2>
        {%- if vp_subtitle != blank -%}
          <p class="ic-vp__subtitle">{{ vp_subtitle | escape }}</p>
        {%- endif -%}
      </div>
      <span class="ic-vp__badge">
        <span class="ic-vp__badge-dot" aria-hidden="true"></span>
        {{ vp_badge | escape }}
      </span>
    </div>

    <div class="ic-vp__grid">
      {%- for idx in (1..3) -%}
        {%- liquid
          if idx == 1
            assign v_id = video_1_id
            assign v_title = section.settings.video_1_title | default: video_1_fallback_title
            assign v_desc = section.settings.video_1_desc | default: video_1_default_desc
            assign v_aria = video_1_aria | default: v_title
            assign v_num = '01'
          elsif idx == 2
            assign v_id = video_2_id
            assign v_title = section.settings.video_2_title | default: video_2_fallback_title
            assign v_desc = section.settings.video_2_desc | default: video_2_default_desc
            assign v_aria = video_2_aria | default: v_title
            assign v_num = '02'
          else
            assign v_id = video_3_id
            assign v_title = section.settings.video_3_title | default: video_3_fallback_title
            assign v_desc = section.settings.video_3_desc | default: video_3_default_desc
            assign v_aria = video_3_aria | default: v_title
            assign v_num = '03'
          endif
          if v_title == 'Homepage Video 1' or v_title == 'Homepage Video 2' or v_title == 'Homepage Video 3' or v_title == blank
            assign v_title = v_aria
          endif
        -%}
        <article class="ic-vp__card">
          <div
            class="ic-vp__media"
            data-ic-yt="{{ v_id | escape }}"
            data-ic-yt-title="{{ v_aria | escape }}"
            role="button"
            tabindex="0"
            aria-label="Play video: {{ v_aria | escape }}"
          >
            <img
              src="https://i.ytimg.com/vi/{{ v_id | escape }}/oar2.jpg"
              onerror="this.onerror=null;this.src='https://i.ytimg.com/vi/{{ v_id | escape }}/hqdefault.jpg';"
              alt="{{ v_aria | escape }}"
              loading="lazy"
              decoding="async"
              width="405"
              height="506"
            >
            <span class="ic-vp__tag">{{ vp_tag_prefix | escape }} &middot; {{ v_num }}</span>
            <span class="ic-vp__play" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path d="M6 4l11 6-11 6z"/>
              </svg>
            </span>
          </div>
          <div class="ic-vp__body">
            <h3 class="ic-vp__title">{{ v_title | escape }}</h3>
            {%- if v_desc != blank -%}
              <p class="ic-vp__desc">{{ v_desc | escape }}</p>
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

<script src="{{ 'icorrect-video-panel.js' | asset_url }}" defer="defer"></script>
