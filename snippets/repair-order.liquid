{%- comment -%}
  Orders the repairs of one model the same way on every model page:
  Diagnostic, screen / display / glass, battery, charging port, rear glass,
  rear camera, camera lens, front camera, Face ID, earpiece, loudspeaker,
  microphone, power button, volume buttons, mute switch, other buttons, crown, keyboard, trackpad, Touch Bar, Flexgate,
  Dustgate, heart-rate sensor, then anything else. Ties keep collection order.

  Accepts:
  - titles: {String} product titles joined with "||"

  Outputs comma-separated zero-based indices in display order.
{%- endcomment -%}
{%- liquid
  assign ranking = 'diagnostic,screen,display,glass,battery,charging-port,rear-glass,rear-camera,rear-camera-lens,front-camera,face-id,earpiece,loudspeaker,microphone,power-button,volume-button,mute-button,button,crown,keyboard,trackpad,touch-bar,flexgate,dustgate,heart-rate,data,liquid' | split: ','
  assign list = titles | split: '||'
  assign keys = ''
  for raw in list
    assign i = forloop.index0
    capture meta_raw
      render 'repair-meta', title: raw
    endcapture
    assign meta = meta_raw | strip | split: '|'
    assign rank = 90
    for r in ranking
      if r == meta[1]
        assign rank = forloop.index0 | plus: 10
      endif
    endfor
    assign k_idx = i | prepend: '000' | slice: -3, 3
    assign keys = keys | append: rank | append: k_idx | append: ','
  endfor
  assign keys = keys | split: ',' | sort
  assign out = ''
  for key in keys
    assign idx = key | slice: -3, 3 | plus: 0
    assign out = out | append: idx | append: ','
  endfor
  echo out
-%}
