{%- comment -%}
  Apple Watch — Ultra era (Ultra, Ultra 2).
  Squarer case, bold flat bezel ring, crown guard and action button.
  Part contract and drawing rules: docs/design/device-illustrations.md
  Accepts: view (front|back), part
{%- endcomment -%}
<svg class="dg__svg" viewBox="0 0 140 228" fill="none" focusable="false">
  <ellipse class="dg-shadow" cx="70" cy="223" rx="36" ry="3"/>
  <path class="dg-band" d="M40 44V10a8 8 0 0 1 8-8h44a8 8 0 0 1 8 8v34M40 176v34a8 8 0 0 0 8 8h44a8 8 0 0 0 8-8v-34"/>
  {%- if view == 'back' -%}
    <rect class="dg-body dg-glass{% if part == 'glass' %} is-hl{% endif %}" x="16" y="40" width="104" height="140" rx="22"/>
    <rect class="dg-frame" x="21" y="45" width="94" height="130" rx="18"/>
    <circle class="dg-sensor{% if part == 'sensor' %} is-hl{% endif %}" cx="68" cy="110" r="28"/>
    <circle class="dg-sensor{% if part == 'sensor' %} is-hl{% endif %}" cx="68" cy="110" r="14"/>
    <path class="dg-leds{% if part == 'sensor' %} is-hl{% endif %}" d="M68 89h.01M68 131h.01M47 110h.01M89 110h.01"/>
  {%- else -%}
    <path class="dg-guard" d="M120 70h5a4 4 0 0 1 4 4v34a4 4 0 0 1-4 4h-5"/>
    <rect class="dg-btn{% if part == 'crown' %} is-hl{% endif %}" x="11" y="72" width="5" height="28" rx="2.5"/>
    <rect class="dg-crown{% if part == 'crown' %} is-hl{% endif %}" x="121" y="80" width="8" height="22" rx="3"/>
    <rect class="dg-btn{% if part == 'crown' %} is-hl{% endif %}" x="120.5" y="118" width="5" height="24" rx="2.5"/>
    <rect class="dg-body" x="16" y="40" width="104" height="140" rx="22"/>
    <rect class="dg-frame dg-frame--bold" x="21" y="45" width="94" height="130" rx="18"/>
    <rect class="dg-screen{% if part == 'screen' %} is-hl{% endif %}" x="26" y="50" width="84" height="120" rx="14"/>
    <path class="dg-sheen" d="M60 50h18L26 144v-28z"/>
    <path class="dg-grille{% if part == 'grille' %} is-hl{% endif %}" d="M12 112v10M12 128v10"/>
    <rect class="dg-battery{% if part == 'battery' %} is-hl{% endif %}" x="40" y="72" width="56" height="76" rx="12"/>
    <path class="dg-crack" d="M78 70L66 108L74 150M66 108L54 130"/>
    <path class="dg-shatter" d="M68 112m-3 0a3 3 0 1 0 6 0a3 3 0 1 0-6 0M68 112l-10-10M68 112l10-10M68 112l10 10M68 112l-10 10"/>
    <path class="dg-fault" d="M48 66V156M68 66V156M88 66V156"/>
    <path class="dg-blot" d="M68 124a4 4 0 1 1 0 8a4 4 0 1 1 0-8"/>
    <rect class="dg-scan" x="26" y="50" width="84" height="3" rx="1.5"/>
  {%- endif -%}
</svg>
