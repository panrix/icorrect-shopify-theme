    <rect class="dg-body" x="16" y="40" width="104" height="140" rx="22"/>
    <rect class="dg-frame dg-frame--bold" x="21" y="45" width="94" height="130" rx="18"/>
    <rect class="dg-screen{% if part == 'screen' %} is-hl{% endif %}" x="26" y="50" width="84" height="120" rx="14"/>
    <path class="dg-sheen" d="M60 50h18L26 144v-28z"/>
    <path class="dg-crack" d="M65.5 98.0L74.9 70.3L51.5 50.1M74.9 70.3L76.5 52.9M65.5 98.0L61.5 70.3L83.5 50.1M65.5 98.0L91.9 104.5L109.8 82.0M91.9 104.5L85.9 83.5M65.5 98.0L97.4 97.9L109.8 129.3M65.5 98.0L54.5 133.8L72.1 169.8M54.5 133.8L44.1 153.0M65.5 98.0L57.5 127.2L26.1 134.5M57.5 127.2L49.1 147.4M65.5 98.0L50.4 80.0L26.1 85.5"/>
