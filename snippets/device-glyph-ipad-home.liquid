    <path class="dg-blot" d="M90 154a5.5 5.5 0 1 1 0 11a5.5 5.5 0 1 1 0-11"/>
    <rect class="dg-scan" x="20" y="28" width="140" height="3" rx="1.5"/>
  {%- endif -%}
</svg>
