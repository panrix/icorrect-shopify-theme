{% comment %}
  Route-scoped FAQPage JSON-LD for pages whose visible FAQ copy lives in JSON templates.
  Keep each schema entry identical to its rendered question and answer.
{% endcomment %}
{%- if request.page_type == 'index' -%}
<script type="application/ld+json">
{
