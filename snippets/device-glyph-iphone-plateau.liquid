{%- comment -%}
  iPhone — Camera plateau era (iPhone Air, 17 Pro, 17 Pro Max).
  Front matches the Dynamic Island era; the back carries a full-width camera
  plateau. Part contract and drawing rules: docs/design/device-illustrations.md
  Accepts: view (front|back), part, lenses (1|3)
{%- endcomment -%}
<svg class="dg__svg" viewBox="0 0 120 250" fill="none" focusable="false">
  <ellipse class="dg-shadow" cx="60" cy="244" rx="46" ry="3.5"/>
  {%- if view == 'back' -%}
    <rect class="dg-btn" x="109" y="50" width="4.5" height="12" rx="2.25"/>
    <rect class="dg-btn" x="109" y="70" width="4.5" height="20" rx="2.25"/>
    <rect class="dg-btn" x="109" y="96" width="4.5" height="20" rx="2.25"/>
    <rect class="dg-btn" x="6.5" y="80" width="4.5" height="32" rx="2.25"/>
    <rect class="dg-body dg-glass{% if part == 'glass' %} is-hl{% endif %}" x="10" y="4" width="100" height="232" rx="22"/>
    <rect class="dg-frame" x="12.5" y="6.5" width="95" height="227" rx="19.5"/>
    <path class="dg-crack dg-crack--back" d="M57.1 133.8L69.4 98.0L43.5 67.2M69.4 98.0L75.6 73.8M57.1 133.8L51.1 97.7L75.5 67.2M57.1 133.8L88.5 138.8L107.8 111.3M88.5 138.8L80.2 115.2M57.1 133.8L95.2 138.8L107.8 177.5M57.1 133.8L44.2 183.0L64.1 233.8M44.2 183.0L30.6 203.9M57.1 133.8L49.2 170.4L12.2 184.8M49.2 170.4L43.1 194.5M57.1 133.8L40.8 111.9L12.2 116.2"/>
    {%- if lenses == 1 -%}
      <rect class="dg-plateau" x="13" y="11" width="94" height="30" rx="15"/>
      <rect class="dg-module{% if part == 'camera' %} is-hl{% endif %}" x="17" y="14" width="24" height="24" rx="8"/>
      <circle class="dg-lens-ring{% if part == 'camera' or part == 'lens' %} is-hl{% endif %}" cx="29" cy="26" r="8"/>
      <circle class="dg-lens{% if part == 'camera' or part == 'lens' %} is-hl{% endif %}" cx="29" cy="26" r="3.4"/>
      <path class="dg-lens-crack" d="M23.5 22l11 8M23.8 30l10-7"/>
      <circle class="dg-flash" cx="90" cy="26" r="2.4"/>
    {%- else -%}
      <rect class="dg-plateau" x="13" y="11" width="94" height="52" rx="16"/>
      <rect class="dg-module{% if part == 'camera' %} is-hl{% endif %}" x="16" y="14" width="42" height="46" rx="13"/>
      <circle class="dg-lens-ring{% if part == 'camera' or part == 'lens' %} is-hl{% endif %}" cx="28" cy="25.5" r="8"/>
      <circle class="dg-lens{% if part == 'camera' or part == 'lens' %} is-hl{% endif %}" cx="28" cy="25.5" r="3.4"/>
      <path class="dg-lens-crack" d="M22.5 21.5l11 8M22.8 29.5l10-7"/>
      <circle class="dg-lens-ring{% if part == 'camera' %} is-hl{% endif %}" cx="28" cy="48" r="8"/>
      <circle class="dg-lens{% if part == 'camera' %} is-hl{% endif %}" cx="28" cy="48" r="3.4"/>
      <circle class="dg-lens-ring{% if part == 'camera' %} is-hl{% endif %}" cx="47.5" cy="36.75" r="8"/>
      <circle class="dg-lens{% if part == 'camera' %} is-hl{% endif %}" cx="47.5" cy="36.75" r="3.4"/>
      <circle class="dg-flash" cx="90" cy="26" r="2.4"/>
      <circle class="dg-lidar" cx="90" cy="47" r="3.2"/>
    {%- endif -%}
  {%- else -%}
    <rect class="dg-btn dg-btn-mute{% if part == 'buttons' or part == 'mute' %} is-hl{% endif %}" x="6.5" y="50" width="4.5" height="12" rx="2.25"/>
    <rect class="dg-btn dg-btn-volume{% if part == 'buttons' or part == 'volume' %} is-hl{% endif %}" x="6.5" y="70" width="4.5" height="20" rx="2.25"/>
    <rect class="dg-btn dg-btn-volume{% if part == 'buttons' or part == 'volume' %} is-hl{% endif %}" x="6.5" y="96" width="4.5" height="20" rx="2.25"/>
    <rect class="dg-btn dg-btn-power{% if part == 'buttons' or part == 'power' %} is-hl{% endif %}" x="109" y="80" width="4.5" height="32" rx="2.25"/>
    <rect class="dg-body" x="10" y="4" width="100" height="232" rx="22"/>
    <rect class="dg-frame" x="12.5" y="6.5" width="95" height="227" rx="19.5"/>
    <rect class="dg-screen{% if part == 'screen' %} is-hl{% endif %}" x="16" y="10" width="88" height="220" rx="16"/>
    <path class="dg-sheen" d="M58 10h20L16 134V96z"/>
    <path class="dg-crack" d="M57.4 98.0L68.1 53.1L43.5 10.2M68.1 53.1L77.6 32.3M57.4 98.0L52.3 53.0L75.5 10.2M57.4 98.0L89.5 92.8L103.8 61.2M89.5 92.8L78.1 73.0M57.4 98.0L95.2 116.4L103.8 160.4M57.4 98.0L45.7 162.1L64.1 229.8M45.7 162.1L31.2 179.8M57.4 98.0L52.2 141.4L16.1 171.4M52.2 141.4L53.8 164.2M57.4 98.0L45.2 73.1L16.1 68.6"/>
    <path class="dg-shatter" d="M57.4 98.0L68.1 53.1L43.5 10.2M68.1 53.1L77.6 32.3M57.4 98.0L52.3 53.0L75.5 10.2M57.4 98.0L89.5 92.8L103.8 61.2M89.5 92.8L78.1 73.0M57.4 98.0L95.2 116.4L103.8 160.4M57.4 98.0L45.7 162.1L64.1 229.8M45.7 162.1L31.2 179.8M57.4 98.0L52.2 141.4L16.1 171.4M52.2 141.4L53.8 164.2M57.4 98.0L45.2 73.1L16.1 68.6"/>
    <path class="dg-fault" d="M34.0 80.4H86.0"/>
    <rect class="dg-fault dg-fault--alt" x="34.0" y="111.2" width="52.0" height="15.4"/>
    <path class="dg-fault" d="M34.0 164.0H86.0"/>
    <path class="dg-earpiece{% if part == 'earpiece' %} is-hl{% endif %}" d="M52 13.6h16"/>
    <rect class="dg-island{% if part == 'fcam' %} is-hl{% endif %}" x="45" y="18" width="30" height="9" rx="4.5"/>
    <rect class="dg-port{% if part == 'port' %} is-hl{% endif %}" x="50" y="232" width="20" height="3" rx="1.5"/>
    <path class="dg-grille dg-grille--dots{% if part == 'grille' %} is-hl{% endif %}" d="M30 233.5h.01M35 233.5h.01M40 233.5h.01M80 233.5h.01M85 233.5h.01M90 233.5h.01"/>
    <rect class="dg-battery{% if part == 'battery' %} is-hl{% endif %}" x="28" y="64" width="64" height="120" rx="10"/>
    <path class="dg-blot" d="M60 159.5a4.5 4.5 0 1 1 0 9a4.5 4.5 0 1 1 0-9"/>
    <rect class="dg-scan" x="16" y="10" width="88" height="3" rx="1.5"/>
  {%- endif -%}
</svg>
