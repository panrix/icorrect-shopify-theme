{%- comment -%}
  iPhone — Home button era (iPhone 6s–8, SE 2nd/3rd gen).
  Part contract and drawing rules: docs/design/device-illustrations.md
  Accepts: view (front|back), part, lenses (1|2)
{%- endcomment -%}
<svg class="dg__svg" viewBox="0 0 120 250" fill="none" focusable="false">
  <ellipse class="dg-shadow" cx="60" cy="244" rx="44" ry="3.5"/>
  {%- if view == 'back' -%}
    <rect class="dg-btn" x="109" y="38" width="4.5" height="10" rx="2.25"/>
    <rect class="dg-btn" x="109" y="56" width="4.5" height="18" rx="2.25"/>
    <rect class="dg-btn" x="109" y="80" width="4.5" height="18" rx="2.25"/>
    <rect class="dg-btn" x="6.5" y="58" width="4.5" height="26" rx="2.25"/>
    <rect class="dg-body dg-glass{% if part == 'glass' %} is-hl{% endif %}" x="10" y="4" width="100" height="232" rx="18"/>
    <rect class="dg-frame" x="12.5" y="6.5" width="95" height="227" rx="15.5"/>
    {%- if lenses == 2 -%}
      <rect class="dg-module{% if part == 'camera' %} is-hl{% endif %}" x="17" y="13" width="40" height="22" rx="11"/>
      <circle class="dg-lens-ring{% if part == 'camera' or part == 'lens' %} is-hl{% endif %}" cx="28" cy="24" r="7.2"/>
      <circle class="dg-lens{% if part == 'camera' or part == 'lens' %} is-hl{% endif %}" cx="28" cy="24" r="3"/>
      <path class="dg-lens-crack" d="M22.8 20l10.5 7.5M23 28l9.5-6.5"/>
      <circle class="dg-lens-ring{% if part == 'camera' %} is-hl{% endif %}" cx="46" cy="24" r="7.2"/>
      <circle class="dg-lens{% if part == 'camera' %} is-hl{% endif %}" cx="46" cy="24" r="3"/>
      <circle class="dg-flash" cx="65" cy="24" r="2.4"/>
    {%- else -%}
      <circle class="dg-lens-ring{% if part == 'camera' or part == 'lens' %} is-hl{% endif %}" cx="28" cy="24" r="8.5"/>
      <circle class="dg-lens{% if part == 'camera' or part == 'lens' %} is-hl{% endif %}" cx="28" cy="24" r="3.6"/>
      <path class="dg-lens-crack" d="M22 19.5l12 9M22.5 28.5l11-8"/>
      <circle class="dg-flash" cx="45" cy="24" r="2.4"/>
    {%- endif -%}
    <path class="dg-crack dg-crack--back" d="M80 104l-10 26 14 8-16 30 9 7-12 26"/>
  {%- else -%}
    <rect class="dg-btn dg-btn-mute{% if part == 'buttons' or part == 'mute' %} is-hl{% endif %}" x="6.5" y="38" width="4.5" height="10" rx="2.25"/>
    <rect class="dg-btn dg-btn-volume{% if part == 'buttons' or part == 'volume' %} is-hl{% endif %}" x="6.5" y="56" width="4.5" height="18" rx="2.25"/>
    <rect class="dg-btn dg-btn-volume{% if part == 'buttons' or part == 'volume' %} is-hl{% endif %}" x="6.5" y="80" width="4.5" height="18" rx="2.25"/>
    <rect class="dg-btn dg-btn-power{% if part == 'buttons' or part == 'power' %} is-hl{% endif %}" x="109" y="58" width="4.5" height="26" rx="2.25"/>
    <rect class="dg-body" x="10" y="4" width="100" height="232" rx="18"/>
    <rect class="dg-frame" x="12.5" y="6.5" width="95" height="227" rx="15.5"/>
    <rect class="dg-screen{% if part == 'screen' %} is-hl{% endif %}" x="16" y="36" width="88" height="166" rx="2"/>
    <path class="dg-sheen" d="M56 36h20L16 146v-36z"/>
    <path class="dg-earpiece{% if part == 'earpiece' %} is-hl{% endif %}" d="M50 21h20"/>
    <circle class="dg-cam{% if part == 'fcam' %} is-hl{% endif %}" cx="39" cy="21" r="2.6"/>
    <circle class="dg-home{% if part == 'buttons' %} is-hl{% endif %}" cx="60" cy="219" r="10"/>
    <rect class="dg-port{% if part == 'port' %} is-hl{% endif %}" x="50" y="232" width="20" height="3" rx="1.5"/>
    <path class="dg-grille dg-grille--dots{% if part == 'grille' %} is-hl{% endif %}" d="M30 233.5h.01M35 233.5h.01M40 233.5h.01M80 233.5h.01M85 233.5h.01M90 233.5h.01"/>
    <rect class="dg-battery{% if part == 'battery' %} is-hl{% endif %}" x="30" y="62" width="60" height="116" rx="8"/>
    <path class="dg-crack" d="M74 50l-10 26 14 8-16 30 9 7-12 26"/>
    <path class="dg-shatter" d="M72 86l-14-28M72 86l20-20M72 86l24 10M72 86l10 30M72 86l-18 24M72 86l-28-4M63 74l14-5 10 11-3 16-14 5-11-10z"/>
    <path class="dg-fault" d="M38 36v166M41.5 36v166"/>
    <path class="dg-fault dg-fault--alt" d="M80 36v166"/>
    <path class="dg-blot" d="M48 152c4-12 22-15 30-5 7 9 1 22-11 24-12 1-23-7-19-19z"/>
    <rect class="dg-scan" x="16" y="36" width="88" height="3" rx="1.5"/>
  {%- endif -%}
</svg>
