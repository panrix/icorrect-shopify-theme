{%- comment -%}
  Ads page trust block (D6). Used in chapter 6 (Variant A) and under the list (Variant B).
  Params: seal (asset URL or blank for no drawing), warranty_url.
{%- endcomment -%}
<article class="lp-trust" aria-label="Rating, warranty and company details">
  {%- if seal != blank -%}
    <div class="lp-trust__art"><div class="dg" data-ch="6" data-src="{{ seal }}" data-viewbox="180 205 340 240" data-from="0" data-to="0" style="--ar: 340 / 240"><img src="{{ seal }}" width="700" height="600" alt="" loading="lazy" decoding="async"></div></div>
  {%- endif -%}
  <div class="lp-trust__body">
    <p class="ic-label">Google reviews</p>
    <p class="lp-trust__score"><b class="lp-live" data-live="reviews.google.rating" title="Read live from the approved review source (claim C10)">4.8</b><span>from <span class="lp-live" data-live="reviews.google.count" title="Read live (claim C10)">700+</span> reviews, <a class="lp-link" href="#reviews-link" data-live="reviews.google.url">read them on Google</a></span></p>
    <div class="ic-rows">
      <div class="ic-row"><span class="ic-row-name">2 year warranty</span><span class="ic-row-value"><a class="lp-link" href="{{ warranty_url }}">Terms</a></span></div>
      <div class="ic-row"><span class="ic-row-name">Recalibrated in-house</span><span class="ic-row-value">At our workshop</span></div>
      <div class="ic-row"><span class="ic-row-name">ICX Repair Ltd</span><span class="ic-row-value">Company 15656949</span></div>
    </div>
  </div>
</article>
