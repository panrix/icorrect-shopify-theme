{%- comment -%}
  Apple Watch — Classic era (Series 4–6, SE).
  Wider bezels and softer screen corners.
  Part contract and drawing rules: docs/design/device-illustrations.md
  Accepts: view (front|back), part
{%- endcomment -%}
<svg class="dg__svg" viewBox="0 0 140 228" fill="none" focusable="false">
  <ellipse class="dg-shadow" cx="70" cy="223" rx="36" ry="3"/>
  <path class="dg-band" d="M40 44V10a8 8 0 0 1 8-8h44a8 8 0 0 1 8 8v34M40 176v34a8 8 0 0 0 8 8h44a8 8 0 0 0 8-8v-34"/>
  {%- if view == 'back' -%}
    <rect class="dg-body dg-glass{% if part == 'glass' %} is-hl{% endif %}" x="18" y="38" width="100" height="144" rx="30"/>
    <rect class="dg-frame" x="20.5" y="40.5" width="95" height="139" rx="27.5"/>
    <circle class="dg-sensor{% if part == 'sensor' %} is-hl{% endif %}" cx="68" cy="110" r="28"/>
    <circle class="dg-sensor{% if part == 'sensor' %} is-hl{% endif %}" cx="68" cy="110" r="14"/>
    <path class="dg-leds{% if part == 'sensor' %} is-hl{% endif %}" d="M68 89h.01M68 131h.01M47 110h.01M89 110h.01"/>
  {%- else -%}
    <rect class="dg-crown{% if part == 'crown' %} is-hl{% endif %}" x="116" y="76" width="10" height="24" rx="3.5"/>
    <rect class="dg-btn{% if part == 'crown' %} is-hl{% endif %}" x="117" y="112" width="5" height="28" rx="2.5"/>
    <rect class="dg-body" x="18" y="38" width="100" height="144" rx="30"/>
    <rect class="dg-frame" x="20.5" y="40.5" width="95" height="139" rx="27.5"/>
    <rect class="dg-screen{% if part == 'screen' %} is-hl{% endif %}" x="28" y="48" width="80" height="124" rx="20"/>
    <path class="dg-sheen" d="M60 48h16L28 150v-28z"/>
    <path class="dg-grille{% if part == 'grille' %} is-hl{% endif %}" d="M14 94v10M14 112v10"/>
    <rect class="dg-battery{% if part == 'battery' %} is-hl{% endif %}" x="40" y="72" width="56" height="76" rx="14"/>
    <path class="dg-crack" d="M78 70L66 108L74 150M66 108L54 130"/>
    <path class="dg-shatter" d="M68 112m-3 0a3 3 0 1 0 6 0a3 3 0 1 0-6 0M68 112l-10-10M68 112l10-10M68 112l10 10M68 112l-10 10"/>
    <path class="dg-fault" d="M48 64V156M68 64V156M88 64V156"/>
    <path class="dg-blot" d="M68 124a4 4 0 1 1 0 8a4 4 0 1 1 0-8"/>
    <rect class="dg-scan" x="28" y="48" width="80" height="3" rx="1.5"/>
  {%- endif -%}
</svg>
