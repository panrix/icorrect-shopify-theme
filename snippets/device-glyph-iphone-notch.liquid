{%- comment -%}
  iPhone — Notch era (iPhone X–14, 14 Plus, 16e, 17e).
  Part contract and drawing rules: docs/design/device-illustrations.md
  Accepts: view (front|back), part, lenses (1|2|3)
{%- endcomment -%}
<svg class="dg__svg" viewBox="0 0 120 250" fill="none" focusable="false">
  <ellipse class="dg-shadow" cx="60" cy="244" rx="46" ry="3.5"/>
  {%- if view == 'back' -%}
    <rect class="dg-btn" x="109" y="50" width="4.5" height="12" rx="2.25"/>
    <rect class="dg-btn" x="109" y="70" width="4.5" height="20" rx="2.25"/>
    <rect class="dg-btn" x="109" y="96" width="4.5" height="20" rx="2.25"/>
    <rect class="dg-btn" x="6.5" y="80" width="4.5" height="32" rx="2.25"/>
    <rect class="dg-body dg-glass{% if part == 'glass' %} is-hl{% endif %}" x="10" y="4" width="100" height="232" rx="22"/>
    <rect class="dg-frame" x="12.5" y="6.5" width="95" height="227" rx="19.5"/>
    {%- case lenses -%}
      {%- when 1 -%}
        <rect class="dg-module{% if part == 'camera' %} is-hl{% endif %}" x="18" y="12" width="28" height="28" rx="9"/>
        <circle class="dg-lens-ring{% if part == 'camera' or part == 'lens' %} is-hl{% endif %}" cx="32" cy="26" r="8"/>
        <circle class="dg-lens{% if part == 'camera' or part == 'lens' %} is-hl{% endif %}" cx="32" cy="26" r="3.4"/>
        <path class="dg-lens-crack" d="M26.5 22l11 8M26.8 30l10-7"/>
        <circle class="dg-flash" cx="52" cy="19" r="2.4"/>
      {%- when 2 -%}
        <rect class="dg-module{% if part == 'camera' %} is-hl{% endif %}" x="17" y="11" width="40" height="40" rx="12"/>
        <circle class="dg-lens-ring{% if part == 'camera' or part == 'lens' %} is-hl{% endif %}" cx="28.5" cy="22.5" r="7.2"/>
        <circle class="dg-lens{% if part == 'camera' or part == 'lens' %} is-hl{% endif %}" cx="28.5" cy="22.5" r="3"/>
        <path class="dg-lens-crack" d="M23.2 18.2l10.5 7.5M23.5 26.5l9.5-6.5"/>
        <circle class="dg-lens-ring{% if part == 'camera' %} is-hl{% endif %}" cx="28.5" cy="39.5" r="7.2"/>
        <circle class="dg-lens{% if part == 'camera' %} is-hl{% endif %}" cx="28.5" cy="39.5" r="3"/>
        <circle class="dg-flash" cx="46" cy="22.5" r="2.4"/>
      {%- else -%}
        <rect class="dg-module{% if part == 'camera' %} is-hl{% endif %}" x="17" y="11" width="48" height="48" rx="14"/>
        <circle class="dg-lens-ring{% if part == 'camera' or part == 'lens' %} is-hl{% endif %}" cx="30.5" cy="24.5" r="8.2"/>
        <circle class="dg-lens{% if part == 'camera' or part == 'lens' %} is-hl{% endif %}" cx="30.5" cy="24.5" r="3.4"/>
        <path class="dg-lens-crack" d="M25 20.5l11 8M25.3 28.5l10-7"/>
        <circle class="dg-lens-ring{% if part == 'camera' %} is-hl{% endif %}" cx="30.5" cy="45.5" r="8.2"/>
        <circle class="dg-lens{% if part == 'camera' %} is-hl{% endif %}" cx="30.5" cy="45.5" r="3.4"/>
        <circle class="dg-lens-ring{% if part == 'camera' %} is-hl{% endif %}" cx="51" cy="35" r="8.2"/>
        <circle class="dg-lens{% if part == 'camera' %} is-hl{% endif %}" cx="51" cy="35" r="3.4"/>
        <circle class="dg-flash" cx="51.5" cy="18.5" r="2.4"/>
    {%- endcase -%}
    <path class="dg-crack dg-crack--back" d="M76 118L60 168L70 214M60 168L46 198"/>
  {%- else -%}
    <rect class="dg-btn dg-btn-mute{% if part == 'buttons' or part == 'mute' %} is-hl{% endif %}" x="6.5" y="50" width="4.5" height="12" rx="2.25"/>
    <rect class="dg-btn dg-btn-volume{% if part == 'buttons' or part == 'volume' %} is-hl{% endif %}" x="6.5" y="70" width="4.5" height="20" rx="2.25"/>
    <rect class="dg-btn dg-btn-volume{% if part == 'buttons' or part == 'volume' %} is-hl{% endif %}" x="6.5" y="96" width="4.5" height="20" rx="2.25"/>
    <rect class="dg-btn dg-btn-power{% if part == 'buttons' or part == 'power' %} is-hl{% endif %}" x="109" y="80" width="4.5" height="32" rx="2.25"/>
    <rect class="dg-body" x="10" y="4" width="100" height="232" rx="22"/>
    <rect class="dg-frame" x="12.5" y="6.5" width="95" height="227" rx="19.5"/>
    <rect class="dg-screen{% if part == 'screen' %} is-hl{% endif %}" x="16" y="10" width="88" height="220" rx="16"/>
    <path class="dg-sheen" d="M58 10h20L16 134V96z"/>
    <path class="dg-notch{% if part == 'fcam' %} is-hl{% endif %}" d="M41 10h38v5.5a6.5 6.5 0 0 1-6.5 6.5h-25A6.5 6.5 0 0 1 41 15.5z"/>
    <path class="dg-earpiece dg-earpiece--light{% if part == 'earpiece' %} is-hl{% endif %}" d="M53 14h14"/>
    <rect class="dg-port{% if part == 'port' %} is-hl{% endif %}" x="50" y="232" width="20" height="3" rx="1.5"/>
    <path class="dg-grille dg-grille--dots{% if part == 'grille' %} is-hl{% endif %}" d="M30 233.5h.01M35 233.5h.01M40 233.5h.01M80 233.5h.01M85 233.5h.01M90 233.5h.01"/>
    <rect class="dg-battery{% if part == 'battery' %} is-hl{% endif %}" x="28" y="64" width="64" height="120" rx="10"/>
    <path class="dg-crack" d="M76 48L62 114L72 182M62 114L46 148"/>
    <path class="dg-shatter" d="M60 108m-3.4 0a3.4 3.4 0 1 0 6.8 0a3.4 3.4 0 1 0-6.8 0M60 108l-12-12M60 108l12-12M60 108l12 12M60 108l-12 12"/>
    <path class="dg-fault" d="M40 34V212M60 34V212M80 34V212"/>
    <path class="dg-blot" d="M60 159.5a4.5 4.5 0 1 1 0 9a4.5 4.5 0 1 1 0-9"/>
    <rect class="dg-scan" x="16" y="10" width="88" height="3" rx="1.5"/>
  {%- endif -%}
</svg>
