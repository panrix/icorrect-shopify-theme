<!doctype html>
{%- comment -%}
  Layout for paid-ads landing pages (first use: page.ads-macbook-screen).
  No site header, navigation or footer: an ads page has one job, the quote.
  Always noindex. Analytics load the same way as layout/theme.liquid (deferred GA4 and PostHog).
  The A/B variant is chosen in the head, before anything paints, so there is no flicker.
{%- endcomment -%}
<html lang="en-GB" class="no-js" data-variant="a">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="robots" content="noindex, nofollow, noarchive">
    <title>{{ page_title }} | iCorrect</title>
    {%- if page_description -%}<meta name="description" content="{{ page_description | escape }}">{%- endif -%}
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <script>
      /* A/B split (BRIEF-v3 section 5): paid traffic only, 50/50, the same version every visit.
         A visitor is in the test when they arrive from a paid click (gclid, gbraid, wbraid or a paid
         utm_medium) or already hold the cookie. Everyone else sees Variant A and is marked not in test.
         ?variant=a or ?variant=b forces a version for review and is never stored. */
      (function () {
        var root = document.documentElement;
        root.className = root.className.replace('no-js', 'js');
        var q = new URLSearchParams(location.search);
        var name = 'ic_lp_mbs';
        var stored = (document.cookie.match(/(?:^|; )ic_lp_mbs=([ab])(?:;|$)/) || [])[1];
        var paid = q.has('gclid') || q.has('gbraid') || q.has('wbraid') ||
          /^(cpc|ppc|paid|paidsearch|paid_search|paid_social|paidsocial)$/i.test(q.get('utm_medium') || '');
        var forced = q.get('variant');
        var variant = 'a';
        var source = 'not_in_test';
        if (forced === 'a' || forced === 'b') { variant = forced; source = 'forced'; }
        else if (stored) { variant = stored; source = 'cookie'; }
        else if (paid) {
          variant = Math.random() < 0.5 ? 'a' : 'b';
          source = 'assigned';
          document.cookie = name + '=' + variant + '; Max-Age=7776000; Path=/; SameSite=Lax; Secure';
        }
        root.setAttribute('data-variant', variant);
        window.lpAB = { variant: variant, source: source, inTest: source === 'assigned' || source === 'cookie' };
      })();
    </script>

    <link rel="preload" as="font" type="font/woff2" crossorigin href="{{ 'Geist-Variable.woff2' | asset_url | split: '?' | first }}">
    <link rel="preload" as="font" type="font/woff2" crossorigin href="{{ 'GeistMono-Variable.woff2' | asset_url | split: '?' | first }}">
    {{ 'ads-mbs-tokens.css' | asset_url | stylesheet_tag }}
    {{ 'ads-mbs-components.css' | asset_url | stylesheet_tag }}
    {{ 'ads-mbs.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'ads-mbs.js' | asset_url }}" defer></script>

    {{ content_for_header }}

    <script>
      /* GA4: the same property and deferred loading as layout/theme.liquid. Every event on this page,
         including the quote wizard's own (wizard_start, step_complete, begin_checkout), carries
         lp, lp_variant and lp_in_test through gtag('set'). The wrapper lets ads-mbs.js see the
         wizard's events so it can send quote_start without changing the wizard. */
      window.dataLayer = window.dataLayer || [];
      window.lpGtagListeners = [];
      function gtag() {
        dataLayer.push(arguments);
        if (arguments[0] === 'event') {
          for (var i = 0; i < window.lpGtagListeners.length; i++) {
            try { window.lpGtagListeners[i](arguments[1], arguments[2]); } catch (e) {}
          }
        }
      }
      gtag('set', { lp: 'ads-macbook-screen', lp_variant: window.lpAB.variant, lp_in_test: window.lpAB.inTest, lp_ab_source: window.lpAB.source });

      function loadDeferredThirdPartyAnalytics() {
        if (window.__icorrectAnalyticsLoaded) return;
        window.__icorrectAnalyticsLoaded = true;
        var ga = document.createElement('script');
        ga.async = true;
        ga.src = 'https://www.googletagmanager.com/gtag/js?id=G-YHN7YHZNM8';
        ga.onload = function () {
          gtag('js', new Date());
          gtag('set', { lp: 'ads-macbook-screen', lp_variant: window.lpAB.variant, lp_in_test: window.lpAB.inTest, lp_ab_source: window.lpAB.source });
          gtag('config', 'G-YHN7YHZNM8');
        };
        document.head.appendChild(ga);

        !function(t,e){var o,n,p,r;e.__SV||(window.posthog && window.posthog.__loaded)||(window.posthog=e,e._i=[],e.init=function(i,s,a){function g(t,e){var o=e.split(".");2==o.length&&(t=t[o[0]],e=o[1]),t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}}(p=t.createElement("script")).type="text/javascript",p.crossOrigin="anonymous",p.async=!0,p.src=s.api_host.replace(".i.posthog.com","-assets.i.posthog.com")+"/static/array.js",(r=t.getElementsByTagName("script")[0]).parentNode.insertBefore(p,r);var u=e;for(void 0!==a?u=e[a]=[]:a="posthog",u.people=u.people||[],u.toString=function(t){var e="posthog";return"posthog"!==a&&(e+="."+a),t||(e+=" (stub)"),e},u.people.toString=function(){return u.toString(1)+".people (stub)"},o="init capture identify register".split(" "),n=0;n<o.length;n++)g(u,o[n]);e._i.push([i,s,a])},e.__SV=1)}(document,window.posthog||[]);
        posthog.init('phc_E4K3ulD49Fth2l3WOFjPpBbdgsbJwRMrErbWGjpppLB', {
          api_host: 'https://us.i.posthog.com',
          person_profiles: 'identified_only',
          capture_exceptions: true
        });
        posthog.register({ lp: 'ads-macbook-screen', lp_variant: window.lpAB.variant, lp_in_test: window.lpAB.inTest });
      }
      if ('requestIdleCallback' in window) {
        requestIdleCallback(loadDeferredThirdPartyAnalytics, { timeout: 3500 });
      } else {
        window.addEventListener('load', function () { setTimeout(loadDeferredThirdPartyAnalytics, 1); });
      }
    </script>
  </head>

  <body>
    <main id="MainContent" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>
  </body>
</html>
