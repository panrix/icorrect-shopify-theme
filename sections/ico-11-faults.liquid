<section class="section" id="common-faults">
  <div class="ic-container">
    <div class="section-head section-head--compact">
      <h2 class="section-title">{{ section.settings.heading | escape }}</h2>
      <p class="section-lead">{{ section.settings.lead | escape }}</p>
    </div>

    <div class="faults-grid">
      <a class="fault-tile" href="#quote-section" data-photo-slot="fault-cracked-lcd">
        <div class="fault-visual">
          {%- if section.settings.fault_1_image != blank -%}
            <img
              src="{{ section.settings.fault_1_image | image_url: width: 1280 }}"
              width="{{ section.settings.fault_1_image.width }}"
              height="{{ section.settings.fault_1_image.height }}"
              loading="lazy"
              alt="{{ section.settings.fault_1_alt | escape }}"
            >
          {%- else -%}
            <img
              src="{{ 'ico-11-fault-cracked-lcd.webp' | asset_url }}"
              width="1280"
              height="960"
              loading="lazy"
              alt="{{ section.settings.fault_1_alt | escape }}"
            >
          {%- endif -%}
        </div>
        <div class="fault-body">
          <div class="fault-title-row">
            <h3>{{ section.settings.fault_1_title | escape }}</h3>
            <span class="chev-right" aria-hidden="true"></span>
          </div>
          <span class="fault-tag">{{ section.settings.fault_1_tag | escape }}</span>
          <p>{{ section.settings.fault_1_body | escape }}</p>
          <span class="fault-model-cap">{{ section.settings.fault_1_caption | escape }}</span>
        </div>
      </a>

      <a class="fault-tile" href="#quote-section" data-photo-slot="fault-flexgate">
        <div class="fault-visual">
          {%- if section.settings.fault_2_image != blank -%}
            <img
              src="{{ section.settings.fault_2_image | image_url: width: 1280 }}"
              width="{{ section.settings.fault_2_image.width }}"
              height="{{ section.settings.fault_2_image.height }}"
              loading="lazy"
              alt="{{ section.settings.fault_2_alt | escape }}"
            >
          {%- else -%}
            <img
              src="{{ 'ico-11-fault-flexgate.webp' | asset_url }}"
              width="1280"
              height="960"
              loading="lazy"
              alt="{{ section.settings.fault_2_alt | escape }}"
            >
          {%- endif -%}
        </div>
        <div class="fault-body">
          <div class="fault-title-row">
            <h3>{{ section.settings.fault_2_title | escape }}</h3>
            <span class="chev-right" aria-hidden="true"></span>
          </div>
          <span class="fault-tag">{{ section.settings.fault_2_tag | escape }}</span>
          <p>{{ section.settings.fault_2_body | escape }}</p>
          <span class="fault-model-cap">{{ section.settings.fault_2_caption | escape }}</span>
        </div>
      </a>

      <a class="fault-tile" href="#quote-section" data-photo-slot="fault-dustgate">
        <div class="fault-visual">
          {%- if section.settings.fault_3_image != blank -%}
            <img
              src="{{ section.settings.fault_3_image | image_url: width: 1280 }}"
              width="{{ section.settings.fault_3_image.width }}"
              height="{{ section.settings.fault_3_image.height }}"
              loading="lazy"
              alt="{{ section.settings.fault_3_alt | escape }}"
            >
          {%- else -%}
            <img
              src="{{ 'ico-11-fault-dustgate.webp' | asset_url }}"
              width="1280"
              height="960"
              loading="lazy"
              alt="{{ section.settings.fault_3_alt | escape }}"
            >
          {%- endif -%}
        </div>
        <div class="fault-body">
          <div class="fault-title-row">
            <h3>{{ section.settings.fault_3_title | escape }}</h3>
            <span class="chev-right" aria-hidden="true"></span>
          </div>
          <span class="fault-tag">{{ section.settings.fault_3_tag | escape }}</span>
          <p>{{ section.settings.fault_3_body | escape }}</p>
          <span class="fault-model-cap">{{ section.settings.fault_3_caption | escape }}</span>
        </div>
      </a>

      <a class="fault-tile" href="#quote-section" data-photo-slot="fault-backlight">
        <div class="fault-visual">
          {%- if section.settings.fault_4_image != blank -%}
            <img
              src="{{ section.settings.fault_4_image | image_url: width: 720 }}"
              width="{{ section.settings.fault_4_image.width }}"
              height="{{ section.settings.fault_4_image.height }}"
              loading="lazy"
              alt="{{ section.settings.fault_4_alt | escape }}"
            >
          {%- else -%}
            <img
              src="{{ 'ico-11-fault-backlight.webp' | asset_url }}"
              width="720"
              height="540"
              loading="lazy"
              alt="{{ section.settings.fault_4_alt | escape }}"
            >
          {%- endif -%}
        </div>
        <div class="fault-body">
          <div class="fault-title-row">
            <h3>{{ section.settings.fault_4_title | escape }}</h3>
            <span class="chev-right" aria-hidden="true"></span>
          </div>
          <span class="fault-tag">{{ section.settings.fault_4_tag | escape }}</span>
          <p>{{ section.settings.fault_4_body | escape }}</p>
          <span class="fault-model-cap">{{ section.settings.fault_4_caption | escape }}</span>
        </div>
      </a>
    </div>

    <div class="fault-sublinks">
      <span>Specialist cable repairs:</span>
      <a class="text-link" href="{{ routes.collections_url }}/macbook-flexgate-repair-prices">Flexgate repair options</a>
      <a class="text-link" href="{{ routes.collections_url }}/macbook-dustgate-repair-prices">Dustgate repair options</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "ICO-11 Common Faults",
  "tag": "div",
  "class": "ico11-shopify",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Is your MacBook screen cracked, flickering, or dark?"
    },
    {
      "type": "textarea",
      "id": "lead",
      "label": "Lead copy",
      "default": "Recognise your fault below, then select your model in the quote tool for a fixed upfront price."
    },
    {
      "type": "header",
      "content": "Fault 1: Cracked LCD"
    },
    {
      "type": "image_picker",
      "id": "fault_1_image",
      "label": "Override photo (optional)",
      "info": "Defaults to bundled ico-11-fault-cracked-lcd.webp."
    },
    {
      "type": "text",
      "id": "fault_1_alt",
      "label": "Alt text",
      "default": "MacBook Pro 14-inch M2 A2779 on the iCorrect Fitzrovia bench showing impact cracks, black liquid-crystal bleed, and vertical colour lines"
    },
    {
      "type": "text",
      "id": "fault_1_title",
      "label": "Title",
      "default": "Cracked glass or bleeding LCD"
    },
    {
      "type": "text",
      "id": "fault_1_tag",
      "label": "Tag",
      "default": "Panel replacement"
    },
    {
      "type": "textarea",
      "id": "fault_1_body",
      "label": "Description",
      "default": "Spiderweb cracks, spreading black ink patches, or vertical lines after impact."
    },
    {
      "type": "text",
      "id": "fault_1_caption",
      "label": "Model caption",
      "default": "MacBook Pro 14\" (M2, A2779)"
    },
    {
      "type": "header",
      "content": "Fault 2: Flexgate"
    },
    {
      "type": "image_picker",
      "id": "fault_2_image",
      "label": "Override photo (optional)",
      "info": "Defaults to bundled ico-11-fault-flexgate.webp."
    },
    {
      "type": "text",
      "id": "fault_2_alt",
      "label": "Alt text",
      "default": "MacBook Pro 13-inch Touch Bar A1706 on the iCorrect Fitzrovia bench showing classic Flexgate stage-light glow cones along the bottom display edge"
    },
    {
      "type": "text",
      "id": "fault_2_title",
      "label": "Title",
      "default": "Flickering, lines and Flexgate"
    },
    {
      "type": "text",
      "id": "fault_2_tag",
      "label": "Tag",
      "default": "Cable or panel"
    },
    {
      "type": "textarea",
      "id": "fault_2_body",
      "label": "Description",
      "default": "Stage-light glow along the bottom edge or screen blanking past an angle."
    },
    {
      "type": "text",
      "id": "fault_2_caption",
      "label": "Model caption",
      "default": "MacBook Pro 13\" (Intel, A1706)"
    },
    {
      "type": "header",
      "content": "Fault 3: Dustgate"
    },
    {
      "type": "image_picker",
      "id": "fault_3_image",
      "label": "Override photo (optional)",
      "info": "Defaults to bundled ico-11-fault-dustgate.webp."
    },
    {
      "type": "text",
      "id": "fault_3_alt",
      "label": "Alt text",
      "default": "MacBook Pro 16-inch A2141 on the iCorrect Fitzrovia bench showing repeating vertical grey and colour Dustgate columns on an uncracked screen"
    },
    {
      "type": "text",
      "id": "fault_3_title",
      "label": "Title",
      "default": "Dustgate bars and distortion"
    },
    {
      "type": "text",
      "id": "fault_3_tag",
      "label": "Tag",
      "default": "Micro-soldering"
    },
    {
      "type": "textarea",
      "id": "fault_3_body",
      "label": "Description",
      "default": "Vertical bars or colour distortion across an uncracked screen from hinge cable wear."
    },
    {
      "type": "text",
      "id": "fault_3_caption",
      "label": "Model caption",
      "default": "MacBook Pro 16\" (Intel, A2141)"
    },
    {
      "type": "header",
      "content": "Fault 4: Backlight"
    },
    {
      "type": "image_picker",
      "id": "fault_4_image",
      "label": "Override photo (optional)",
      "info": "Defaults to bundled ico-11-fault-backlight.webp."
    },
    {
      "type": "text",
      "id": "fault_4_alt",
      "label": "Alt text",
      "default": "MacBook Pro 16-inch M1 A2485 on the iCorrect Fitzrovia bench with a dead backlight, faint image revealed under a technician LED ring light"
    },
    {
      "type": "text",
      "id": "fault_4_title",
      "label": "Title",
      "default": "Dark or black backlight"
    },
    {
      "type": "text",
      "id": "fault_4_tag",
      "label": "Tag",
      "default": "Intake check"
    },
    {
      "type": "textarea",
      "id": "fault_4_body",
      "label": "Description",
      "default": "MacBook chimes or shows a faint image under torchlight while the panel stays dark."
    },
    {
      "type": "text",
      "id": "fault_4_caption",
      "label": "Model caption",
      "default": "MacBook Pro 16\" (M1, A2485)"
    }
  ],
  "presets": [
    {
      "name": "ICO-11 Common Faults"
    }
  ]
}
{% endschema %}
