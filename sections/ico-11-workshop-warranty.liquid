{%- liquid
  assign photo_1 = section.settings.workshop_photo_1
  assign photo_2 = section.settings.workshop_photo_2
  assign has_photo_1 = false
  assign has_photo_2 = false
  if photo_1 != blank
    assign has_photo_1 = true
  endif
  if photo_2 != blank
    assign has_photo_2 = true
  endif
-%}

<section class="section section-compact section-soft" id="workshop">
  <div class="ic-container">
    <div class="section-head section-head--compact">
      <h2 class="section-title">{{ section.settings.heading | escape }}</h2>
      <p class="section-lead">{{ section.settings.lead | escape }}</p>
    </div>

    <div class="workshop-grid">
      <div class="workshop-card">
        <div>
          <span class="mono-label">{{ section.settings.workshop_kicker | escape }}</span>
          <h3>{{ section.settings.workshop_address | escape }}</h3>
        </div>

        {%- if has_photo_1 or has_photo_2 -%}
          <div class="workshop-photos{% if has_photo_1 and has_photo_2 %} is-pair{% endif %}">
            {%- if has_photo_1 -%}
              <div class="workshop-photo-frame">
                <img
                  src="{{ photo_1 | image_url: width: 960 }}"
                  srcset="{{ photo_1 | image_url: width: 480 }} 480w, {{ photo_1 | image_url: width: 960 }} 960w"
                  sizes="(max-width: 960px) 100vw, 520px"
                  width="{{ photo_1.width }}"
                  height="{{ photo_1.height }}"
                  loading="lazy"
                  alt="{{ section.settings.workshop_photo_1_alt | default: photo_1.alt | default: 'iCorrect Fitzrovia workshop bench at 12 Margaret Street' | escape }}"
                >
              </div>
            {%- endif -%}
            {%- if has_photo_2 -%}
              <div class="workshop-photo-frame">
                <img
                  src="{{ photo_2 | image_url: width: 960 }}"
                  srcset="{{ photo_2 | image_url: width: 480 }} 480w, {{ photo_2 | image_url: width: 960 }} 960w"
                  sizes="(max-width: 960px) 100vw, 520px"
                  width="{{ photo_2.width }}"
                  height="{{ photo_2.height }}"
                  loading="lazy"
                  alt="{{ section.settings.workshop_photo_2_alt | default: photo_2.alt | default: 'iCorrect Fitzrovia microelectronics workshop' | escape }}"
                >
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}

        <div class="hours-grid" aria-label="Workshop opening hours">
          <strong>Mon to Fri</strong><span>{{ section.settings.hours_weekday | escape }}</span>
          <strong>Sat &amp; Sun</strong><span>{{ section.settings.hours_weekend | escape }}</span>
        </div>

        <p class="workshop-card-note">{{ section.settings.workshop_note | escape }}</p>
        <p class="workshop-contact">
          <span>Phone <a class="text-link" href="tel:+442070998517">{{ section.settings.phone_display | escape }}</a></span>
          <span>Email <a class="text-link" href="mailto:{{ section.settings.email | escape }}">{{ section.settings.email | escape }}</a></span>
        </p>
      </div>

      <div class="warranty-plate" id="warranty">
        <div class="warranty-plate-head">
          <span class="mono-label">{{ section.settings.warranty_kicker | escape }}</span>
          <h3 class="warranty-stamp">{{ section.settings.warranty_heading | escape }}</h3>
        </div>

        <div class="warranty-groups">
          <div>
            <p class="warranty-group-label">Covered</p>
            <ul class="warranty-list">
              <li><span class="check-mark" aria-hidden="true"></span><span>{{ section.settings.covered_1 | escape }}</span></li>
              <li><span class="check-mark" aria-hidden="true"></span><span>{{ section.settings.covered_2 | escape }}</span></li>
              <li><span class="check-mark" aria-hidden="true"></span><span>{{ section.settings.covered_3 | escape }}</span></li>
            </ul>
          </div>

          <div>
            <p class="warranty-group-label">Not covered</p>
            <ul class="warranty-list is-excluded">
              <li><span class="cross-mark" aria-hidden="true"></span><span>{{ section.settings.not_covered_1 | escape }}</span></li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "ICO-11 Workshop Warranty",
  "tag": "div",
  "class": "ico11-shopify",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Fitzrovia workshop and 2-year warranty"
    },
    {
      "type": "textarea",
      "id": "lead",
      "label": "Lead copy",
      "default": "Every MacBook is repaired in-house by our microelectronics team at 12 Margaret Street, never outsourced."
    },
    {
      "type": "header",
      "content": "Fitzrovia workshop card"
    },
    {
      "type": "text",
      "id": "workshop_kicker",
      "label": "Workshop kicker",
      "default": "Fitzrovia workshop"
    },
    {
      "type": "text",
      "id": "workshop_address",
      "label": "Workshop address",
      "default": "12 Margaret Street, Audley House, London W1W 8JQ"
    },
    {
      "type": "image_picker",
      "id": "workshop_photo_1",
      "label": "Workshop photo 1 (optional)",
      "info": "Leave blank to keep the clean balanced card layout until final Fitzrovia workshop photos are ready."
    },
    {
      "type": "text",
      "id": "workshop_photo_1_alt",
      "label": "Workshop photo 1 alt text"
    },
    {
      "type": "image_picker",
      "id": "workshop_photo_2",
      "label": "Workshop photo 2 (optional)"
    },
    {
      "type": "text",
      "id": "workshop_photo_2_alt",
      "label": "Workshop photo 2 alt text"
    },
    {
      "type": "text",
      "id": "hours_weekday",
      "label": "Monday to Friday hours",
      "default": "9am to 6pm"
    },
    {
      "type": "text",
      "id": "hours_weekend",
      "label": "Saturday and Sunday hours",
      "default": "Closed"
    },
    {
      "type": "text",
      "id": "workshop_note",
      "label": "Workshop note",
      "default": "Pre-booked drop-off in Fitzrovia, free tracked UK mail-in, or London courier collection (free in most zones; £25 in outer Band 4)."
    },
    {
      "type": "text",
      "id": "phone_display",
      "label": "Phone display text",
      "default": "020 7099 8517"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Support email",
      "default": "support@icorrect.co.uk"
    },
    {
      "type": "header",
      "content": "Warranty plate"
    },
    {
      "type": "text",
      "id": "warranty_kicker",
      "label": "Warranty kicker",
      "default": "Included as standard"
    },
    {
      "type": "text",
      "id": "warranty_heading",
      "label": "Warranty heading",
      "default": "2-year warranty"
    },
    {
      "type": "text",
      "id": "covered_1",
      "label": "Covered item 1",
      "default": "Display panel and backlight faults"
    },
    {
      "type": "text",
      "id": "covered_2",
      "label": "Covered item 2",
      "default": "Fitting, alignment, and hinge calibration"
    },
    {
      "type": "text",
      "id": "covered_3",
      "label": "Covered item 3",
      "default": "Your data stays untouched on your MacBook"
    },
    {
      "type": "text",
      "id": "not_covered_1",
      "label": "Not covered item 1",
      "default": "New impact or liquid damage"
    }
  ],
  "presets": [
    {
      "name": "ICO-11 Workshop Warranty"
    }
  ]
}
{% endschema %}
