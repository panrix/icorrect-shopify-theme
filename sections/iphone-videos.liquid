{% comment %}
  Section: iPhone Videos
  Redesigned click-to-play 3-video panel using snippets/icorrect-video-panel.liquid.
  Preserves all existing Theme Customizer settings across iPhone templates.
{% endcomment %}

{%- render 'icorrect-video-panel',
  section: section,
  kicker: 'Inside Our Fitzrovia Workshop · Same-Day Screen Repairs',
  badge: 'Original Apple Parts',
  tag_prefix: 'iPhone Bench',
  default_heading: 'Behind the scenes',
  default_subtitle: 'Watch our videos to understand common repair issues, what to expect, and how we fix your device with care.',
  video_1_id: 'PEa5le-a5_g',
  video_1_fallback_title: 'We specialise in data recovery.',
  video_1_aria: 'iPhone logic board repair and data recovery when Apple says it is not possible',
  video_1_default_desc: 'Board-level iPhone fault tracing and micro-soldering to recover photos and files from dead or liquid-damaged handsets.',
  video_2_id: 'NzWmYuTcxns',
  video_2_fallback_title: 'Do not compromise on quality.',
  video_2_aria: 'Why genuine Apple iPhone screens outlast cheap aftermarket replacements',
  video_2_default_desc: 'Why genuine Apple OLED displays protect brightness, touch accuracy, and battery life compared to cheap copies.',
  video_3_id: 'P6gIFwmokIQ',
  video_3_fallback_title: 'Poor quality parts cause serious issues.',
  video_3_aria: 'iPhone 14 overheating caused by a poor quality aftermarket LCD screen',
  video_3_default_desc: 'Real bench case showing how an aftermarket LCD drew excess current and caused overheating on an iPhone 14.'
-%}

{% schema %}
{
  "name": "iPhone Videos",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Title",
      "default": "Behind the scenes"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Watch our videos to understand common repair issues, what to expect, and how we fix your device with care."
    },
    {
      "type": "text",
      "id": "video_1_title",
      "label": "Video 1 title (under video)",
      "default": "We specialise in data recovery."
    },
    {
      "type": "text",
      "id": "video_1_desc",
      "label": "Video 1 caption (optional)"
    },
    {
      "type": "text",
      "id": "video_2_title",
      "label": "Video 2 title (under video)",
      "default": "Do not compromise on quality."
    },
    {
      "type": "text",
      "id": "video_2_desc",
      "label": "Video 2 caption (optional)"
    },
    {
      "type": "text",
      "id": "video_3_title",
      "label": "Video 3 title (under video)",
      "default": "Poor quality parts cause serious issues."
    },
    {
      "type": "text",
      "id": "video_3_desc",
      "label": "Video 3 caption (optional)"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "iPhone Videos"
    }
  ]
}
{% endschema %}
