    },
    {
      "type": "text",
      "id": "stamp_2_figure",
      "label": "Stamp 2 figure",
      "default": "from £299"
    },
    {
      "type": "text",
      "id": "stamp_2_label",
      "label": "Stamp 2 label",
      "default": "fixed upfront, free collection"
    },
    {
      "type": "text",
      "id": "stamp_3_figure",
      "label": "Stamp 3 figure",
      "default": "2 working days"
    },
    {
      "type": "text",
      "id": "stamp_3_label",
      "label": "Stamp 3 label",
      "default": "once it reaches our workshop"
    },
    {
      "type": "text",
      "id": "stamp_4_figure",
      "label": "Stamp 4 figure",
      "default": "2-year warranty"
    },
    {
      "type": "text",
      "id": "stamp_4_label",
      "label": "Stamp 4 label",
      "default": "panel and workmanship"
    }
  ],
  "presets": [
    {
      "name": "ICO-11 Hero & Proof"
    }
  ]
