{%- if collection.products_count > 0 -%}
  <section class="macbook-price-table page-width" id="macbook-price-table">
    <h2>{{ section.settings.heading | escape }}</h2>
    {%- assign priced_products = collection.products | sort: 'title' -%}
      {%- if section.settings.air_heading != blank -%}
        <h3>{{ section.settings.air_heading | escape }}</h3>
        <div class="macbook-price-table__scroll">
          <table>
            <thead>
              <tr>
                <th scope="col">Model</th>
                <th scope="col">Model number</th>
                <th scope="col">Year / chip</th>
                <th scope="col">Price</th>
              </tr>
            </thead>
            <tbody>
              {%- for product in priced_products -%}
                {%- assign row_title = product.title | downcase -%}
                {%- if row_title contains 'macbook air' -%}
                  {%- render 'macbook-price-row', product: product -%}
                {%- endif -%}
              {%- endfor -%}
            </tbody>
          </table>
        </div>
      {%- endif -%}
      {%- if section.settings.pro_heading != blank -%}
        <h3>{{ section.settings.pro_heading | escape }}</h3>
        <div class="macbook-price-table__scroll">
          <table>
            <thead>
              <tr>
                <th scope="col">Model</th>
                <th scope="col">Model number</th>
                <th scope="col">Year / chip</th>
                <th scope="col">Price</th>
              </tr>
            </thead>
            <tbody>
              {%- for product in priced_products -%}
                {%- assign row_title = product.title | downcase -%}
                {%- if row_title contains 'macbook pro' -%}
                  {%- render 'macbook-price-row', product: product -%}
                {%- endif -%}
              {%- endfor -%}
            </tbody>
          </table>
        </div>
      {%- endif -%}
  </section>
{%- endif -%}

{% stylesheet %}
  .macbook-price-table {
    max-width: 980px;
    margin: 0 auto;
    padding-top: 28px;
    padding-bottom: 12px;
  }
  .macbook-price-table h2 {
    margin: 0 0 8px;
    font-size: 28px;
    line-height: 1.2;
    color: #1d1d1f;
    text-align: center;
  }
  .macbook-price-table h3 {
    margin: 22px 0 8px;
    font-size: 18px;
    line-height: 1.3;
    color: #1d1d1f;
  }
  .macbook-price-table__scroll {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }
  .macbook-price-table table {
    width: 100%;
    border-collapse: collapse;
  }
  .macbook-price-table th,
  .macbook-price-table td {
    padding: 10px 12px;
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
    text-align: left;
    font-size: 14px;
    line-height: 1.4;
    color: #1d1d1f;
    white-space: nowrap;
  }
  .macbook-price-table tbody th {
    white-space: normal;
    min-width: 9rem;
    padding-right: 16px;
  }
  .macbook-price-table thead th {
    font-size: 12px;
    font-weight: 600;
    color: #6e6e73;
  }
  .macbook-price-table a {
    color: #1d1d1f;
    text-decoration: none;
  }
  .macbook-price-table a:hover,
  .macbook-price-table a:focus-visible {
    text-decoration: underline;
  }
  @media (max-width: 749px) {
    .macbook-price-table {
      padding-left: 16px;
      padding-right: 16px;
    }
    .macbook-price-table h2 {
      font-size: 22px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "MacBook price table",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Repair prices by model"
    },
    {
      "type": "text",
      "id": "air_heading",
      "label": "Air group heading",
      "default": "MacBook Air"
    },
    {
      "type": "text",
      "id": "pro_heading",
      "label": "Pro group heading",
      "default": "MacBook Pro"
    }
  ],
  "presets": [
    {
      "name": "MacBook price table"
    }
  ]
}
{% endschema %}
