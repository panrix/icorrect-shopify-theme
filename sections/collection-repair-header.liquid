{%- comment -%}
  Title + description hero for model/price collection pages.
  Sit above the quote wizard; pair with icorrect-product-grid (show_header off).
{%- endcomment -%}
<section class="repair-collection-header" id="repair-header-{{ section.id }}">
  <div class="page-width">
    <div class="repair-section-header">
      <h1>{{ collection.title | escape }}</h1>
      {% if collection.description != blank %}
        <div class="repair-section-desc">
          {{ collection.description }}
        </div>
      {% endif %}
    </div>
  </div>
</section>

<style>
  #repair-header-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background-color: {{ section.settings.bg }};
  }
  #repair-header-{{ section.id }} .repair-section-header {
    text-align: center;
    max-width: 650px;
    margin: 0 auto;
  }
  #repair-header-{{ section.id }} .repair-section-header h1 {
    font-size: clamp(28px, 4vw, 40px);
    line-height: 1.15;
    letter-spacing: -0.03em;
    margin: 0 0 12px;
    color: #1d1d1f;
  }
  #repair-header-{{ section.id }} .repair-section-desc {
    font-size: 16px;
    line-height: 1.55;
    color: #6e6e73;
  }
  #repair-header-{{ section.id }} .repair-section-desc p {
    margin: 0 0 0.6em;
  }
  #repair-header-{{ section.id }} .repair-section-desc p:last-child {
    margin-bottom: 0;
  }
  @media (max-width: 749px) {
    #repair-header-{{ section.id }} {
      padding-top: {{ section.settings.mob_padding_top }}px;
      padding-bottom: {{ section.settings.mob_padding_bottom }}px;
    }
    #repair-header-{{ section.id }} .repair-section-header h1 {
      font-size: 28px;
    }
  }
</style>

{% schema %}
{
  "name": "Collection repair header",
  "settings": [
    {
      "type": "color",
      "id": "bg",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Desktop top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Desktop bottom padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "mob_padding_top",
      "label": "Mobile top padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "mob_padding_bottom",
      "label": "Mobile bottom padding",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "Collection repair header"
    }
  ]
}
{% endschema %}
