<section id="identify" class="identify">
  <div class="ic-container identify-grid">
    <div class="identify-visual">
      <div class="identify-visual-inner">
        <div class="identify-plate">
          <div class="identify-plate-line">Designed by Apple in California.</div>
          <div class="identify-plate-line muted">Assembled in China</div>
          <div class="identify-plate-line highlight">Model <span class="hl">A2442</span></div>
          <div class="identify-plate-line muted">EMC 3650 &middot; 61W USB-C</div>
        </div>
        <div class="mono-label identify-hint">Printed on the underside, near the hinge</div>
      </div>
    </div>

    <div class="identify-text">
      <div class="mono-label">{{ section.settings.kicker | escape }}</div>
      <h2>{{ section.settings.heading | escape }}</h2>
      <p>{{ section.settings.lead | escape }}</p>

      <form class="identify-form-wrap" id="identify-form" novalidate>
        <label class="field-label" for="identify-input">Model number <span class="field-hint">(for example A2442)</span></label>
        <div class="identify-form">
          <input
            id="identify-input"
            name="model"
            type="text"
            inputmode="text"
            autocapitalize="characters"
            spellcheck="false"
            autocomplete="off"
            maxlength="12"
            aria-describedby="identify-error"
          >
          <button type="submit" class="btn-dark">{{ section.settings.button_label | escape }}</button>
        </div>
        <p class="identify-error" id="identify-error" hidden>Enter the model number from the underside of your MacBook, for example A2442.</p>
      </form>

      <div class="identify-result" id="identify-result" role="status" aria-live="polite"></div>
      <div class="identify-foot">Or <a class="text-link" href="#quote-section">browse every model in the quote tool below</a></div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "ICO-11 Model Finder",
  "tag": "div",
  "class": "ico11-shopify",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Not sure which model you have?"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Find your model number in 5 seconds"
    },
    {
      "type": "textarea",
      "id": "lead",
      "label": "Lead copy",
      "default": "Flip your MacBook over and look for the code starting with \"A\" near the hinge. Enter it below to confirm your exact repair price."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Find my model"
    }
  ],
  "presets": [
    {
      "name": "ICO-11 Model Finder"
    }
  ]
}
{% endschema %}
