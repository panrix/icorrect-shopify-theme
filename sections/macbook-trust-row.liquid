<section class="why-icorrect why-icorrect-{{ section.id }}" id="why-icorrect-{{ section.id }}">
  <div class="page-width">
    <h2>{{ section.settings.heading | escape }}</h2>
    <ul>
      {%- for block in section.blocks -%}
        <li {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}"{% if block.settings.new_tab %} target="_blank" rel="noopener"{% endif %}>{{ block.settings.label | escape }}</a>
          {%- else -%}
            <span>{{ block.settings.label | escape }}</span>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% stylesheet %}
  .why-icorrect {
    padding: 20px 0 10px;
    background: #fafafa;
  }
  .why-icorrect h2 {
    margin: 0 0 12px;
    color: #1d1d1f;
    font-size: 28px;
    font-weight: 600;
    line-height: 1.3;
    text-align: left;
  }
  .why-icorrect ul {
    margin: 0;
    padding: 0;
    list-style: none;
    max-width: 720px;
  }
  .why-icorrect li {
    margin: 0;
    padding: 10px 0;
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
    color: #333;
    font-size: 16px;
    font-weight: 400;
    line-height: 1.65;
  }
  .why-icorrect a {
    color: #1d1d1f;
    font-size: 16px;
    font-weight: 400;
    line-height: 1.65;
    text-decoration: none;
  }
  @media (max-width: 767px) {
    .why-icorrect {
      padding: 15px 0 10px;
    }
    .why-icorrect h2 {
      font-size: 24px;
      line-height: 1.3;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Why iCorrect",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why iCorrect"
    }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Point",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label"
        },
        {
          "type": "text",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "checkbox",
          "id": "new_tab",
          "label": "Open in a new tab",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Why iCorrect"
    }
  ]
}
{% endschema %}
