<section class="section" id="compare">
  <div class="ic-container">
    <div class="section-head section-head--compact">
      <h2 class="section-title">{{ section.settings.heading | escape }}</h2>
      <p class="section-lead">{{ section.settings.lead | escape }}</p>
    </div>

    <div class="compare-card">
      <table class="compare-table" aria-label="Comparison of MacBook screen repair options">
        <thead>
          <tr>
            <th scope="col" class="cmp-corner">Comparison</th>
            <th scope="col" class="cmp-th is-win">
              <span class="cmp-th-tag">Panel only</span>
              <span class="cmp-th-name">iCorrect</span>
            </th>
            <th scope="col" class="cmp-th">
              <span class="cmp-th-tag">Full lid</span>
              <span class="cmp-th-name">
                <span class="cmp-name-full">Apple Store &amp; full-lid shops</span>
                <span class="cmp-name-short" aria-hidden="true">Apple &amp; full-lid</span>
              </span>
            </th>
            <th scope="col" class="cmp-th">
              <span class="cmp-th-tag">Copy parts</span>
              <span class="cmp-th-name">
                <span class="cmp-name-full">Aftermarket shops</span>
                <span class="cmp-name-short" aria-hidden="true">Aftermarket</span>
              </span>
            </th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <th scope="row" class="cmp-row-label">What gets replaced &amp; waste</th>
            <td class="cmp-td is-win">
              <div class="cmp-val-row">
                <span class="cmp-parts-mark is-win" aria-hidden="true">
                  <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>
                </span>
                <span class="cmp-val">Broken panel only</span>
              </div>
              <span class="cmp-sub">Least waste: keeps your working aluminium lid, camera, sensors, and hinges out of landfill.</span>
            </td>
            <td class="cmp-td">
              <span class="cmp-val">Entire display lid</span>
              <span class="cmp-sub">Swaps out your working aluminium lid, camera, sensors, and hinges with the cracked panel.</span>
            </td>
            <td class="cmp-td">
              <div class="cmp-val-row">
                <span class="cmp-parts-mark is-no" aria-hidden="true">
                  <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M7 7l10 10M17 7L7 17"/></svg>
                </span>
                <span class="cmp-val">Entire lid, copy parts</span>
              </div>
              <span class="cmp-sub">Replaces the whole lid with a non-OEM housing and sends your original assembly to waste.</span>
            </td>
          </tr>

          <tr>
            <th scope="row" class="cmp-row-label">Display quality &amp; calibration</th>
            <td class="cmp-td is-win">
              <div class="cmp-val-row">
                <span class="cmp-parts-mark is-win" aria-hidden="true">
                  <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>
                </span>
                <span class="cmp-val">Genuine Apple panel</span>
              </div>
              <span class="cmp-sub">Recalibrated in-house for True Tone, peak brightness, and factory colour accuracy.</span>
            </td>
            <td class="cmp-td">
              <div class="cmp-val-row">
                <span class="cmp-parts-mark is-fair" aria-hidden="true">
                  <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>
                </span>
                <span class="cmp-val">Genuine Apple assembly</span>
              </div>
              <span class="cmp-sub">Factory display quality from Apple or independent full-lid replacement shops.</span>
            </td>
            <td class="cmp-td">
              <div class="cmp-val-row">
                <span class="cmp-parts-mark is-no" aria-hidden="true">
                  <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M7 7l10 10M17 7L7 17"/></svg>
                </span>
                <span class="cmp-val">Copy LCD panel</span>
              </div>
              <span class="cmp-sub">Dimmer backlight, lower colour accuracy, and True Tone often missing.</span>
            </td>
          </tr>

          <tr>
            <th scope="row" class="cmp-row-label">Typical cost</th>
            <td class="cmp-td is-win">
              <span class="cmp-val">30% to 50% less</span>
              <span class="cmp-sub">Pay for the damaged panel only, from £299 fixed upfront.</span>
            </td>
            <td class="cmp-td">
              <span class="cmp-val">Full-lid pricing</span>
              <span class="cmp-sub">Apple and full-lid repair shops charge for a complete lid assembly.</span>
            </td>
            <td class="cmp-td">
              <span class="cmp-val">Lower upfront</span>
              <span class="cmp-sub">Cheaper initially, using non-OEM glass and third-party housing.</span>
            </td>
          </tr>

          <tr>
            <th scope="row" class="cmp-row-label">Warranty</th>
            <td class="cmp-td is-win">
              <span class="cmp-val">2-year warranty</span>
              <span class="cmp-sub">Covers the genuine Apple panel and our Fitzrovia workmanship.</span>
            </td>
            <td class="cmp-td">
              <span class="cmp-val">90 days (Apple)</span>
              <span class="cmp-sub">Apple out-of-warranty cover is 90 days; independent full-lid shops vary.</span>
            </td>
            <td class="cmp-td">
              <span class="cmp-val">Varies by shop</span>
              <span class="cmp-sub">Some aftermarket shops offer warranties, though cover applies to copy parts.</span>
            </td>
          </tr>
        </tbody>
      </table>
    </div>

    <p class="compare-footnote">{{ section.settings.footnote | escape }}</p>
  </div>
</section>

{% schema %}
{
  "name": "ICO-11 Comparison Table",
  "tag": "div",
  "class": "ico11-shopify",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "How our display repair compares"
    },
    {
      "type": "textarea",
      "id": "lead",
      "label": "Lead copy",
      "default": "See how genuine panel-only repair compares with full-lid replacements and aftermarket copy screens on waste, display quality, cost, and warranty."
    },
    {
      "type": "textarea",
      "id": "footnote",
      "label": "Footnote",
      "default": "Replacing only the damaged panel cuts electronic waste while keeping True Tone, peak brightness, and in-house board-level backup for backlight and flex faults as standard."
    }
  ],
  "presets": [
    {
      "name": "ICO-11 Comparison Table"
    }
  ]
}
{% endschema %}
