<section class="parent-categories-{{ section.id }}">
  <div class="parent-categories-wrapper page-width">
    <div class="parent-categories-info">
      <h2>{{ section.settings.heading }}</h2>
      {% if section.settings.details != blank %}
        <p>{{ section.settings.details }}</p>
      {% endif %}
      <a href="{{ section.settings.btn_link }}" class="read-more">{{ section.settings.btn_text }}</a>
    </div>
    {%- liquid
      assign imageless = true
      if settings.repair_imageless == false
        assign imageless = false
      endif
      assign tile_context = section.settings.heading | append: ' ' | append: collection.title | append: ' ' | append: collection.handle
    -%}
    {%- if imageless -%}
      {{ 'repair-imageless.css' | asset_url | stylesheet_tag }}
    {%- endif -%}
    {%- liquid
      assign tile_order = ''
      for block in section.blocks
        assign tile_order = tile_order | append: forloop.index0 | append: ','
      endfor
      if imageless and section.settings.auto_sort != false
        capture tile_titles
          for block in section.blocks
            echo block.settings.title | replace: '||', ' '
            unless forloop.last
              echo '||'
            endunless
          endfor
        endcapture
        capture tile_order
          render 'model-order', titles: tile_titles, repair_context: tile_context
        endcapture
      endif
      assign tile_order = tile_order | strip | split: ','

    -%}
    <div class="parent-category-row{% if imageless %} parent-category-row--imageless{% endif %}">
      {% for tile_index in tile_order %}
        {%- assign block_index = tile_index | plus: 0 -%}
        {%- assign block = section.blocks[block_index] -%}
        {%- if imageless -%}
          {%- liquid
            capture tile_meta
              render 'repair-meta', title: block.settings.title, repair_context: tile_context
            endcapture
            assign tile_meta = tile_meta | strip | split: '|'
            assign tile_family = tile_meta[0]
            assign tile_repair = tile_meta[1]
            assign tile_scale = tile_meta[2]

            assign tile_stats = ''
            assign tile_count = 0
            assign tile_screen = 100000000
            assign tile_battery = 100000000
            if section.settings.show_stats != false and block.settings.link contains '/collections/'
              assign tile_handle = block.settings.link | split: '/collections/' | last | split: '?' | first | split: '#' | first
              assign tile_collection = collections[tile_handle]
              if tile_collection.products_count > 0
                assign tile_count = tile_collection.products_count
                assign tile_min = 100000000
                assign tile_screen = 100000000
                assign tile_screen_count = 0
                assign tile_battery = 100000000
                assign tile_battery_count = 0
                for p in tile_collection.products limit: 50
                  if p.price == 0 or p.title contains 'Diagnostic'
                    continue
                  endif
                  if p.price < tile_min
                    assign tile_min = p.price
                  endif
                  if p.title contains 'Battery'
                    assign tile_battery_count = tile_battery_count | plus: 1
                    if p.price < tile_battery
                      assign tile_battery = p.price
                    endif
                  elsif p.title contains 'Screen' or p.title contains 'Display'
                    unless p.title contains 'Rear' or p.title contains 'Camera'
                      assign tile_screen_count = tile_screen_count | plus: 1
                      if p.price < tile_screen
                        assign tile_screen = p.price
                      endif
                    endunless
                  endif
                endfor
                if tile_collection.products_count == 1
                  assign tile_stats = '1 repair'
                else
                  assign tile_stats = tile_collection.products_count | append: ' repairs'
                endif
                if tile_min < 100000000
                  assign tile_min_money = tile_min | money_without_trailing_zeros
                  assign tile_stats = tile_stats | append: '|from ' | append: tile_min_money
                endif
              endif
            endif
            if block.settings.price != blank
              assign tile_stats = block.settings.price
            endif
            assign tile_stats = tile_stats | split: '|'
          -%}
          <div class="parent-category-col col-{{ section.settings.column_per_row }}" {{ block.shopify_attributes }}>
            <div class="mt" data-family="{{ tile_family }}" data-repair="{{ tile_repair }}">
              <span class="mt__visual">
                {%- if tile_repair != 'repair' -%}
                  {% render 'repair-icon', icon: tile_repair, family: tile_family, size: 40 %}
                {%- else -%}
                  {% render 'device-glyph', family: tile_family, title: block.settings.title, repair_context: tile_context, scale: tile_scale %}
                {%- endif -%}
              </span>
              <h3 class="mt__title">{{ block.settings.title | escape }}</h3>
              {%- if tile_repair == 'repair' and tile_screen < 100000000 or tile_repair == 'repair' and tile_battery < 100000000 -%}
                <ul class="mt__prices">
                  {%- if tile_screen < 100000000 -%}
                    <li class="mt__price-row">
                      Screen
                      <strong>{% if tile_screen_count > 1 %}<small>from </small>{% endif %}{{ tile_screen | money_without_trailing_zeros }}</strong>
                    </li>
                  {%- endif -%}
                  {%- if tile_battery < 100000000 -%}
                    <li class="mt__price-row">
                      Battery
                      <strong>{% if tile_battery_count > 1 %}<small>from </small>{% endif %}{{ tile_battery | money_without_trailing_zeros }}</strong>
                    </li>
                  {%- endif -%}
                </ul>
              {%- elsif tile_stats != blank -%}
                <p class="mt__meta">
                  {%- for stat in tile_stats -%}<span>{{ stat | escape }}</span>{%- endfor -%}
                </p>
              {%- endif -%}
              <span class="mt__spacer"></span>
              {%- if block.settings.link != blank -%}
                <a class="mt__btn" href="{{ block.settings.link }}">
                  {%- if tile_repair == 'repair' and tile_count > 0 -%}
                    <span class="mt__btn-full">View all {{ tile_count }} repairs</span><span class="mt__btn-short">{{ tile_count }} repairs</span>
                  {%- else -%}
                    {{- block.settings.btn | default: 'View repairs' | escape -}}
                  {%- endif %}
                  {% render 'repair-icon', icon: 'arrow', size: 15 -%}
                </a>
              {%- endif -%}
            </div>
          </div>
          {%- continue -%}
        {%- endif -%}
        <div class="parent-category-col col-{{ section.settings.column_per_row }}">
          <img src="{{ block.settings.img | img_url: 'master' }}" alt="{{ block.settings.title }}">
          <h3>{{ block.settings.title }}</h3>
          <div class="repair-services-btn">
            <p>{{ block.settings.price }}</p>
            <a href="{{ block.settings.link }}">{{ block.settings.btn }}</a>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<style>
  .parent-categories-wrapper .hidden {
    display: none;
  }
  .show-more-btn {
    display: inline-block;
    margin-top: 20px;
    cursor: pointer;
  }
  .parent-categories-{{ section.id }}{ 
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    width: 100%;
    background-color: {{ section.settings.bg }};
  }
  .parent-categories-info{
    text-align: center;
    max-width: 625px;
    margin: 0 auto;
    padding-bottom: 40px;
  }
  .parent-categories-info h2{
    color: #1d1d1f;
    font-size: {{ section.settings.heading_size }}px;
    font-weight: 600;
    line-height: 45.67px;
    text-align: center;
    padding: 0;
    padding-bottom: 16px;
    margin: 0;
}
  .parent-categories-info p{
    color: #333;
font-size: 17px;
font-weight: 400;
line-height: 1.7;
letter-spacing: 0;
text-align: center;
max-width: 800px;
margin: 0 auto;
padding: 0;
  }
  .parent-category-row{
    display: flex;
    align-self: flex-start;
    justify-content: center;
    flex-wrap: wrap;
    row-gap: 40px;
  }
  .parent-category-col{
    flex: 32%;
    max-width: 32%;
    text-align: center;
  }
  .parent-category-col.col-1{
    flex: 100%;
    max-width: 100%;
  }
  .parent-category-col.col-2{
    flex: 49%;
    max-width: 49%;
  }
  .parent-category-col.col-3{
    flex: 32%;
    max-width: 32%;
  }
  .parent-category-col.col-4{
    flex: 24%;
    max-width: 24%;
  }
  .parent-category-col img{
    width: 100%;
    height: auto;
    display; block;
  }
  .parent-category-col h3{
    color: #1D1D1F;
font-size: 18px;
font-weight: 600;
line-height: 19px;
letter-spacing: 0.05em;
text-align: center;
margin: 0;
    padding: 15px 0px 5px 0px;
  }
  .repair-services-btn{
    text-align: center;
    max-width: 160px;
    margin: 0 auto;
  }
  .repair-services-btn a,
  .show-more-btn{
    width: 100%;
    text-align: center;
    border-radius: 24px;
    background-color: #1f1f1d;
    color: #fff;
    font-size: 14px;
    font-weight: 400;
    line-height: 25px;
    padding: 10px 0px;
    display: inline-block;
    text-decoration: none;
  }
  .show-more-btn{
    max-width: 150px;
    margin: 0 auto;
    margin-top: 40px;
    display: flex;
    justify-content: center;
    align-items: center;
    background: transparent;
    color: #000;
    border-radius: 2px;
    box-shadow: none;
    border: 2px solid #b6b6b6;
  }
  .parent-categories-wrapper .repair-services-btn{
    margin-top: 20px;
    display: flex;
    gap: 15px;
    justify-content: center;
    align-items: center;
    max-width: 90%;
  }
  .parent-categories-wrapper .repair-services-btn p{
    margin: 0;
    font-size: 14px;
    background: #f1f1f1;
    border-radius: 32px;
    padding: 10px 15px;
    width: 110px;
    min-height: 45px;
    line-height: 25px;
  }
  .parent-category-row--imageless{
    column-gap: 20px;
    row-gap: 20px;
    max-width: 1360px;
    margin: 0 auto;
  }
  .parent-category-row--imageless .parent-category-col{
    flex: 0 0 calc(33.333% - 14px);
    max-width: calc(33.333% - 14px);
  }
  .parent-category-row--imageless .parent-category-col.col-1{
    flex: 0 0 100%;
    max-width: 420px;
  }
  .parent-category-row--imageless .parent-category-col.col-2{
    flex: 0 0 calc(50% - 10px);
    max-width: calc(50% - 10px);
  }
  .parent-category-row--imageless .parent-category-col.col-4{
    flex: 0 0 calc(25% - 15px);
    max-width: calc(25% - 15px);
  }
  @media(max-width: 989px){
    .parent-category-row--imageless .parent-category-col,
    .parent-category-row--imageless .parent-category-col.col-4{
      flex: 0 0 calc(33.333% - 14px);
      max-width: calc(33.333% - 14px);
    }
  }
  @media(max-width: 767px){
    .parent-category-row--imageless{
      column-gap: 12px;
      row-gap: 12px;
    }
    .parent-category-row--imageless .parent-category-col,
    .parent-category-row--imageless .parent-category-col.col-1,
    .parent-category-row--imageless .parent-category-col.col-2,
    .parent-category-row--imageless .parent-category-col.col-3,
    .parent-category-row--imageless .parent-category-col.col-4{
      flex: 0 0 calc(50% - 6px);
      max-width: calc(50% - 6px);
      padding-bottom: 0;
    }
  }
  @media(max-width: 767px){
    .parent-categories-{{ section.id }}{
      padding-top: {{ section.settings.mob_padding_top }}px;
      padding-bottom: {{ section.settings.mob_padding_bottom }}px;
    }
   .parent-categories-info h2{
      font-size: 24px;
      font-weight: 600;
      line-height: 36px;
      text-align: center;
    }
     .parent-categories-info p{
      font-size: 14px;
      font-weight: 400;
      line-height: 20px;
      letter-spacing: 0.05em;
      text-align: center;
     }
    .parent-category-col{
      flex: 100%;
      max-width: 100%;
      text-align: center;
      padding-bottom: 20px;
    }
      .parent-category-col.col-1{
      flex: 100%;
      max-width: 100%;
    }
    .parent-category-col.col-2{
      flex: 100%;
      max-width: 100%;
    }
    .parent-category-col.col-3{
      flex: 100%;
      max-width: 100%;
    }
    .parent-category-col.col-4{
      flex: 100%;
      max-width: 100%;
    }
    .parent-categories-wrapper .repair-services-btn{
      flex-direction: column;
    }
  }
</style>

