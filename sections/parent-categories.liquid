  {
    "name": "Parent Categories",
    "settings": [
      {
        "type": "range",
        "id": "column_per_row",
        "min": 1,
        "max": 4,
        "step": 1,
        "label": "Column Per Row",
        "default": 3
      },
      {
         "type": "range",
         "id": "padding_top",
         "label": "Section Top Padding",
         "default": 0,
         "min": 0,
         "max": 100,
         "step": 5,
         "unit": "px"
       },
       {
         "type": "range",
         "id": "padding_bottom",
         "label": "Section Bottom Padding",
         "default": 0,
         "min": 0,
         "max": 100,
         "step": 5,
         "unit": "px"
       },
       {
         "type": "range",
         "id": "mob_padding_top",
         "label": "Mobile Section Top Padding",
         "default": 0,
         "min": 0,
         "max": 100,
         "step": 5,
         "unit": "px"
       },
       {
         "type": "range",
         "id": "mob_padding_bottom",
         "label": "Mobile Section Bottom Padding",
         "default": 0,
         "min": 0,
         "max": 100,
         "step": 5,
         "unit": "px"
       },
       {
         "type": "color",
         "id": "bg",
         "label": "Section BG Color",
         "default": "#fff"
       },
      {
  "type": "text",
  "id": "heading",
  "label": "Heading",
  "default": "MacBook Pro"
},
{
  "type": "range",
  "id": "heading_size",
  "label": "Heading Size",
  "min": 16,
  "max": 48,
  "step": 1,
  "unit": "px",
  "default": 28
},
{
  "type": "text",
  "id": "details",
  "label": "Details",
  "default": "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua..."
},
      {
        "type": "url",
        "id": "btn_link",
        "label": "Button Link"
      },
      {
        "type": "checkbox",
        "id": "auto_sort",
        "label": "Order tiles automatically",
        "info": "Imageless design only. Newest generation first; within a generation: standard, mini, Plus/Air, Pro, Pro Max, then budget models (e.g. 16e). Untick to use the block order.",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_stats",
        "label": "Show headline prices and repair count",
        "info": "Imageless design only. Screen and battery prices (or repair count and starting price) are read live from each tile's linked collection; diagnostics are excluded.",
        "default": true
      },
      {
        "type": "text",
        "id": "btn_text",
        "label": "Button Label",
        "default": "Read More"
      }
    ],
    "blocks" : [
  	  {
   		"type" : "category",
   		"name" : "Category",
   		"settings" : [
          {
            "type": "image_picker",
            "id": "img",
            "label": "Category Image",
            "info": "Optional. Only shown when Theme settings > Repair pages > Imageless repair design is off."
          },
          {
            "type": "text",
            "id": "title",
            "label": "Title",
            "default": "MacBook Pro 16"
          },
          {
