{%- liquid
  assign trustindex_widget_id = section.settings.trustindex_widget_id | strip
  if trustindex_widget_id == blank
    assign trustindex_widget_id = '47cc7ef8590e8871fa062160cf7'
  endif
-%}

<div class="google-reviews" id="google-reviews-{{ section.id }}">
  {%- if section.settings.heading != blank -%}
    <h2 class="google-reviews__heading">{{ section.settings.heading | escape }}</h2>
  {%- endif -%}
  <div class="google-reviews__widget">
    <script defer async src="https://cdn.trustindex.io/loader.js?{{ trustindex_widget_id | escape }}"></script>
  </div>
</div>

{% stylesheet %}
  .google-reviews {
    padding: 60px 20px;
    background: #ffffff;
  }

  .google-reviews__heading {
    margin: 0 auto 24px;
    max-width: 1400px;
    text-align: center;
    font-size: 28px;
    font-weight: 600;
    line-height: 1.2;
    color: #333333;
  }

  .google-reviews__widget {
    min-height: 420px;
    max-width: 1400px;
    margin: 0 auto;
  }

  @media screen and (min-width: 990px) {
    .google-reviews__widget {
      min-height: 320px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Google reviews",
  "class": "section-google-reviews",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Google reviews",
      "info": "Shown above the widget. Leave blank to let the Trustindex header stand alone. Do not put a rating or review count here."
    },
    {
      "type": "text",
      "id": "trustindex_widget_id",
      "label": "Trustindex widget ID",
      "default": "47cc7ef8590e8871fa062160cf7",
      "info": "The id after the question mark in the Trustindex loader URL."
    }
  ],
  "presets": [
    {
      "name": "Google reviews"
    }
  ]
}
{% endschema %}
