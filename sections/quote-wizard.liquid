  async function postQuoteWizardWebhook(payload) {
    var controller = new AbortController();
    var timeoutId = setTimeout(function() { controller.abort(); }, 30000);

    try {
      var res = await fetch('https://api.icorrect.co.uk/intake/contact-form', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        body: JSON.stringify(payload),
        signal: controller.signal
      });

      clearTimeout(timeoutId);

      var contentType = res.headers.get('content-type') || '';
      var data = null;
      if (contentType.indexOf('application/json') !== -1) {
        try { data = await res.json(); } catch (e) {}
      } else {
        try { await res.text(); } catch (e2) {}
      }

      if (!res.ok) {
        throw new Error((data && data.error) || 'Unable to submit right now. Please try again.');
      }
      if (data && data.success === false) {
        throw new Error(data.error || 'Unable to submit right now. Please try again.');
      }

      return data || { success: true };
    } catch (error) {
      clearTimeout(timeoutId);
      if (error && error.name === 'AbortError') {
        throw new Error('Request timed out. Please try again.');
      }
      throw error;
    }
  }

  /* [4.2] Inline validation */
  function wireContactForm(prefix, source) {
    var form = document.getElementById(prefix + 'Form');
    if (!form || form._wired) return;
    form._wired = true;
    var nIn = document.getElementById(prefix + 'N');
    var eIn = document.getElementById(prefix + 'E');
    var pIn = document.getElementById(prefix + 'P');
    var nErr = document.getElementById(prefix + 'NErr');
    var eErr = document.getElementById(prefix + 'EErr');
    var pErr = document.getElementById(prefix + 'PErr');
    var sub = form.querySelector('.qw-f-sub');

    function validate() {
      var valid = true;
      if (!nIn.value || nIn.value.trim().length < 2) { nErr.textContent = 'Please enter your name'; valid = false; } else { nErr.textContent = ''; }
      var ev = (eIn.value || '').trim();
      if (!ev || ev.indexOf('@') === -1 || ev.indexOf('.') === -1) { eErr.textContent = 'Please enter a valid email'; valid = false; } else { eErr.textContent = ''; }
      var digits = (pIn.value || '').replace(/\D/g, '');
      if (digits.length < 8) { pErr.textContent = 'Please enter a valid phone number'; valid = false; } else { pErr.textContent = ''; }
      sub.disabled = !valid;
      return valid;
    }
    nIn.addEventListener('input', validate);
    eIn.addEventListener('input', validate);
    pIn.addEventListener('input', validate);
    /* Pre-validate if pre-filled */
    if (nIn.value || eIn.value) validate();

    form.onsubmit = async function(e) {
      e.preventDefault();
      if (!validate()) return;
      sub.disabled = true; sub.textContent = 'Sending...';

      var userName = nIn.value.trim();
      var userEmail = eIn.value.trim();
      var userPhone = pIn.value.trim();
      var userMsg = (document.getElementById(prefix + 'M').value || '').trim();

      /* Build structured body: device context + customer message */
      var deviceParts = [];
      if (S.fault) deviceParts.push('Fault: ' + S.fault);
      if (S.issue && S.issue !== S.fault) deviceParts.push('Issue: ' + S.issue);
      var fullBody = deviceParts.length ? deviceParts.join('\n') : '';
      if (userMsg) fullBody += (fullBody ? '\n\n' : '') + 'Message:\n' + userMsg;

      try {
        /* Wrap in contact-form-interceptor shape so the intake service routes
           this as a consumer contact-form submission (sourceType: consumer).
           Without `source` + `contact: {...}`, the intake rejects with
           "Unsupported source." See POST-DEPLOY-INCIDENT-2026-04-17.md. */
        await postQuoteWizardWebhook({
          contact: {
            name: userName,
            email: userEmail,
            phone: userPhone,
            body: fullBody,
            device_type: DN[S.device] || S.device || '',
            device_model: S.model || '',
            fault_area: S.fault || ''
          },
          source: 'shopify-website',
          timestamp: new Date().toISOString(),
          page_url: window.location.href,
          referrer: document.referrer || null
        });
        form.style.display = 'none';
        var ok = document.getElementById(prefix + 'Ok');
        if (ok) { ok.hidden = false; ok.classList.add('show'); }
        _resolutionConverted = true;
        trackWizardSubmit(source + '_submit', {
          route: S.route || null,
          value: getWizardTotalValue(),
          currency: 'GBP'
        });
        trackWizardFormSubmit(source === 'contact' ? 'quote_wizard_contact' : 'quote_wizard_question', {
          form_context: source,
          route: S.route || null,
          value: getWizardTotalValue(),
          currency: 'GBP'
        });
        if (window.posthog) posthog.capture('wizard_conversion', buildWizardTrackPayload({ action: source + '_submit' }));
      } catch (error) {
        sub.disabled = false;
        sub.textContent = 'Send question';
        pErr.textContent = error.message || 'Something went wrong. Please try again.';
      }
    };
  }

