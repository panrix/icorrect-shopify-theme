          var spans = row.querySelectorAll('span');
          if (spans.length >= 2) {
            estimates.push({
              label: spans[0].textContent.trim(),
              value: spans[1].textContent.trim()
            });
          }
        });
 
        /* Read running total */
        var totalEl = document.getElementById('qwPriceTotal');
        var totalPrice = totalEl ? totalEl.textContent.trim() : gbp.format(basePrice);
 
        var payload = {
            source: 'quote-wizard-email-quote',
            name: name,
            email: email,
            deviceType: DN[S.device] || S.device,
            deviceModel: S.model || '',
            faultArea: S.fault || '',
            issue: S.issue || '',
            repairTitle: productTitle || '',
            route: route || 'repair',
            basePrice: basePrice,
            expressName: expressName || null,
            expressMeta: expressMeta || null,
            expressPrice: expressPrice,
            serviceName: serviceName,
            servicePrice: servicePrice,
            totalPrice: totalPrice,
            estimates: estimates.length > 0 ? JSON.stringify(estimates) : null,
            warranty: CFG.warrantyLabel || '2-year warranty',
            parts: 'Genuine Apple parts',
            productUrl: productHandle ? 'https://www.icorrect.co.uk/products/' + productHandle : null,
            deviceColor: (function(){ var cb = document.querySelector('#qwColorGrid .qw-color-btn.sel'); return cb ? cb.dataset.color : null; })(),
            url: window.location.href,
            timestamp: new Date().toISOString()
        };
 
        function showEmailSuccess() {
          var panel = document.getElementById('qwEmailPanel');
          panel.querySelector('.qw-eq-fields').style.display = 'none';
          sendBtn.style.display = 'none';
          document.getElementById('qwEqOk').style.display = 'flex';
          _resolutionConverted = true;
          trackWizardSubmit('email_quote', {
            route: route || null,
            value: getWizardTotalValue(),
            currency: 'GBP'
          });
          trackWizardFormSubmit('quote_wizard_email_quote', {
            form_context: 'email_quote',
            route: route || null,
            value: getWizardTotalValue(),
            currency: 'GBP'
          });
          if (window.posthog) posthog.capture('wizard_conversion', buildWizardTrackPayload({ action: 'email_quote' }));
        }
 
        postQuoteWizardWebhook(payload).then(function() {
          showEmailSuccess();
        }).catch(function() {
          sendBtn.disabled = false; sendBtn.textContent = 'Send quote';
          document.getElementById('qwEqErr').textContent = 'Something went wrong. Please try again.';
          document.getElementById('qwEqErr').style.display = 'block';
        });
      };
    };
  }

  /* =============================================
     [5.1] STICKY CTA ON MOBILE
     ============================================= */
  var _stickyObserver = null;
  function setupStickyCTA(price) {
    var sticky = document.getElementById('qw-sticky-cta');
    if (!sticky) return;
    sticky.innerHTML = '<span class="qw-sticky-price">' + price + '</span><button class="qw-sticky-book" onclick="document.getElementById(\'qwBookBtn\').click()">Book now</button>';

    var cta = document.querySelector('.qw-res-cta');
    if (!cta || !('IntersectionObserver' in window)) return;
    if (_stickyObserver) _stickyObserver.disconnect();
    _stickyObserver = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        sticky.classList.toggle('show', !entry.isIntersecting);
      });
    }, { threshold: 0 });
    _stickyObserver.observe(cta);
  }

  function destroyStickyCTA() {
    if (_stickyObserver) { _stickyObserver.disconnect(); _stickyObserver = null; }
    var sticky = document.getElementById('qw-sticky-cta');
    if (sticky) { sticky.classList.remove('show'); sticky.innerHTML = ''; }
  }

  /* =============================================
     RESET
     ============================================= */
  function reset() {
    S.device = null; S.model = null; S.modelGroup = null; S.fault = null; S.issue = null; S.step = 1; S.collectionHandle = null; S.route = null; S.repairType = null; _repairsMap = {};
    _collectionProducts = [];
    _trackedSteps = {};
    clearResolutionState();
    document.querySelectorAll('.qw-dev').forEach(function(c) { c.classList.remove('sel'); });
    var rP = document.getElementById('qw-rP');
    if (rP) { rP.style.display = 'none'; rP.innerHTML = ''; }
    destroyStickyCTA();
    go(1);
  }

  /* =============================================
     BACK BUTTONS
     ============================================= */
  var b2 = document.getElementById('qw-back2');
  if (b2) b2.onclick = function() {
    if (S.modelGroup && (MODELS[S.device] || []).length > 1) {
      renderModelGroups(S.device);
      return;
    }
    S.modelGroup = null;
    go(1);
  };
  var b3 = document.getElementById('qw-back3'); if (b3) b3.onclick = function() { go(2); };
  var b4 = document.getElementById('qw-back4'); if (b4) b4.onclick = function() { go(3); };

  /* =============================================
     PRE-FILL SYSTEM
     ============================================= */
  function findModelByCollection(handle) {
    var devices = ['macbook', 'iphone', 'ipad', 'watch'];
    for (var d = 0; d < devices.length; d++) {
      var groups = MODELS[devices[d]];
      if (!groups) continue;
      for (var g = 0; g < groups.length; g++) {
        for (var m = 0; m < groups[g].models.length; m++) {
          if (groups[g].models[m].collectionHandle === handle) return { device: devices[d], model: groups[g].models[m] };
        }
      }
    }
    return null;
  }

  function initPrefill() {
    var ctx = CONTEXT;
    _suppressScroll = true; /* Don't scroll during init - page should load from top */

    /* Section setting overrides */
    if (ctx && ctx.prefillDevice) ctx.device = ctx.device || ctx.prefillDevice;
    if (ctx && ctx.prefillFault) ctx.fault = ctx.fault || ctx.prefillFault;

    /* Collection handle → device/fault via data rules (#53 slice 3) */
    if (ctx && ctx.collectionHandle && window.ICorrectWizardPrefill && window.__QW_COLLECTION_PREFILL) {
      var cp = window.ICorrectWizardPrefill.resolveCollectionPrefill(ctx.collectionHandle, window.__QW_COLLECTION_PREFILL);
      if (cp.device && !ctx.device) ctx.device = cp.device;
      if (cp.fault && !ctx.fault) ctx.fault = cp.fault;
    }

    /* CASE 0: Product page — catalogue map reverse lookup lands on service step */
    if (ctx && ctx.productHandle && window.ICorrectWizardPrefill && window.__QW_CATALOGUE) {
      var hit = window.ICorrectWizardPrefill.resolveProductPrefill(window.__QW_CATALOGUE, {
        handle: ctx.productHandle,
        variantId: ctx.productVariantId
      });
      if (hit) {
        S.device = hit.device;
        S.preRepairType = hit.fault;
        S.preFault = REPAIR_TYPE_TO_FAULT[hit.fault] || hit.fault;
        S.preVariantId = hit.variantId || null;
        if (S.preFault === '_diagnostic') S.preFault = null;
        trackWizardEntry('product_catalogue', { productHandle: ctx.productHandle, fault: hit.fault });
        renderDevices();
        /* Prefer linklist model match; fall back to device+fault */
        var cols = ctx.modelCollections || [];
        var modelMatch = null;
        for (var ci = 0; ci < cols.length; ci++) {
          modelMatch = findModelByCollection(cols[ci]);
          if (modelMatch) break;
        }
        if (modelMatch) {
          pickModel(modelMatch.model.name, modelMatch.model.collectionHandle, null).then(function() {
            _suppressScroll = false;
          });
        } else {
          renderModels(hit.device);
          go(2);
          _suppressScroll = false;
        }
        return;
      }
    }

    /* CASE 1: Product page — pre-fill device + model, derive fault from handle */
    if (ctx && ctx.productHandle) {
      var cols = ctx.modelCollections || [];
      if (ctx.collectionHandle) cols.push(ctx.collectionHandle);
      var modelMatch = null;
      for (var ci = 0; ci < cols.length; ci++) {
        modelMatch = findModelByCollection(cols[ci]);
        if (modelMatch) break;
      }
      if (modelMatch) {
        /* Derive repair type from product handle */
        var rt = deriveRepairTypeFromHandle(ctx.productHandle);
        var faultName = rt ? REPAIR_TYPE_TO_FAULT[rt] : null;
        S.device = modelMatch.device;
        trackWizardEntry('product', {
          collectionHandle: modelMatch.model.collectionHandle,
          productHandle: ctx.productHandle
        });
        if (faultName && faultName !== '_diagnostic') S.preFault = faultName;
        renderDevices();
        pickModel(modelMatch.model.name, modelMatch.model.collectionHandle, null).then(function() {
          _suppressScroll = false;
        });
        return;
      }
      /* Product page but can't find model — try device at least */
      if (ctx.device) {
        S.device = ctx.device;
        trackWizardEntry('product', {
          productHandle: ctx.productHandle,
          deviceContextOnly: true
        });
        renderDevices();
        renderModels(ctx.device);
        go(2);
        _suppressScroll = false;
        return;
      }
    }

    /* CASE 2: Collection page — pre-fill device + model */
    if (ctx && ctx.collectionHandle) {
      var match = findModelByCollection(ctx.collectionHandle);
      if (match) {
        S.device = match.device;
        trackWizardEntry('collection', {
          collectionHandle: ctx.collectionHandle
        });
        renderDevices();
        pickModel(match.model.name, match.model.collectionHandle, null).then(function() {
          _suppressScroll = false;
        });
        return;
      }
    }

    /* CASE 3: Device context from metafield */
    if (ctx && ctx.device) {
      S.device = ctx.device;
      trackWizardEntry('device_context', {
        faultPrefill: ctx.fault || null
      });
      if (ctx.fault) S.preFault = ctx.fault;
      renderDevices();
      renderModels(ctx.device);
      go(2);
      _suppressScroll = false;
      return;
    }

    /* CASE 4: No context — start fresh */
    trackWizardEntry('fresh');
    renderDevices();
    go(1);
    _suppressScroll = false;
  }

  /* =============================================
     BROWSER BACK + [4.9] POSTHOG DROP-OFF
     ============================================= */
  window.addEventListener('popstate', function(e) {
    if (e.state && typeof e.state.step === 'number') {
      S.step = e.state.step;
      S.device = e.state.device || null;
      S.model = e.state.model || null;
      S.fault = e.state.fault || null;
      S.issue = null;
      S.route = null;
      S.repairType = null;
      clearTrackedStepsAfter(e.state.step);
      document.querySelectorAll('.qw-step').forEach(function(el) { el.classList.remove('on'); });
      var stepEl = document.getElementById('qw-s' + e.state.step);
      if (stepEl) stepEl.classList.add('on');
      updateProg(e.state.step);
      updateCrumb();
    }
  });

  window.addEventListener('beforeunload', function() {
    if (!window.posthog) return;
    if (_resolutionSeen && !_resolutionConverted) {
      posthog.capture('wizard_resolution_abandoned', buildWizardTrackPayload({
        step: S.step,
        duration: Date.now() - _stepStartTime
      }));
      return;
    }
    if (S.step > 1 && !S.issue) {
      posthog.capture('wizard_abandoned', buildWizardTrackPayload({
        step: S.step,
        duration: Date.now() - _stepStartTime
      }));
    }
  });

  /* =============================================
     INIT
     ============================================= */
  wireProgDots();
  function bootPrefill() {
    ensureCourierAssets().then(function() {
      initPrefill();
    }).catch(function() {
      initPrefill();
    });
  }
  if (window.ICorrectWizardPrefill && window.ICorrectCourierSlots && window.ICorrectCatalogue) {
    bootPrefill();
  } else if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', bootPrefill);
  } else {
    bootPrefill();
  }

})();
</script>

<!-- CSS -->
<style>
/* Residual bridges — visual system in assets/quote-wizard.css. Keep theme overrides at bay. */
.quote-wizard-section .qw-section {
  font-family: "Geist", Arial, sans-serif !important;
  font-size: 16px !important;
  text-align: left !important;
}
.quote-wizard-section .qw-section h1,
.quote-wizard-section .qw-section h2,
.quote-wizard-section .qw-section h3,
.quote-wizard-section .qw-title,
.quote-wizard-section .qw-s-title,
.quote-wizard-section .qw-step-title {
  font-family: "Geist", Arial, sans-serif !important;
  text-align: left !important;
}
.quote-wizard-section .qw-wrap--solo { max-width: 820px; margin-left: auto; margin-right: auto; }
.qw-slot-panel[hidden] { display: none !important; }
.qw-delivery-card { width: 100%; }
.qw-opt-disabled, .qw-card-disabled { opacity: 0.45; pointer-events: none; }
</style>

