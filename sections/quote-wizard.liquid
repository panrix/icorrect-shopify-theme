          posthog.capture('book_now_clicked', payload);
          posthog.capture('proceed_to_checkout_clicked', payload);
          posthog.capture('wizard_conversion', payload);
        }
        addToCartAndCheckout();
      };
    }
        wireEmailQuote(container, product.title, basePrice ? '\u00A3' + basePrice : '', 'repair', product.handle);
    /* Sticky CTA waits for postcode — refreshAllInTotal will unlock book button. */
    setPriceVisibility(false);
