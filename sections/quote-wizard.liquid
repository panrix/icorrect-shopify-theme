    <!-- RIGHT: WIZARD -->
    <div class="qw-wizard" aria-label="Repair quote wizard">
      {%- if section.settings.page_title and request.page_type == 'collection' and collection.title != blank -%}
        <h1 class="qw-page-title">{{ collection.title | escape }}</h1>
      {%- endif -%}
      <div class="qw-head">
        {% if request.page_type == 'page' and page.handle == 'contact' %}
          <h1 class="qw-title">Contact iCorrect London</h1>
        {% else %}
          {%- liquid
            assign qw_heading = section.settings.heading | default: 'Get a repair quote' | strip
            assign qw_heading_l = qw_heading | downcase
            assign qw_heading_generic = false
            if qw_heading == blank or qw_heading_l == 'get a repair quote' or qw_heading_l == 'get your free quote' or qw_heading_l == 'get a free quote' or qw_heading_l == 'get your repair quote'
              assign qw_heading_generic = true
            endif

            # Contextual heading from product/collection/page when heading is generic.
            # Product: "iPhone 14 Plus Screen Repair (Genuine OLED)" → "Get your iPhone 14 Plus Screen Repair quote"
            # Collection: "MacBook Screen Repair Prices" → "Get your MacBook Screen Repair quote"
            if qw_heading_generic
              assign qw_subject = ''
              if product and product.title != blank
                assign qw_subject = product.title | strip
              elsif collection and collection.title != blank
                assign qw_subject = collection.title | strip
              elsif request.page_type == 'page' and page and page.title != blank and page.handle != 'contact'
                assign qw_subject = page.title | strip
              endif

              if qw_subject != blank
                if qw_subject contains '('
                  assign qw_subject = qw_subject | split: '(' | first | strip
                endif
                if qw_subject contains 'Repair Prices'
                  assign qw_subject = qw_subject | replace: 'Repair Prices', 'Repair'
                elsif qw_subject contains 'Repair Pricing'
                  assign qw_subject = qw_subject | replace: 'Repair Pricing', 'Repair'
                elsif qw_subject contains 'Repair Price'
                  assign qw_subject = qw_subject | replace: 'Repair Price', 'Repair'
                elsif qw_subject contains ' Prices'
                  assign qw_subject = qw_subject | replace: ' Prices', ''
                elsif qw_subject contains ' Pricing'
                  assign qw_subject = qw_subject | replace: ' Pricing', ''
                elsif qw_subject contains ' Price'
                  assign qw_subject = qw_subject | replace: ' Price', ''
                endif
                if qw_subject contains ' Models'
                  assign qw_subject = qw_subject | replace: ' Models', ''
                elsif qw_subject contains ' Collections'
                  assign qw_subject = qw_subject | replace: ' Collections', ''
                elsif qw_subject contains ' Collection'
                  assign qw_subject = qw_subject | replace: ' Collection', ''
                endif
                assign qw_subject = qw_subject | strip
                assign qw_subject_l = qw_subject | downcase
                unless qw_subject_l contains 'repair' or qw_subject_l contains 'replacement' or qw_subject_l contains 'diagnostic'
                  assign qw_subject = qw_subject | append: ' repair'
                endunless
                assign qw_heading = 'Get your ' | append: qw_subject | append: ' quote'
              endif
            endif
          -%}
          <h2 class="qw-title">{{ qw_heading }}</h2>
        {% endif %}
        {%- liquid
          assign qw_noun = 'device'
          assign qw_device = section.settings.prefill_device | default: '' | downcase
          if collection and collection.metafields.custom.wizard_device != blank
            assign qw_device = collection.metafields.custom.wizard_device | downcase
          elsif product and product.metafields.custom.wizard_device != blank
            assign qw_device = product.metafields.custom.wizard_device | downcase
          endif
          assign qw_haystack = qw_device
          if collection
            assign qw_haystack = qw_haystack | append: ' ' | append: collection.handle | append: ' ' | append: collection.title
          endif
          if product
            assign qw_haystack = qw_haystack | append: ' ' | append: product.handle | append: ' ' | append: product.title
          endif
          if request.page_type == 'page' and page
            assign qw_haystack = qw_haystack | append: ' ' | append: page.handle | append: ' ' | append: page.title
          endif
          assign qw_haystack = qw_haystack | downcase
          if qw_device == 'iphone' or qw_haystack contains 'iphone'
            assign qw_noun = 'iPhone'
          elsif qw_device == 'macbook' or qw_haystack contains 'macbook'
            assign qw_noun = 'MacBook'
          elsif qw_device == 'ipad' or qw_haystack contains 'ipad'
            assign qw_noun = 'iPad'
          elsif qw_device == 'watch' or qw_haystack contains 'watch'
            assign qw_noun = 'Apple Watch'
          endif
          assign qw_sub = "We'll collect your " | append: qw_noun | append: ' same day in London, nationwide by courier.'
        -%}
        <p class="qw-sub">{{ qw_sub }}</p>
      </div>

      <!-- Step indicator -->
      <div class="qw-progress qw-prog" role="navigation" aria-label="Progress">
        <div class="qw-progress-top"><span class="qw-mono" id="qwProgMono">Step 1 of 4</span></div>
        <div class="qw-dots">
          <button type="button" class="qw-dot qw-prog-s current on" data-s="1"><span class="qw-dot-num qw-prog-dot">1</span><span class="qw-dot-label qw-prog-lbl">Device</span></button>
          <button type="button" class="qw-dot qw-prog-s" data-s="2" disabled><span class="qw-dot-num qw-prog-dot">2</span><span class="qw-dot-label qw-prog-lbl">Model</span></button>
          <button type="button" class="qw-dot qw-prog-s" data-s="3" disabled><span class="qw-dot-num qw-prog-dot">3</span><span class="qw-dot-label qw-prog-lbl">Fault</span></button>
          <button type="button" class="qw-dot qw-prog-s" data-s="4" disabled><span class="qw-dot-num qw-prog-dot">4</span><span class="qw-dot-label qw-prog-lbl">Service</span></button>
        </div>
      </div>

      <!-- [4.3] Breadcrumb -->
      <div class="qw-crumb" id="qw-crumb"></div>

      <!-- Step 1: Devices -->
      <div class="qw-step on" id="qw-s1">
        <h3 class="qw-step-title qw-s-title">What needs fixing?</h3>
        <p class="qw-step-sub qw-s-sub">Pick your device to get started.</p>
        <div class="qw-device-grid qw-dev-grid" id="qw-devGrid">
          <div class="qw-dev" data-dev="macbook" tabindex="0"><div class="qw-dev-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M2 17h20M8 21h8M12 17v4"/></svg></div><span class="qw-dev-lbl">MacBook</span></div>
          <div class="qw-dev" data-dev="iphone" tabindex="0"><div class="qw-dev-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="6" y="1" width="12" height="22" rx="2.5"/><path d="M10 19h4"/></svg></div><span class="qw-dev-lbl">iPhone</span></div>
          <div class="qw-dev" data-dev="ipad" tabindex="0"><div class="qw-dev-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="4" y="2" width="16" height="20" rx="2"/><path d="M10 18h4"/></svg></div><span class="qw-dev-lbl">iPad</span></div>
          <div class="qw-dev" data-dev="watch" tabindex="0"><div class="qw-dev-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="6" y="4" width="12" height="16" rx="6"/><path d="M9 1h6M9 23h6"/></svg></div><span class="qw-dev-lbl">Watch</span></div>
        </div>
      </div>

      <!-- Step 2: Models -->
      <div class="qw-step" id="qw-s2">
        <button class="qw-btn-back qw-back" id="qw-back2"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>Back</button>
        <h3 class="qw-step-title qw-s-title" id="qw-s2t"></h3>
        <p class="qw-step-sub qw-s-sub" id="qw-s2s">Pick your exact model for accurate pricing.</p>
        <div id="qw-mC"></div>
        <button class="qw-help-trig" id="qw-hT">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
          Not sure which model? We'll help you find it.
        </button>
        <div class="qw-help-panel" id="qw-hP"></div>
      </div>

      <!-- Step 3: Faults -->
      <div class="qw-step" id="qw-s3">
        <button class="qw-btn-back qw-back" id="qw-back3"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>Back</button>
        <h3 class="qw-step-title qw-s-title" id="qw-s3t"></h3>
        <p class="qw-step-sub qw-s-sub">Pick the category that fits best.</p>
        <div class="qw-fault-grid qw-f-grid" id="qw-fC"></div>
      </div>

      <!-- Step 4: Issues + Result -->
      <div class="qw-step" id="qw-s4">
        <button class="qw-btn-back qw-back" id="qw-back4"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>Back</button>
        <h3 class="qw-step-title qw-s-title" id="qw-s4t"></h3>
        <p class="qw-step-sub qw-s-sub" id="qw-s4s"></p>
        <div class="qw-issue-list qw-t-grid" id="qw-tC"></div>
        <div class="qw-resolution-panel" id="qw-rP" hidden></div>
      </div>
    </div>

  </div>
</div>

{%- if request.page_type == 'collection' and section.settings.show_repair_index != false -%}
  {% render 'repair-index', collection: collection %}
{%- endif -%}

{%- comment -%}
  Product pages with the imageless repair design render a slot under the
  product description; move the wizard there before its script initialises.
  Skipped in the theme editor so the section stays selectable.
{%- endcomment -%}
<script>
(function () {
  if (window.Shopify && window.Shopify.designMode) return;
  var slot = document.querySelector('[data-qw-slot]');
  var wizard = document.getElementById('get-free-quote');
  if (!slot || !wizard || slot.contains(wizard)) return;
  var host = wizard.closest('.shopify-section');
  slot.appendChild(wizard);
  if (host) host.classList.add('repair-wizard-moved');
})();
</script>

<!-- [5.1] Sticky CTA (injected by JS when needed) -->
<div class="qw-sticky-cta" id="qw-sticky-cta"></div>

<!-- JAVASCRIPT lives in assets/quote-wizard.js so this section stays under Shopify's 256 KB limit. -->
<script src="{{ 'quote-wizard.js' | asset_url }}" defer></script>

<!-- CSS -->
<style>
/* Residual bridges — visual system in assets/quote-wizard.css. Keep theme overrides at bay. */
.quote-wizard-section {
  background: #f4f4f5;
}
.quote-wizard-section .qw-section {
  font-family: "Geist", Arial, sans-serif !important;
  font-size: 16px !important;
  text-align: left !important;
  background: transparent; /* tint lives on the Shopify section shell */
}
.quote-wizard-section .qw-section h1,
.quote-wizard-section .qw-section h2,
.quote-wizard-section .qw-section h3,
.quote-wizard-section .qw-title,
.quote-wizard-section .qw-s-title,
.quote-wizard-section .qw-step-title {
  font-family: "Geist", Arial, sans-serif !important;
  text-align: left !important;
}
.quote-wizard-section .qw-wrap--solo { max-width: 820px; margin-left: auto; margin-right: auto; }
.qw-slot-panel[hidden] { display: none !important; }
.quote-wizard-section .qw-page-title {
  margin: 0 0 6px;
  font-size: 14px !important;
  line-height: 1.4;
  font-weight: 600;
  letter-spacing: 0;
  color: #6e6e73;
}
.qw-delivery-card { width: 100%; }
.qw-opt-disabled, .qw-card-disabled { opacity: 0.45; pointer-events: none; }
</style>

{% schema %}
{
  "name": "Quote Wizard",
  "tag": "section",
  "class": "quote-wizard-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "page_title",
      "label": "Show the collection title as the page H1",
      "default": false,
      "info": "Turn on for collection templates where the wizard is the first section and nothing else renders an H1. The wizard heading itself stays an H2."
    },
    {
      "type": "checkbox",
      "id": "show_repair_index",
      "label": "Show the repair price index under the wizard (collection pages)",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_map",
      "label": "Show map & contact details",
      "default": true
    },
    {
      "type": "html",
      "id": "map_html",
      "label": "Map embed HTML",
      "info": "Paste a Google Maps embed iframe. Leave blank for default iCorrect map."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Get a repair quote",
      "info": "Leave as “Get a repair quote” to auto-title from the product, collection, or page (e.g. “Get your iPhone 14 Plus Screen Repair quote”). Set a custom heading to override."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "We'll collect your device same day in London, nationwide by courier."
    },
    {
      "type": "text",
      "id": "warranty_label",
      "label": "Warranty badge label",
      "default": "2-year warranty"
    },
    {
      "type": "text",
      "id": "diagnostic_turnaround",
      "label": "Diagnostic turnaround label",
      "default": "Quote in 1 working day"
    },
    {
      "type": "text",
      "id": "hours_mon",
      "label": "Monday hours",
      "default": "9am - 6pm"
    },
    {
      "type": "text",
      "id": "hours_tue",
      "label": "Tuesday hours",
      "default": "9am - 6pm"
    },
    {
      "type": "text",
      "id": "hours_wed",
      "label": "Wednesday hours",
      "default": "9am - 6pm"
    },
    {
      "type": "text",
      "id": "hours_thu",
      "label": "Thursday hours",
      "default": "9am - 6pm"
    },
    {
      "type": "text",
      "id": "hours_fri",
      "label": "Friday hours",
      "default": "10am - 6pm"
    },
    {
      "type": "text",
      "id": "hours_sat",
      "label": "Saturday hours",
      "default": "Closed"
    },
    {
      "type": "text",
      "id": "hours_sun",
      "label": "Sunday hours",
      "default": "Closed"
    },
    {
      "type": "header",
      "content": "Prefill (slice 3)"
    },
    {
      "type": "select",
      "id": "prefill_mode",
      "label": "Prefill mode",
      "default": "auto",
      "options": [
        { "value": "auto", "label": "Auto from page context" },
        { "value": "manual", "label": "Manual device/fault below" }
      ]
    },
    {
      "type": "select",
      "id": "prefill_device",
      "label": "Prefill device",
      "default": "",
      "options": [
        { "value": "", "label": "— none —" },
        { "value": "macbook", "label": "MacBook" },
        { "value": "iphone", "label": "iPhone" },
        { "value": "ipad", "label": "iPad" },
        { "value": "watch", "label": "Apple Watch" }
      ]
    },
    {
      "type": "text",
      "id": "prefill_fault",
