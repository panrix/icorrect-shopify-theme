        <p class="qw-step-sub qw-s-sub">Pick the category that fits best.</p>
        <div class="qw-fault-grid qw-f-grid" id="qw-fC"></div>
      </div>

      <!-- Step 4: Issues + Result -->
      <div class="qw-step" id="qw-s4">
        <button class="qw-btn-back qw-back" id="qw-back4"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>Back</button>
