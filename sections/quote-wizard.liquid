    var DAYS = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
    var MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
    return DAYS[d.getDay()] + ' ' + d.getDate() + ' ' + MONTHS[d.getMonth()];
  }

  function londonWall(now) {
    var parts = new Intl.DateTimeFormat('en-GB', {
      timeZone: 'Europe/London',
      year: 'numeric',
      month: '2-digit',
      day: '2-digit',
      hour: '2-digit',
      minute: '2-digit',
      hourCycle: 'h23'
    }).formatToParts(now || new Date());
    var get = function (type) {
      for (var i = 0; i < parts.length; i++) {
        if (parts[i].type === type) return parts[i].value;
      }
      return '0';
    };
    return {
      date: new Date(parseInt(get('year'), 10), parseInt(get('month'), 10) - 1, parseInt(get('day'), 10)),
      hour: parseInt(get('hour'), 10) + parseInt(get('minute'), 10) / 60
    };
  }

  function packShipDate(now) {
    var lib = window.ICorrectRepairJourney;
    if (lib && typeof lib.packShipDate === 'function') return lib.packShipDate(now);
    var wall = londonWall(now);
    var d = startOfDay(wall.date);
    if (!isWorkingDay(d) || wall.hour >= PACK_CUTOFF_HOUR) {
      return addWorkingDays(d, 1);
    }
    return d;
  }

  function journeyStepHtml(num, title, meta) {
    return '<div class="qw-journey-step">' +
      '<div class="qw-journey-num" aria-hidden="true">' + num + '</div>' +
      '<div class="qw-journey-copy">' +
        '<div class="qw-journey-title">' + esc(title) + '</div>' +
        (meta ? '<div class="qw-journey-meta">' + esc(meta) + '</div>' : '') +
      '</div></div>';
  }

  function buildCourierJourneyModel() {
    var diagnostic = S.route === 'diagnostic';
    var collect = _collectionSlot.date && _collectionSlot.date.iso
      ? parseISODate(_collectionSlot.date.iso)
      : null;
    var lib = window.ICorrectRepairJourney;
    var model = diagnostic
      ? (lib ? lib.courierDiagnosticJourney(collect) : null)
      : (lib ? lib.courierRepairJourney(S.device, collect) : null);
    if (model) return formatJourneyModel(model);
    if (diagnostic) {
      return {
        kind: 'diagnostic',
        steps: [
          { title: 'We collect', meta: collect ? formatJourneyDate(collect) : 'Pick a collection window' },
          { title: 'We diagnose & email your quote', meta: collect ? formatJourneyDate(addWorkingDays(collect, 1)) : '1 working day after collection' },
          { title: 'You decide next', meta: 'Device stays with us until you approve' }
        ],
        returnDate: null,
        quoteDate: collect ? addWorkingDays(collect, 1) : null
      };
    }
    var bench = repairBenchDays(S.device);
    if (!collect) {
      return {
        kind: 'repair',
        steps: [
          { title: 'We collect', meta: 'Pick a collection window' },
          { title: 'We repair', meta: turnaroundClaimLabel(S.device) },
          { title: 'Back to you', meta: 'After repair' }
        ],
        returnDate: null,
        quoteDate: null
      };
    }
    var returnDate = addWorkingDays(collect, bench);
    return {
      kind: 'repair',
      steps: [
        { title: 'We collect', meta: formatJourneyDate(collect) },
        { title: 'We repair', meta: turnaroundClaimLabel(S.device) },
        { title: 'Back to you', meta: formatJourneyDate(returnDate) }
      ],
      returnDate: returnDate,
      quoteDate: null
    };
  }

  function formatJourneyModel(model) {
    function fmt(v) {
      if (!v) return v;
      if (v instanceof Date) return formatJourneyDate(v);
      return v;
    }
    return {
      kind: model.kind,
      steps: (model.steps || []).map(function(s) {
        return { title: s.title, meta: fmt(s.meta) };
      }),
      returnDate: model.returnDate || null,
      quoteDate: model.quoteDate || null
    };
  }

  function buildMailinJourneyModel() {
    var diagnostic = S.route === 'diagnostic';
    var lib = window.ICorrectRepairJourney;
    var model = diagnostic
      ? (lib ? lib.mailinDiagnosticJourney(new Date()) : null)
      : (lib ? lib.mailinRepairJourney(S.device, new Date()) : null);
    if (model) return formatJourneyModel(model);
    var bench = repairBenchDays(S.device, { diagnostic: diagnostic });
    var ship = packShipDate(new Date());
    var weReceive = addWorkingDays(ship, 1);
    var youPostBy = weReceive;
    if (diagnostic) {
      var quoteDate = addWorkingDays(weReceive, 1);
      return {
        kind: 'diagnostic',
        steps: [
          { title: 'We send packaging', meta: formatJourneyDate(ship) },
          { title: 'You post the device', meta: formatJourneyDate(youPostBy) },
          { title: 'We diagnose & email your quote', meta: formatJourneyDate(quoteDate) },
          { title: 'You decide next', meta: 'Device stays with us until you approve' }
        ],
        returnDate: null,
        quoteDate: quoteDate
      };
    }
    var repairDone = addWorkingDays(weReceive, bench);
    var returnDate = addWorkingDays(repairDone, 1);
    return {
      kind: 'repair',
      steps: [
        { title: 'We send packaging', meta: formatJourneyDate(ship) },
        { title: 'You post the device', meta: formatJourneyDate(youPostBy) },
        { title: 'We repair', meta: turnaroundClaimLabel(S.device) },
        { title: 'Back to you', meta: formatJourneyDate(returnDate) }
      ],
      returnDate: returnDate,
      quoteDate: null
    };
  }

  function renderServiceJourney(kind) {
    var host = document.getElementById('qwJourney');
    if (!host) return;
    var model = kind === 'mailin' ? buildMailinJourneyModel() : buildCourierJourneyModel();
    var stepsHtml = model.steps.map(function(s, i) {
      return journeyStepHtml(i + 1, s.title, s.meta);
    }).join('');
    var quoteDate = model.quoteDate;
    var diagnostic = model.kind === 'diagnostic' || S.route === 'diagnostic';
    var eta;
    if (diagnostic && quoteDate) {
      eta = '<div class="qw-journey-eta">' +
          '<span class="qw-journey-eta-label">We\'ll tell you what\'s wrong by</span>' +
          '<span class="qw-journey-eta-date">' + esc(formatJourneyDate(quoteDate)) + '</span>' +
          '<span class="qw-journey-eta-note">Device stays with us until you approve a repair</span>' +
        '</div>';
    } else if (diagnostic) {
      eta = '<div class="qw-journey-eta qw-journey-eta--pending"><span class="qw-journey-eta-note">Select a collection window to see when we diagnose and email your quote</span></div>';
    } else if (model.returnDate) {
      eta = '<div class="qw-journey-eta">' +
          '<span class="qw-journey-eta-label">Estimated return by</span>' +
          '<span class="qw-journey-eta-date">' + esc(formatJourneyDate(model.returnDate)) + '</span>' +
          '<span class="qw-journey-eta-note">Often sooner</span>' +
        '</div>';
    } else {
      eta = '<div class="qw-journey-eta qw-journey-eta--pending"><span class="qw-journey-eta-note">Select a collection window to see your return estimate</span></div>';
    }
    host.innerHTML =
      '<div class="qw-journey" data-kind="' + esc(kind) + '">' +
        '<div class="qw-journey-steps">' + stepsHtml + '</div>' +
        eta +
      '</div>';
    host.hidden = false;
  }

  function hideServiceJourney() {
    var host = document.getElementById('qwJourney');
    if (host) { host.hidden = true; host.innerHTML = ''; }
  }

  function refreshServiceJourney() {
    if (!_postcodeResolved) { hideServiceJourney(); return; }
    var kind = selectedServiceKind();
    if (kind === 'courier' && _courierQuote && _courierQuote.courierAvailable === false) {
      kind = 'mailin';
    }
    renderServiceJourney(kind === 'mailin' ? 'mailin' : 'courier');
