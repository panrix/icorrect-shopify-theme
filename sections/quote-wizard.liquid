        var keys = Object.keys(IPHONE_COLORS);
        for (var i = 0; i < keys.length; i++) {
          if (model.indexOf(keys[i]) !== -1 || keys[i].indexOf(model) !== -1) { colors = IPHONE_COLORS[keys[i]]; break; }
        }
      }
      return colors || null;
    }

    if (device === 'macbook') {
      var aMatches = model.match(/A\d{4}/g);
      if (aMatches) {
        for (var j = 0; j < aMatches.length; j++) {
          if (MACBOOK_COLORS[aMatches[j]]) return MACBOOK_COLORS[aMatches[j]];
        }
      }
      return null;
    }

    return null;
  }

