      ? ('<div class="qw-price-gate" id="qwPriceGate">Enter your postcode below to see your all-in price</div>' +
         '<div class="qw-price-big-wrap" id="qwPriceBigWrap" hidden>' +
           '<div class="qw-price-from">All-in total</div>' +
