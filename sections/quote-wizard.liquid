      <div class="qw-crumb" id="qw-crumb"></div>

      <!-- Step 1: Devices -->
      <div class="qw-step on" id="qw-s1">
        <h3 class="qw-step-title qw-s-title">What needs fixing?</h3>
        <p class="qw-step-sub qw-s-sub">Pick your device to get started.</p>
