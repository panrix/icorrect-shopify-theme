    if (band === 'B1' || band === 'B2') {
      return { headline: 'Central London', detail: 'Choose a collection window below.' };
    }
    if (band === 'B3' || band === 'B4') {
      return { headline: 'Greater London', detail: 'Choose a collection window below.' };
    }
    return { headline: 'Collection', detail: 'Choose a collection window below.' };
