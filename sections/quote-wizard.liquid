            '<button type="button" class="qw-date-more" id="qwDateMore" aria-label="Open calendar for more dates" title="More dates">' +
              '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9 5l7 7-7 7" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>' +
            '</button>' +
          '</div>' +
          '<div class="qw-window-strip" id="qwSlotParts" role="listbox" aria-label="Collection times"></div>' +
        '</div>' +
        '<div class="qw-cal-modal" id="qwCalModal" hidden>' +
          '<div class="qw-cal-backdrop" data-cal-close="1"></div>' +
          '<div class="qw-cal-sheet" role="dialog" aria-modal="true" aria-labelledby="qwCalTitle">' +
            '<div class="qw-cal-head">' +
              '<div class="qw-cal-title" id="qwCalTitle">Choose a date</div>' +
              '<button type="button" class="qw-cal-close" data-cal-close="1" aria-label="Close calendar">×</button>' +
            '</div>' +
            '<div class="qw-cal-grid" id="qwCalGrid"></div>' +
          '</div>' +
        '</div>' +
        '<div class="qw-mailin-panel" id="qwMailinPanel" hidden></div>' +
        '<div class="qw-journey-host" id="qwJourney" hidden></div>' +
      '</div>' +
      QW_PRICE_SLOT +
      '<div class="qw-courier-err" id="qwServiceErr"></div>' +
    '</div>';
  }

  function dateButtonHtml(d, active) {
    return '<button type="button" class="qw-date-btn' + (active ? ' active' : '') + '" data-iso="' + d.iso + '" role="option" aria-selected="' + (active ? 'true' : 'false') + '">' +
      '<span class="qw-date-dow">' + (d.headline || d.labelDow) + '</span>' +
      '<span class="qw-date-day">' + d.labelDay + '</span>' +
      '<span class="qw-date-mon">' + d.labelMon + '</span></button>';
  }

  function stripDatesAround(allDates, selectedIso, count) {
    if (!allDates || !allDates.length) return [];
    var n = Math.min(count || SLOT_STRIP_COUNT, allDates.length);
    var idx = 0;
    for (var i = 0; i < allDates.length; i++) {
      if (allDates[i].iso === selectedIso) { idx = i; break; }
    }
    var start = Math.max(0, Math.min(idx - Math.floor((n - 1) / 2), allDates.length - n));
    return allDates.slice(start, start + n);
  }

  function findSlotDate(iso) {
    for (var i = 0; i < _collectionSlotDates.length; i++) {
      if (_collectionSlotDates[i].iso === iso) return _collectionSlotDates[i];
    }
    return null;
  }

  function closeCollectionCalendar() {
    var modal = document.getElementById('qwCalModal');
    if (modal) modal.hidden = true;
  }

  function openCollectionCalendar() {
    var modal = document.getElementById('qwCalModal');
    var grid = document.getElementById('qwCalGrid');
    if (!modal || !grid || !_collectionSlotDates.length) return;
    var selectedIso = _collectionSlot.date && _collectionSlot.date.iso;
    grid.innerHTML = _collectionSlotDates.map(function(d) {
      var on = d.iso === selectedIso;
      return '<button type="button" class="qw-cal-day' + (on ? ' active' : '') + '" data-iso="' + d.iso + '">' +
        '<span class="qw-cal-dow">' + d.labelDow + '</span>' +
        '<span class="qw-cal-num">' + d.labelDay + '</span>' +
        '<span class="qw-cal-mon">' + d.labelMon + '</span></button>';
    }).join('');
    grid.querySelectorAll('.qw-cal-day').forEach(function(btn) {
      btn.addEventListener('click', function() {
        selectCollectionDate(btn.getAttribute('data-iso'));
        closeCollectionCalendar();
      });
    });
    modal.hidden = false;
  }

  function paintDateStrip() {
    var datesEl = document.getElementById('qwSlotDates');
    if (!datesEl || !_collectionSlotDates.length) return;
    var selectedIso = (_collectionSlot.date && _collectionSlot.date.iso) || _collectionSlotDates[0].iso;
    var strip = stripDatesAround(_collectionSlotDates, selectedIso, SLOT_STRIP_COUNT);
    datesEl.innerHTML = strip.map(function(d) {
      return dateButtonHtml(d, d.iso === selectedIso);
    }).join('');
    datesEl.querySelectorAll('.qw-date-btn').forEach(function(btn) {
      btn.addEventListener('click', function() {
        selectCollectionDate(btn.getAttribute('data-iso'));
      });
    });
  }

  function selectCollectionDate(iso) {
    var found = findSlotDate(iso);
    if (!found) return;
    _collectionSlot.date = found;
    paintDateStrip();
    syncIcorrectQuote();
    refreshServiceJourney();
    trackSlotSelected();
  }

  function renderCollectionSlots(band) {
    var panel = document.getElementById('qwSlotPanel');
    var datesEl = document.getElementById('qwSlotDates');
    var partsEl = document.getElementById('qwSlotParts');
    var moreBtn = document.getElementById('qwDateMore');
    var modal = document.getElementById('qwCalModal');
    if (!panel || !datesEl || !partsEl || !window.ICorrectCourierSlots) {
      if (panel) panel.hidden = true;
      return;
    }
    var listed = window.ICorrectCourierSlots.listCollectionDates(band, {
      count: SLOT_CALENDAR_COUNT,
      includeWeekends: false
    });
    _collectionSlotDates = listed.dates || [];
    if (!_collectionSlotDates.length) {
      panel.hidden = true;
      return;
    }

    var keepIso = _collectionSlot.date && _collectionSlot.date.iso;
    _collectionSlot.date = (keepIso && findSlotDate(keepIso)) || _collectionSlotDates[0];
    paintDateStrip();

    var parts = window.ICorrectCourierSlots.dayParts();
    var keepPart = _collectionSlot.part && _collectionSlot.part.id;
    var activePart = parts.filter(function(p) { return p.id === keepPart; })[0] || parts[0] || null;
    _collectionSlot.part = activePart;
    partsEl.innerHTML = parts.map(function(p) {
      var on = activePart && p.id === activePart.id;
      return '<button type="button" class="qw-window-btn' + (on ? ' active' : '') + '" data-part="' + p.id + '" role="option" aria-selected="' + (on ? 'true' : 'false') + '">' +
        '<span class="qw-window-label">' + p.label + '</span>' +
        '<span class="qw-window-detail">' + p.detail + '</span></button>';
    }).join('');
    partsEl.querySelectorAll('.qw-window-btn').forEach(function(btn) {
      btn.addEventListener('click', function() {
        partsEl.querySelectorAll('.qw-window-btn').forEach(function(b) {
          b.classList.remove('active');
          b.setAttribute('aria-selected', 'false');
        });
        btn.classList.add('active');
        btn.setAttribute('aria-selected', 'true');
        var id = btn.getAttribute('data-part');
        _collectionSlot.part = parts.filter(function(p) { return p.id === id; })[0] || null;
        syncIcorrectQuote();
        refreshServiceJourney();
        trackSlotSelected();
      });
    });

    if (moreBtn && !moreBtn._qwWired) {
      moreBtn._qwWired = true;
      moreBtn.addEventListener('click', openCollectionCalendar);
    }
    if (modal && !modal._qwWired) {
      modal._qwWired = true;
      modal.addEventListener('click', function(e) {
        var t = e.target;
        if (t && t.getAttribute && t.getAttribute('data-cal-close')) closeCollectionCalendar();
      });
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && modal && !modal.hidden) closeCollectionCalendar();
      });
    }

    panel.hidden = false;
    refreshServiceJourney();
    trackSlotSelected();
  }

  function applyCourierQuoteToUI(quote) {
    _courierQuote = quote;
    var reveal = document.getElementById('qwDeliveryReveal');
    var slotPanel = document.getElementById('qwSlotPanel');
    var mailPanel = document.getElementById('qwMailinPanel');
    var priceLbl = document.getElementById('qwCourierPriceLbl');
    var mailLbl = document.getElementById('qwMailinPriceLbl');
    var result = document.getElementById('qwCourierResult');
    var courierCard = document.querySelector('.qw-opt-card[data-svc="courier"]');
    var mailCard = document.querySelector('.qw-opt-card[data-svc="mailin"]');
    var pcCard = document.getElementById('qwPostcodeCard');
    var pcInput = document.getElementById('qwPostcode');
    var postcode = pcInput ? String(pcInput.value || '').trim() : '';

    if (!quote) {
      _postcodeResolved = false;
      _quoteShownCaptured = false;
      syncIcorrectQuote();
      if (reveal) reveal.hidden = true;
      if (slotPanel) { slotPanel.hidden = true; _collectionSlot = { date: null, part: null }; _collectionSlotDates = []; }
      if (mailPanel) mailPanel.hidden = true;
      if (result) { result.hidden = true; result.innerHTML = ''; }
      if (pcCard) pcCard.classList.remove('qw-postcode-card-resolved');
      if (priceLbl) priceLbl.textContent = '—';
      if (mailLbl) mailLbl.textContent = '—';
      if (courierCard) {
        courierCard.classList.remove('qw-opt-disabled');
        courierCard.removeAttribute('aria-disabled');
        courierCard.removeAttribute('aria-hidden');
        courierCard.hidden = false;
      }
      setMailInOptionVisible(true);
      setPriceVisibility(false);
      hideServiceJourney();
      closeCollectionCalendar();
      return;
    }

    _postcodeResolved = true;
    if (reveal) reveal.hidden = false;
    if (pcCard) pcCard.classList.add('qw-postcode-card-resolved');
    if (priceLbl) priceLbl.textContent = formatServiceCardHint(quote, 'courier');
    if (mailLbl) mailLbl.textContent = formatServiceCardHint(quote, 'mailin');

    if (courierCard) {
      courierCard.dataset.add = '0';
      if (quote.courierAvailable === false || quote.forcedMailIn) {
        courierCard.classList.add('qw-opt-disabled');
        courierCard.setAttribute('aria-disabled', 'true');
      } else {
        courierCard.classList.remove('qw-opt-disabled');
        courierCard.removeAttribute('aria-disabled');
        courierCard.removeAttribute('aria-hidden');
      }
    }

    var hideMail = shouldHideMailInOption(quote, postcode);
    setMailInOptionVisible(!hideMail);
    if (hideMail && quote.courierAvailable !== false && !quote.forcedMailIn) {
      /* Prefer courier when mail-in is pointless; re-quote if UI had mail-in selected. */
      if (quote.service !== 'courier') {
        var courierOnly = quoteForService('courier', postcode);
        if (courierOnly && courierOnly.service === 'courier') quote = courierOnly;
        _courierQuote = quote;
        if (priceLbl) priceLbl.textContent = formatServiceCardHint(quote, 'courier');
      }
    }

    if (quote.service === 'courier') {
      selectServiceCard('courier');
      /* No band badge — postcode already implies the area; jump straight to slots. */
      if (result) { result.hidden = true; result.innerHTML = ''; }
      if (mailPanel) mailPanel.hidden = true;
      renderCollectionSlots(quote.band);
      if (!_suppressScroll) focusCollectionPanel();
    } else if (quote.forcedMailIn || quote.service === 'mail-in') {
      selectServiceCard('mailin');
      setMailInOptionVisible(true);
      if (slotPanel) { slotPanel.hidden = true; _collectionSlot = { date: null, part: null }; _collectionSlotDates = []; }
      if (mailPanel) mailPanel.hidden = false;
      if (result) {
        result.hidden = false;
        if (quote.forcedMailIn) {
          result.innerHTML = '<div class="qw-courier-confirm qw-courier-confirm--compact">' +
            '<div class="qw-courier-confirm-title">Same Day Courier isn\'t available for your postcode.</div>' +
            '<div class="qw-courier-confirm-detail">We\'ve switched you to tracked mail-in.</div></div>';
        } else {
          result.innerHTML = '<div class="qw-courier-confirm qw-courier-confirm--compact">' +
            '<div class="qw-courier-confirm-title">Mail-in pack</div>' +
            '<div class="qw-courier-confirm-detail">Total below is the all-in price.</div></div>';
        }
      }
      refreshServiceJourney();
      if (!_suppressScroll) {
        var mailTarget = document.getElementById('qwMailinPanel') || document.getElementById('qwDeliveryReveal');
        scrollToEl(mailTarget, 140, isMobileQuoteLayout() ? 'start' : 'nearest');
      }
    }

    refreshAllInTotal();
    if (!_suppressScroll) focusPriceAndProceed();
    trackCourierQuoteEvents(_courierQuote);
  }

  function wireCourierService(container) {
    ensureCourierAssets().catch(function(){});
    _postcodeResolved = false;
    setPriceVisibility(false);
    var input = document.getElementById('qwPostcode');
    if (!input) return;

    function syncFromSelection() {
      var err = document.getElementById('qwServiceErr');
      if (err) err.textContent = '';
      var slotPanel = document.getElementById('qwSlotPanel');
      var mailPanel = document.getElementById('qwMailinPanel');
      var svc = selectedServiceKind();
      if (!_postcodeResolved) return;
      if (svc === 'courier') {
        if (mailPanel) mailPanel.hidden = true;
        if (_courierQuote && _courierQuote.service === 'courier') {
          renderCollectionSlots(_courierQuote.band);
        } else if (slotPanel) {
          slotPanel.hidden = true;
          hideServiceJourney();
        }
      } else {
        if (slotPanel) { slotPanel.hidden = true; _collectionSlot = { date: null, part: null }; }
        if (mailPanel) mailPanel.hidden = false;
        refreshServiceJourney();
      }
      runLookup();
    }

    container.querySelectorAll('.qw-opt-card[data-opt="svc"]').forEach(function(card) {
      card.addEventListener('click', function(){
        if (card.classList.contains('qw-opt-disabled')) return;
        container.querySelectorAll('.qw-opt-card[data-opt="svc"]').forEach(function(c) {
          c.classList.remove('sel', 'active');
        });
        card.classList.add('sel', 'active');
        setTimeout(syncFromSelection, 0);
      });
    });

    var timer = null;
    function runLookup() {
      var pc = String(input.value || '').trim();
      if (!pc) {
        applyCourierQuoteToUI(null);
        return;
      }
      /* Need a reasonably complete UK postcode before quoting */
      var compact = pc.replace(/\s+/g, '');
      if (compact.length < 5) {
        applyCourierQuoteToUI(null);
        return;
      }
      if (!window.ICorrectCourier || !window.__QW_BANDS) {
        ensureCourierAssets().then(runLookup); return;
      }
      var kind = selectedServiceKind();
      /* Always probe courier first so we can auto-route to mail-in when forced */
      var courierQuote = quoteForService('courier', pc);
      if (courierQuote && courierQuote.forcedMailIn) {
        applyCourierQuoteToUI(courierQuote);
        return;
      }
      var quote = quoteForService(kind, pc);
      applyCourierQuoteToUI(quote);
    }
    input.addEventListener('input', function(){ clearTimeout(timer); timer = setTimeout(runLookup, 220); });
    input.addEventListener('blur', runLookup);
    setTimeout(function(){ try { input.focus(); } catch (e) {} }, 120);
  }

  /* Turnaround cards: detected dynamically from the product page HTML.
     The product template renders .turn_arround_time-wrapper only if the
     turnaround metafield exists. We fetch the page, check for that marker,
     and parse the express price. Cached per handle. Zero maintenance. */
  var _expressCache = {};
  async function detectExpressFromPage(handle) {
    if (_expressCache[handle] !== undefined) return _expressCache[handle];
    try {
      var res = await fetch('/products/' + handle);
      if (!res.ok) { _expressCache[handle] = null; return null; }
      var html = await res.text();
      var marker = html.indexOf('turn_arround_time-wrapper');
      if (marker === -1) { _expressCache[handle] = null; return null; }
      var priceMatch = html.match(/id="one_day-btn"[^>]*data-price="([^"]+)"/);
      var price = priceMatch ? parseFloat(priceMatch[1]) : 0;
      var variantMatch = html.match(/id="one_day-btn"[^>]*value="(\d+)"/);
      var variantId = variantMatch ? parseInt(variantMatch[1], 10) : null;
      if (!price) {
        var fastSection = html.substring(marker, marker + 2000);
        var moneyMatch = fastSection.match(/\+[£](\d+(?:\.\d+)?)/);
        price = moneyMatch ? parseFloat(moneyMatch[1]) : 0;
      }
      if (!variantId) {
        var vidMatch = html.match(/name="turn_arround_time"[^>]*value="(\d+)"/);
        if (!vidMatch) vidMatch = html.match(/id="one_day-btn"[^>]*value="(\d+)"/);
        variantId = vidMatch ? parseInt(vidMatch[1], 10) : null;
      }
      var result = price ? { price: price, variantId: variantId } : null;
      _expressCache[handle] = result;
      return result;
    } catch(e) { _expressCache[handle] = null; return null; }
  }

  function buildTurnaroundCards(expressData) {
    if (!expressData || !expressData.price) return '';
    var standardMeta = turnaroundClaimLabel(S.device);
    var fastMeta = repairBenchDays(S.device) <= 1 ? 'Priority' : '1 working day';
    return '<div class="qw-opt-section">' +
      '<div class="qw-opt-label">Repair turnaround</div>' +
      '<div class="qw-opt-row">' +
        '<div class="qw-opt-card sel" data-opt="speed" data-add="0" data-vid="0" tabindex="0">' +
          '<div class="qw-opt-name">Standard</div>' +
          '<div class="qw-opt-meta">' + esc(standardMeta) + '</div>' +
          '<div class="qw-opt-price free">Included</div>' +
        '</div>' +
        '<div class="qw-opt-card" data-opt="speed" data-add="' + expressData.price + '" data-vid="' + (expressData.variantId || 0) + '" tabindex="0">' +
          '<div class="qw-opt-name">Fast</div>' +
          '<div class="qw-opt-meta">' + esc(fastMeta) + '</div>' +
          '<div class="qw-opt-price">+' + gbp.format(expressData.price) + '</div>' +
        '</div>' +
      '</div>' +
    '</div>';
  }

  /* =============================================
     NAVIGATION + BREADCRUMB + PROGRESS
     ============================================= */
  /* Hold the wizard chrome at the same viewport Y across step swaps so
     Device → Model → Fault doesn't jump when content height changes.
     Only pin when the chrome was already on-screen. Never yank the page
     down to the wizard (that hijacked homepage load when the module sits
     below the hero). */
  function pinWizardChrome(beforeTop) {
    if (_suppressScroll) return;
    if (typeof beforeTop !== 'number') return;
    var anchor = document.querySelector('.qw-prog') || document.querySelector('.qw-wizard');
    if (!anchor) return;
    var vh = window.innerHeight || document.documentElement.clientHeight || 0;
    /* Chrome started below the fold / off-page — leave scroll alone. */
    if (beforeTop > vh * 0.9 || beforeTop < -120) return;
    var rect = anchor.getBoundingClientRect();
    var delta = rect.top - beforeTop;
    if (Math.abs(delta) > 1) {
      try { window.scrollBy(0, delta); } catch (e) {}
    }
  }

  function go(n) {
    var anchor = document.querySelector('.qw-prog') || document.querySelector('.qw-wizard');
    var beforeTop = anchor ? anchor.getBoundingClientRect().top : null;
    if (n < S.step) clearTrackedStepsAfter(n);
    S.step = n;
    _stepStartTime = Date.now();
    history.pushState({ step: n, device: S.device, model: S.model, fault: S.fault }, '');
    document.querySelectorAll('.qw-step').forEach(function(el) { el.classList.remove('on'); });
    var stepEl = document.getElementById('qw-s' + n);
    if (stepEl) stepEl.classList.add('on');
    updateProg(n);
    updateCrumb();
    requestAnimationFrame(function() { pinWizardChrome(beforeTop); });
  }

  /* Issue → service/pricing is a full-screen transition (same feel as device → model). */
  function openResolutionScreen(title, sub) {
    var tC = document.getElementById('qw-tC');
    if (tC) tC.hidden = true;
    var rP = document.getElementById('qw-rP');
    if (rP) {
      rP.hidden = false;
      rP.removeAttribute('style');
    }
    var titleEl = document.getElementById('qw-s4t');
    if (titleEl && title) titleEl.textContent = title;
    var subEl = document.getElementById('qw-s4s');
    if (subEl && sub !== undefined) subEl.textContent = sub;
    updateProg(4);
    /* Don't scroll to progress pills — focusQuoteEntry runs after the card renders. */
  }

  function hideResolutionPanel() {
    var rP = document.getElementById('qw-rP');
    if (rP) {
      rP.hidden = true;
      rP.innerHTML = '';
      rP.removeAttribute('style');
    }
  }

  function resolutionScreenOpen() {
    var rP = document.getElementById('qw-rP');
    return !!(rP && !rP.hidden && rP.innerHTML);
  }

  function updateProg(step) {
    var mono = document.getElementById('qwProgMono');
    if (mono) mono.textContent = 'Step ' + step + ' of 4';
    document.querySelectorAll('.qw-prog-s').forEach(function(el) {
      var s = parseInt(el.dataset.s, 10);
      el.classList.remove('on', 'done', 'current');
      if (s < step) {
        el.classList.add('done');
        el.disabled = false;
        el.setAttribute('aria-current', 'false');
      } else if (s === step) {
        el.classList.add('on', 'current');
        el.disabled = false;
        el.setAttribute('aria-current', 'step');
      } else {
        el.disabled = true;
        el.setAttribute('aria-current', 'false');
      }
    });
  }

  /* [4.3] Breadcrumb */
  function updateCrumb() {
    var el = document.getElementById('qw-crumb');
    if (!el) return;
    var parts = [];
    if (S.device) parts.push({ label: DN[S.device] || S.device, step: 1 });
    if (S.model) parts.push({ label: S.model, step: 2 });
    if (S.fault && S.step >= 4) parts.push({ label: S.fault, step: 3 });
    if (parts.length === 0) { el.innerHTML = ''; return; }
    el.innerHTML = parts.map(function(p, i) {
      var sep = i > 0 ? '<span class="qw-crumb-sep">&rsaquo;</span>' : '';
      return sep + '<button class="qw-crumb-btn" data-go="' + p.step + '">' + esc(p.label) + '</button>';
    }).join('');
    el.querySelectorAll('.qw-crumb-btn').forEach(function(btn) {
      btn.onclick = function() { var t = parseInt(btn.dataset.go); if (t < S.step) go(t); };
    });
  }

  /* [4.4] Clickable progress dots */
  function wireProgDots() {
    document.querySelectorAll('.qw-prog-s').forEach(function(el) {
      el.style.cursor = 'pointer';
      el.onclick = function() {
        var target = parseInt(el.dataset.s);
        if (target < S.step) go(target);
      };
    });
  }

  /* =============================================
     STEP 1: DEVICES
     ============================================= */
  function renderDevices() {
    var g = document.getElementById('qw-devGrid');
    if (!g) return;
    var existing = g.querySelectorAll('.qw-dev[data-dev]');
    if (existing.length) {
      existing.forEach(function(c) {
        var id = c.getAttribute('data-dev');
        var lbl = c.querySelector('.qw-dev-lbl');
        wireA11y(c, 'Select ' + (lbl ? lbl.textContent : id));
        c.onclick = function() { pickDev(id, c); };
      });
      return;
    }
    g.innerHTML = '';
    DEVS.forEach(function(d) {
      var c = document.createElement('div');
      c.className = 'qw-dev';
      c.setAttribute('data-dev', d.id);
      c.innerHTML = '<div class="qw-dev-ico">' + d.icon + '</div><span class="qw-dev-lbl">' + d.label + '</span>';
      wireA11y(c, 'Select ' + d.label);
      c.onclick = function() { pickDev(d.id, c); };
      g.appendChild(c);
    });
  }

  function pickDev(id, el) {
    S.device = id; S.model = null; S.modelGroup = null; S.fault = null; S.issue = null; S.route = null; S.repairType = null;
    S.collectionHandle = null; _repairsMap = {};
    syncIcorrectQuote();
    clearTrackedStepsAfter(1);
    document.querySelectorAll('#qw-s1 .qw-dev').forEach(function(c) { c.classList.remove('sel'); });
    if (el) el.classList.add('sel');
    trackWizardStart({
      start_step: 'device',
      step_name: 'device',
      step_number: 1
    });
    trackWizardStepComplete('device', 1, {
      selected_device: id
    });
    trackWizardStep(2);
    setTimeout(function() { renderModels(id); go(2); }, 150);
  }

  /* =============================================
     STEP 2: MODELS (accordion + auto-expand)
     ============================================= */
  /* Sort models: newest year first, then highest M-chip first within same year */
  function sortModels(models) {
    return models.slice().sort(function(a, b) {
      var ya = parseInt((a.name.match(/\((\d{4})\)/) || [])[1]) || 0;
      var yb = parseInt((b.name.match(/\((\d{4})\)/) || [])[1]) || 0;
      if (yb !== ya) return yb - ya;
      /* Extract M-chip number: M4=4, M3=3, M2=2, M1=1, none=0 */
      var ma = parseInt((a.name.match(/M(\d)/i) || [])[1]) || 0;
      var mb = parseInt((b.name.match(/M(\d)/i) || [])[1]) || 0;
      if (mb !== ma) return mb - ma;
      /* Within same chip, Max > Pro > base */
      var ra = a.name.indexOf('Max') !== -1 ? 3 : a.name.indexOf('Pro') !== -1 ? 2 : 1;
      var rb = b.name.indexOf('Max') !== -1 ? 3 : b.name.indexOf('Pro') !== -1 ? 2 : 1;
      return rb - ra;
    });
  }

  /* Model step mirrors workshop-os walk-in intake:
     device → series/range screen → exact model (e.g. MacBook A2338). */
  function renderModels(dev) {
    S.modelGroup = null;
    renderModelGroups(dev);
  }

  function renderModelGroups(dev) {
    var c = document.getElementById('qw-mC');
    if (!c) return;
    c.innerHTML = '';
    var titleEl = document.getElementById('qw-s2t');
    if (titleEl) titleEl.textContent = 'Which ' + DN[dev] + ' is it?';
    var subEl = document.getElementById('qw-s2s') || document.querySelector('#qw-s2 .qw-s-sub');
    if (subEl) subEl.textContent = 'Choose the series first, then we’ll show the exact models.';
    var hP = document.getElementById('qw-hP');
    if (hP) { hP.classList.remove('open'); hP.innerHTML = ''; }
    var hT = document.getElementById('qw-hT');
    if (hT) hT.style.display = '';

    var groups = MODELS[dev];
    if (!groups || groups.length === 0) {
      c.innerHTML = '<div class="qw-empty"><p>We don\'t have pricing for this model yet. Get in touch for a quote.</p><a href="/pages/contact" class="qw-btn-book">Get in touch</a></div>';
      return;
    }

    /* Single series → skip straight to models (still one clear screen). */
    if (groups.length === 1) {
      pickModelGroup(dev, groups[0]);
      return;
    }

    var w = document.createElement('div'); w.className = 'qw-series-grid';
    groups.forEach(function(g) {
      var btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'qw-series-card';
      btn.innerHTML =
        '<span class="qw-series-name">' + esc(g.group) + '</span>' +
        '<span class="qw-series-count">' + g.models.length + ' model' + (g.models.length === 1 ? '' : 's') + '</span>' +
        '<svg class="qw-series-chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg>';
      wireA11y(btn, 'Select ' + g.group);
      btn.onclick = function() { pickModelGroup(dev, g); };
      w.appendChild(btn);
    });
    c.appendChild(w);
    renderHelper(dev);
  }

  function pickModelGroup(dev, group) {
    S.modelGroup = group.group;
    renderModelList(dev, group);
  }

  /* Leave a prefilled / selected model and return to the model selector. */
  function changeModelSelection() {
    S.model = null;
    S.collectionHandle = null;
    S.modelGroup = null;
    S.fault = null;
    S.issue = null;
    S.route = null;
    S.repairType = null;
    S.preFault = null;
    S.preRepairType = null;
    _repairsMap = {};
    syncIcorrectQuote();
    clearTrackedStepsAfter(1);
    if (!S.device) {
      go(1);
      return;
    }
    renderModelGroups(S.device);
    go(2);
  }

  function buildMacBookModelHint() {
    var url = CFG.macbookModelHintUrl;
    if (!url) return null;
    var wrap = document.createElement('div');
    wrap.className = 'qw-macbook-hint';
    wrap.innerHTML =
      '<div class="qw-macbook-hint-media">' +
        '<img src="' + esc(url) + '" alt="MacBook underside with model number near the hinge highlighted" width="640" height="360" loading="lazy">' +
      '</div>' +
      '<p class="qw-macbook-hint-caption">Turn the MacBook over. The model number starts with A and is printed near the hinge.</p>';
    return wrap;
  }

  function renderModelList(dev, group) {
    var c = document.getElementById('qw-mC');
    if (!c) return;
    c.innerHTML = '';
    var seriesLabel = group.group || DN[dev];
    var titleEl = document.getElementById('qw-s2t');
    if (titleEl) titleEl.textContent = 'Which model is it?';
    var subEl = document.getElementById('qw-s2s') || document.querySelector('#qw-s2 .qw-s-sub');
    if (subEl) {
      subEl.textContent = 'Choose the exact ' + (DN[dev] || '') + ' model from ' + seriesLabel + '.';
    }
    var hT = document.getElementById('qw-hT');
    if (hT) hT.style.display = 'none';
    var hP = document.getElementById('qw-hP');
    if (hP) { hP.classList.remove('open'); hP.innerHTML = ''; }

    if (dev === 'macbook') {
      var hint = buildMacBookModelHint();
      if (hint) c.appendChild(hint);
    }

    var list = document.createElement('div'); list.className = 'qw-m-list qw-m-list--flat';
    var sorted = sortModels(group.models || []);
    sorted.forEach(function(m) {
      var it = document.createElement('button');
      it.type = 'button';
      it.className = 'qw-m-item qw-choice-btn';
      it.innerHTML = '<span class="qw-mn">' + esc(m.name) + '</span>';
      wireA11y(it, 'Select ' + m.name);
      it.onclick = function() { pickModel(m.name, m.collectionHandle, it); };
      list.appendChild(it);
    });

    /* Wrong-model escape: go back to series/model picker (essential on PDP prefill). */
    if (sorted.length > 0) {
      var change = document.createElement('button');
      change.type = 'button';
      change.className = 'qw-m-item qw-choice-btn qw-m-item--change-model';
      change.innerHTML = '<span class="qw-mn">Choose a different model</span>';
      wireA11y(change, 'Choose a different model');
      change.onclick = function() { changeModelSelection(); };
      list.appendChild(change);
    }

    c.appendChild(list);
  }

  async function pickModel(name, handle, el) {
    S.model = name; S.collectionHandle = handle; S.fault = null; S.issue = null; S.route = null; S.repairType = null;
    syncIcorrectQuote();
    clearTrackedStepsAfter(2);
    /* [3.6] Auto-close helper */
    var hP = document.getElementById('qw-hP');
    if (hP) hP.classList.remove('open');
    document.querySelectorAll('.qw-m-item').forEach(function(c) { c.classList.remove('sel'); });
    if (el) el.classList.add('sel');

    var fGrid = document.querySelector('#qw-s3 .qw-f-grid');
    if (fGrid) fGrid.innerHTML = '<div class="qw-loading"><div class="qw-spinner"></div><p>Loading repairs for ' + esc(name) + '...</p></div>';

    await ensureCourierAssets().catch(function(){});
    var cat = window.ICorrectCatalogue;
    if (cat && window.__QW_CATALOGUE) {
      _repairsMap = cat.repairsMapForModel(window.__QW_CATALOGUE, S.device, name) || {};
      _collectionProducts = Object.keys(_repairsMap).map(function(k){ return _repairsMap[k]; });
    } else {
      _repairsMap = {};
      _collectionProducts = [];
    }
    /* Catalogue map is authoritative — no collection HTML scrape (#53). */
    trackWizardStart({
      start_step: 'model',
      step_name: 'model',
      step_number: 2
    });
    trackWizardStepComplete('model', 2, {
      collection_handle: handle
    });

    trackWizardStep(3);

    if (S.preFault) {
      var pf = S.preFault; S.preFault = null; S.fault = pf;
      syncIcorrectQuote();
      renderFaults(S.device);
      renderIssues(S.device, pf);
      trackWizardStep(4);
      go(4);
      /* Product pages stay sequential: fault → postcode → price.
         Only auto-advance when skip_to_service is explicitly on (rare deep-links). */
      if (CONTEXT.skipToService) {
        autoPickIssueForPrefill(pf);
      }
      return;
    }
    renderFaults(S.device);
    go(3);
    focusWizardStep(3);
  }


  function autoPickIssueForPrefill(faultKey) {
    var issues = getAvailableIssues(S.device, faultKey, _repairsMap);
    if (!issues || !issues.length) return;
    var wantType = S.preRepairType || null;
    S.preRepairType = null;
    var match = null;
    var i;
    if (wantType) {
      for (i = 0; i < issues.length; i++) {
        if (issues[i].repairType === wantType && issues[i].route === 'repair') { match = issues[i]; break; }
      }
    }
    if (!match) {
      for (i = 0; i < issues.length; i++) {
        if (issues[i].route === 'repair' && _repairsMap[issues[i].repairType]) { match = issues[i]; break; }
      }
    }
    if (!match) match = issues[0];
    if (match) pickIssue(match, null);
  }

  /* =============================================
     MODEL HELPERS
     ============================================= */
  function renderHelper(dev) {
    var hT = document.getElementById('qw-hT');
    var hP = document.getElementById('qw-hP');
    if (!hT || !hP) return;
    hT.style.display = '';
    hP.innerHTML = '';
    hT.onclick = function() { hP.classList.toggle('open'); };
    if (dev === 'iphone') renderIphoneVG(hP);
    else if (dev === 'macbook') renderMacbookHelper(hP);
    else renderGenericHelper(hP);
  }

  /* [3.1] iPhone VG with dead-end filtering */
  function renderIphoneVG(panel) {
    var vgS = {};
    var VK = { 1: 'cams', 2: 'edges', 3: 'screen', 4: 'size' };
    var CDN = 'https://cdn.shopify.com/s/files/1/0728/7111/7053/files/';

    function vgOpt(val, img, lbl) { return '<div class="qw-vg-opt" data-v="' + val + '"><img src="' + img + '" class="qw-vg-img"><div class="qw-vg-lbl">' + lbl + '</div></div>'; }
    var VG_PHONE_HEIGHTS = { max: 64, pro: 54, std: 46, mini: 38 };
    function vgSize(val, lbl, det) {
      var h = VG_PHONE_HEIGHTS[val] || 50;
      var w = Math.round(h * 0.48);
      var svg = '<svg viewBox="0 0 24 44" fill="none" stroke="var(--qw-text-2)" stroke-width="1.5" width="' + w + '" height="' + h + '" style="display:block;"><rect x="2" y="1" width="20" height="42" rx="4.5"/><line x1="9" y1="3.5" x2="15" y2="3.5" stroke-linecap="round" opacity="0.4"/><line x1="8" y1="39" x2="16" y2="39" stroke-linecap="round" opacity="0.3"/></svg>';
      return '<div class="qw-vg-opt" data-v="' + val + '"><div style="height:70px;display:flex;align-items:flex-end;justify-content:center;padding-bottom:2px;">' + svg + '</div><div class="qw-vg-lbl">' + lbl + '<br><span style="font-weight:400;color:var(--qw-text-3);font-size:11px;">' + det + '</span></div></div>';
    }

    var html = '<div class="qw-help-card"><div id="qwVgWiz">';
    html += '<div class="qw-vg-step on" data-vs="1"><div class="qw-vg-title">Rear cameras</div><div class="qw-vg-sub">What does the back look like?</div><div class="qw-vg-grid">';
    html += vgOpt('tri_plat',CDN+'17pm.png?v=1766083751','3 Cameras<br>(Plateau)');
    html += vgOpt('tri_std',CDN+'16pm.png?v=1766083961','3 Cameras<br>(Standard)');
    html += vgOpt('diag',CDN+'15.png?v=1766083751','2 Cameras<br>(Diagonal)');
    html += vgOpt('vert',CDN+'16.png?v=1766083751','2 Cameras<br>(Vertical)');
    html += vgOpt('single_plat',CDN+'air.png?v=1766083751','1 Camera<br>(Plateau)');
    html += vgOpt('single_std',CDN+'16e.png?v=1766083751','1 Camera<br>(Standard)');
    html += '</div></div>';
    html += '<div class="qw-vg-step" data-vs="2"><button class="qw-vg-back" data-from="2"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><path d="M19 12H5M12 19l-7-7 7-7"/></svg> Back</button><div class="qw-vg-title">Frame shape</div><div class="qw-vg-sub">Check the metal edge</div><div class="qw-vg-grid">';
    html += vgOpt('flat',CDN+'squared.png?v=1766085750','Flat (Square)');
    html += vgOpt('curved',CDN+'round.png?v=1766085749','Curved (Round)');
    html += '</div></div>';
    html += '<div class="qw-vg-step" data-vs="3"><button class="qw-vg-back" data-from="3"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><path d="M19 12H5M12 19l-7-7 7-7"/></svg> Back</button><div class="qw-vg-title">Screen type</div><div class="qw-vg-sub">Look at the top of the display</div><div class="qw-vg-grid">';
    html += vgOpt('island',CDN+'dynamic_island.png?v=1766085749','Dynamic Island');
    html += vgOpt('notch',CDN+'notch.png?v=1766085750','Notch');
    html += '</div></div>';
    html += '<div class="qw-vg-step" data-vs="4"><button class="qw-vg-back" data-from="4"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><path d="M19 12H5M12 19l-7-7 7-7"/></svg> Back</button><div class="qw-vg-title">Size</div><div class="qw-vg-sub">How big is it?</div><div class="qw-vg-grid">';
    html += vgSize('max','Pro Max / Plus','6.5" - 6.9"');
    html += vgSize('pro','Pro','5.8" - 6.3"');
    html += vgSize('std','Standard','4.7" - 6.1"');
    html += vgSize('mini','Mini','5.4"');
    html += '</div></div>';
    html += '<div class="qw-vg-step" data-vs="result"><div class="qw-vg-result" id="qwVgResult"></div></div>';
    html += '</div><button class="qw-help-close">Close</button></div>';
    panel.innerHTML = html;
    panel.querySelector('.qw-help-close').onclick = function() { panel.classList.remove('open'); };

    function vgGoTo(n) {
      panel.querySelectorAll('.qw-vg-step').forEach(function(s) { s.classList.remove('on'); });
      var target = panel.querySelector('.qw-vg-step[data-vs="' + n + '"]');
      if (target) target.classList.add('on');
      vgApplyFilters();
    }

    /* [3.1] Filter logic: hide options that produce zero matches */
    function vgApplyFilters() {
      for (var step = 1; step <= 4; step++) {
        var key = VK[step];
        var tempState = {};
        for (var s = 1; s < step; s++) { if (vgS[VK[s]]) tempState[VK[s]] = vgS[VK[s]]; }
        var allowed = {};
        VG_DB.forEach(function(m) {
          if (tempState.cams && m.cams !== tempState.cams) return;
          if (tempState.edges && m.edges !== tempState.edges) return;
          if (tempState.screen && m.screen !== tempState.screen) return;
          if (tempState.size && m.size !== tempState.size) return;
          allowed[m[key]] = true;
        });
        var stepEl = panel.querySelector('.qw-vg-step[data-vs="' + step + '"]');
        if (stepEl) {
          var visibleCount = 0;
          stepEl.querySelectorAll('.qw-vg-opt').forEach(function(opt) {
            if (allowed[opt.dataset.v]) { opt.style.display = ''; visibleCount++; }
            else { opt.style.display = 'none'; }
          });
          /* Auto-skip: if only one option visible and we're on this step, auto-select it */
        }
      }
    }

    panel.querySelectorAll('.qw-vg-back').forEach(function(btn) {
      btn.onclick = function() {
        var from = parseInt(btn.dataset.from);
        delete vgS[VK[from]];
        vgGoTo(from - 1);
      };
    });

    panel.querySelectorAll('.qw-vg-opt').forEach(function(o) {
      o.onclick = function() {
        if (o.style.display === 'none') return;
        var vs = parseInt(o.closest('.qw-vg-step').dataset.vs);
        vgS[VK[vs]] = o.dataset.v;
        if (vs === 1 && o.dataset.v === 'single_plat') { vgShowResult(); return; }
        if (vs === 1 && o.dataset.v === 'tri_plat') { vgS.edges = 'curved'; vgS.screen = 'island'; vgGoTo(4); return; }
        if (vs === 2 && vgS.cams === 'single_std' && o.dataset.v === 'flat') { vgS.screen = 'notch'; vgGoTo(4); return; }
        if (vs === 2 && vgS.cams === 'single_std' && o.dataset.v === 'curved') { vgS.screen = 'home'; vgGoTo(4); return; }
        if (vs >= 4) { vgShowResult(); return; }
        vgGoTo(vs + 1);
      };
    });

    function vgShowResult() {
      var matches = VG_DB.filter(function(m) {
        if (vgS.cams && m.cams !== vgS.cams) return false;
        if (vgS.edges && m.edges !== vgS.edges) return false;
        if (vgS.screen && m.screen !== vgS.screen) return false;
        if (vgS.size && m.size !== vgS.size) return false;
        return true;
      });
      var rc = document.getElementById('qwVgResult');
      if (!rc) return;
      if (matches.length === 1) {
        var m = matches[0];
        rc.innerHTML = '<img src="' + m.img + '" style="max-width:220px;max-height:170px;object-fit:contain;margin-bottom:14px;"><div class="qw-vg-result-name">' + m.n + '</div><button class="qw-vg-btn qw-vg-btn-p" id="qwVgSel">Select this model</button> <button class="qw-vg-btn qw-vg-btn-s" id="qwVgReset2">Try again</button>';
        document.getElementById('qwVgSel').onclick = function() { vgSelect(m.n); };
        document.getElementById('qwVgReset2').onclick = vgReset;
      } else if (matches.length > 1) {
        var h = '<div class="qw-vg-title" style="margin-bottom:14px;">Which one?</div><div class="qw-vg-grid">';
        matches.forEach(function(m) {
          h += '<div class="qw-vg-opt" data-vgname="' + esc(m.n) + '"><img src="' + m.img + '" style="max-width:140px;max-height:110px;object-fit:contain;"><div class="qw-vg-lbl">' + m.n + '</div></div>';
        });
        h += '</div><button class="qw-vg-btn qw-vg-btn-s" style="margin-top:14px;" id="qwVgReset3">Try again</button>';
        rc.innerHTML = h;
        rc.querySelectorAll('[data-vgname]').forEach(function(el) { el.onclick = function() { vgSelect(el.dataset.vgname); }; });
        document.getElementById('qwVgReset3').onclick = vgReset;
      } else {
        /* Should not happen with filtering, but just in case */
        rc.innerHTML = '<div class="qw-vg-title">Could not match your device</div><button class="qw-vg-btn qw-vg-btn-s" id="qwVgReset">Try again</button>';
        document.getElementById('qwVgReset').onclick = vgReset;
      }
      vgGoTo('result');
    }

    function vgReset() { for (var k in vgS) delete vgS[k]; vgGoTo(1); }

    /* [3.3] Robust name matching: exact first, then contains (longest wins) */
    function vgSelect(name) {
      var groups = MODELS[S.device] || [];
      /* Pass 1: exact */
      for (var g = 0; g < groups.length; g++) {
        for (var m = 0; m < groups[g].models.length; m++) {
          if (groups[g].models[m].name === name) { panel.classList.remove('open'); pickModel(groups[g].models[m].name, groups[g].models[m].collectionHandle, null); return; }
        }
      }
      /* Pass 2: contains (longest match) */
      var best = null, bestLen = 0;
      for (var g2 = 0; g2 < groups.length; g2++) {
        for (var m2 = 0; m2 < groups[g2].models.length; m2++) {
          var mn = groups[g2].models[m2].name;
          if (mn.indexOf(name) !== -1 || name.indexOf(mn) !== -1) {
            var matchLen = Math.min(mn.length, name.length);
            if (matchLen > bestLen) { best = groups[g2].models[m2]; bestLen = matchLen; }
          }
        }
      }
      if (best) { panel.classList.remove('open'); pickModel(best.name, best.collectionHandle, null); return; }
      /* [3.2] No fallback with broken state - show message */
      var rc2 = document.getElementById('qwVgResult');
      if (rc2) rc2.innerHTML = '<div class="qw-vg-title">Could not match to a model in our system</div><p style="font-size:13px;color:var(--qw-text-2);margin:8px 0;">Please pick your model from the list above instead.</p><button class="qw-vg-btn qw-vg-btn-s" id="qwVgResetFail">Close</button>';
      var rb = document.getElementById('qwVgResetFail');
      if (rb) rb.onclick = function() { panel.classList.remove('open'); };
    }

    vgApplyFilters();
  }

  /* [3.4] MacBook helper with reference image */
  function renderMacbookHelper(panel) {
    panel.innerHTML =
      '<div class="qw-help-card"><div class="qw-help-body qw-help-split">' +
      '<div class="qw-help-left"><img src="https://cdn.shopify.com/s/files/1/0728/7111/7053/files/MacBook_Model_Number_7104995a-bc9e-4b6d-9a9b-5578f42b4a7b.png?v=1773930835" alt="Where to find your MacBook model number" class="qw-help-img"></div>' +
      '<div class="qw-help-right">' +
      '<p class="qw-help-inst">Flip your MacBook over. The model number (e.g. <code>A1989</code>) is printed on the bottom case near the hinge.</p>' +
      '<div class="qw-help-row"><input class="qw-help-input" type="text" id="qwMbSearch" placeholder="Type model number, e.g. A1989"></div>' +
      '<div class="qw-help-results" id="qwMbRes"></div>' +
      '</div></div><button class="qw-help-close">Close</button></div>';
    panel.querySelector('.qw-help-close').onclick = function() { panel.classList.remove('open'); };

    function findConfiguredModelByName(name) {
      var exact = null;
      var best = null;
      var bestLen = 0;
      var groups = MODELS['macbook'] || [];
      for (var g = 0; g < groups.length; g++) {
        for (var m = 0; m < groups[g].models.length; m++) {
          var model = groups[g].models[m];
          if (model.name === name) return model;
          if (model.name.indexOf(name) !== -1 || name.indexOf(model.name) !== -1) {
            var matchLen = Math.min(model.name.length, name.length);
            if (matchLen > bestLen) {
              best = model;
              bestLen = matchLen;
            }
          }
        }
      }
      return exact || best;
    }

    var groups = MODELS['macbook'] || [];

    function mbFilter() {
      var q = (document.getElementById('qwMbSearch').value || '').trim().toUpperCase();
      var r = document.getElementById('qwMbRes');
      if (!r) return;
      r.innerHTML = '';
      if (!q) return;
      var f = MB_NUMS.filter(function(n) { return n.n.toUpperCase().indexOf(q) !== -1 || n.m.toUpperCase().indexOf(q) !== -1; });
      if (!f.length) { r.innerHTML = '<div style="padding:10px;font-size:13px;color:var(--qw-text-3);">No match. Check the number and try again.</div>'; return; }
      /* Deduplicate by model name to avoid showing A2338 twice with same target */
      var seen = {};
      f.forEach(function(n) {
        if (seen[n.m]) return;
        seen[n.m] = true;
        var d = document.createElement('div'); d.className = 'qw-help-hit';
        d.innerHTML = '<span class="qw-hn">' + n.n + '</span><span class="qw-hm">' + n.m + '</span><span class="qw-hs">Select</span>';
        d.onclick = function() {
          var model = findConfiguredModelByName(n.m);
          if (model) {
            panel.classList.remove('open');
            pickModel(model.name, model.collectionHandle, null);
          } else {
            r.innerHTML = '<div style="padding:10px;font-size:13px;color:var(--qw-text-3);">This model isn\'t configured in our system yet. Please pick from the list above.</div>';
          }
        };
        r.appendChild(d);
      });
    }
    document.getElementById('qwMbSearch').oninput = mbFilter;
  }

  function renderGenericHelper(panel) {
    panel.innerHTML = '<div class="qw-help-card"><div style="padding:20px;"><p class="qw-help-inst">Go to <code>Settings > General > About</code> on your device. The model number is listed there.</p></div><button class="qw-help-close">Close</button></div>';
    panel.querySelector('.qw-help-close').onclick = function() { panel.classList.remove('open'); };
