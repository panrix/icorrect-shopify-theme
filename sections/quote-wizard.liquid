      var tagList = Array.isArray(product.tags) ? product.tags.slice() :
        (typeof product.tags === 'string' ? product.tags.split(',').map(function(t){ return t.trim(); }) : []);
      if (product.courierTier) tagList.push('courier:' + product.courierTier);
