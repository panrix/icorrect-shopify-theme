        '<div class="qw-res-top">' +
          '<div class="qw-res-badge qw-badge-green"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>We can fix this</div>' +
          '<h3 class="qw-res-h">' + esc(product.title) + '</h3>' +
          '<p class="qw-res-p">' + esc(iss.copy) + '</p>' +
          (iss.refImages ? '<div class="qw-dustgate-imgs">' + iss.refImages.map(function(src,i){ return '<img src="' + src + '" alt="Reference image ' + (i+1) + '">'; }).join('') + '</div>' : '') +
          priceHtml +
        '</div>' +
        '<div class="qw-svc">' + badges + '</div>' +
        '<div style="padding:0 24px 8px;">' + colorHtml + turnaroundHtml + serviceHtml + '</div>' +
        totalHtml +
