    service:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>',
    diagnostic:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>'
  };
  var BADGE_LABELS = { warranty:'Warranty', turnaround:'Turnaround', express:'Express', parts:'Parts', service:'Service', diagnostic:'Diagnostic' };

  function svcBadge(k, v) {
    return '<div class="qw-svc-r"><div class="qw-svc-i">' + (BADGE_ICONS[k]||'') + '</div><span class="qw-svc-l">' + (BADGE_LABELS[k]||k) + '</span><span class="qw-svc-v">' + v + '</span></div>';
  }

  /* [2.2] Device-specific badge builders */
  function buildRepairBadges(device) {
    var h = svcBadge('warranty', CFG.warrantyLabel || '2-year warranty');
    var ta = { macbook: '2-3 working days', iphone: '2-4 hours', ipad: '2-3 working days', watch: '2-3 working days' };
    h += svcBadge('turnaround', ta[device] || '2-3 working days');
    h += svcBadge('parts', 'Genuine Apple parts');
    return h;
  }

  function buildDiagnosticBadges(device) {
    return svcBadge('turnaround', CFG.diagnosticTurnaround || '2 working days') +
      svcBadge('diagnostic', 'Full report and quote sent via email');
  }

  /* =============================================
     SERVICE STEP — courier OR mail-in only (#53)
     Postcode gates price; valid postcode auto-reveals band + slots.
     Walk-in / drop-off removed (Ricky 2026-09-11).
     ============================================= */
  var _courierQuote = null;
  var _postcodeResolved = false;
  var _collectionSlot = { date: null, part: null };

  function collectionWindowCopy(band) {
    if (band === 'B1' || band === 'B2') {
      return { headline: 'Central London', detail: 'Choose a collection window below.' };
    }
    if (band === 'B3' || band === 'B4') {
      return { headline: 'Greater London', detail: 'Choose a collection window below.' };
    }
    return { headline: 'Collection', detail: 'Choose a collection window below.' };
  }

  function ensureCourierAssets() {
    var jobs = [];
    if (!window.__QW_BANDS && CFG.bandsUrl) {
      jobs.push(fetch(CFG.bandsUrl).then(function(r){ return r.json(); }).then(function(j){ window.__QW_BANDS = j; }));
    }
    if (!window.__QW_CATALOGUE && CFG.catalogueUrl) {
      jobs.push(fetch(CFG.catalogueUrl).then(function(r){ return r.json(); }).then(function(j){ window.__QW_CATALOGUE = j; }));
    }
    if (!window.__QW_SERVICE_ADJUSTMENTS && CFG.serviceAdjustmentsUrl) {
      jobs.push(fetch(CFG.serviceAdjustmentsUrl).then(function(r){ return r.json(); }).then(function(j){
        window.__QW_SERVICE_ADJUSTMENTS = j;
        if (j && j.variants) CFG.serviceAdjustments = Object.assign({}, CFG.serviceAdjustments || {}, j.variants);
      }).catch(function(){ /* inline CFG IDs remain */ }));
    }
    if (!window.__QW_COLLECTION_PREFILL && CFG.collectionPrefillUrl) {
      jobs.push(fetch(CFG.collectionPrefillUrl).then(function(r){ return r.json(); }).then(function(j){ window.__QW_COLLECTION_PREFILL = j; }));
    }
    return Promise.all(jobs);
  }

  function currentRepairTags() {
    var card = document.getElementById('qwResCard');
    if (card && card.dataset.tags) {
      try { return JSON.parse(card.dataset.tags); } catch (e) {}
    }
    if (S.repairType && _repairsMap[S.repairType] && _repairsMap[S.repairType].tags) {
      var t = _repairsMap[S.repairType].tags;
      return Array.isArray(t) ? t : String(t).split(',').map(function(x){ return x.trim(); });
    }
    return [];
  }

  function currentRepairPrice() {
    var card = document.getElementById('qwResCard');
    if (card && card.dataset.base) {
      var n = parseFloat(card.dataset.base);
      if (!isNaN(n)) return n;
    }
    return 0;
  }

  function selectedServiceKind() {
    var card = document.querySelector('.qw-opt-card.sel[data-opt="svc"]');
    return card ? (card.getAttribute('data-svc') || 'courier') : 'courier';
  }

  function serviceVariantsAsset() {
    if (window.__QW_SERVICE_ADJUSTMENTS) return window.__QW_SERVICE_ADJUSTMENTS;
    return { variants: CFG.serviceAdjustments || {} };
  }

  function quoteForService(serviceKind, postcode) {
    if (!window.ICorrectCourier || !window.__QW_BANDS) return null;
    return window.ICorrectCourier.quoteServiceAdjustment({
      postcode: postcode || '',
      productTags: currentRepairTags(),
      bands: window.__QW_BANDS,
      service: serviceKind === 'mailin' ? 'mail-in' : 'courier',
      repairPrice: currentRepairPrice(),
      variants: serviceVariantsAsset()
    });
  }

  /* Status chips only — never a fee line. Before postcode: prompt to enter one. */
  function formatServiceCardHint(quote, kind) {
    if (!_postcodeResolved || !quote) return '—';
    if (kind === 'mailin') {
      return quote.tier === 'paid' ? 'Tracked pack' : 'Free pack';
    }
    if (!quote.courierAvailable && quote.forcedMailIn) return 'Not in area';
    if (quote.service === 'courier' && quote.adjustment === 0) return 'Included';
    if (quote.service === 'courier') return 'Available';
    return '—';
  }

  function setPriceVisibility(show) {
    var gate = document.getElementById('qwPriceGate');
    var total = document.getElementById('qwPriceTotalWrap');
    var big = document.getElementById('qwPriceBigWrap');
    if (gate) gate.hidden = !!show;
    if (total) total.hidden = !show;
    if (big) big.hidden = !show;
    var bookBtn = document.getElementById('qwBookBtn');
    if (bookBtn) {
      bookBtn.disabled = !show;
      bookBtn.classList.toggle('qw-btn-prompt', !show);
    }
  }

  function refreshAllInTotal() {
    var resCard = document.getElementById('qwResCard');
    if (!resCard) return;
    if (!_postcodeResolved) {
      setPriceVisibility(false);
      return;
    }
    var base = parseFloat(resCard.dataset.base || 0);
    var total = base;
    resCard.querySelectorAll('.qw-opt-card.sel').forEach(function(c) {
      if (c.getAttribute('data-opt') === 'svc') return;
      total += parseFloat(c.dataset.add || 0);
    });
    if (_courierQuote && _courierQuote.adjustment) {
      total += Number(_courierQuote.adjustment) || 0;
    }
    var totalEl = document.getElementById('qwPriceTotal');
    if (totalEl) totalEl.textContent = gbp.format(total);
    var bigEl = document.getElementById('qwPriceBig');
    if (bigEl) bigEl.textContent = gbp.format(total);
    setPriceVisibility(true);
  }

  function selectServiceCard(svc) {
    var grid = document.getElementById('qwDeliveryGrid');
    if (!grid) return;
    grid.querySelectorAll('.qw-opt-card[data-opt="svc"]').forEach(function(c) {
      var on = c.getAttribute('data-svc') === svc;
      c.classList.toggle('sel', on);
      c.classList.toggle('active', on);
    });
  }

  function buildServiceCards() {
    return '<div class="qw-opt-section qw-service-mapper">' +
