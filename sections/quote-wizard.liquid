<script>
window.WIZARD_CONTEXT = {
  pageType: "{{ template.name }}",
  collectionHandle: {{ collection.handle | default: '' | json }},
  productHandle: {{ product.handle | default: '' | json }},
  productVariantId: {% if product %}{{ product.selected_or_first_available_variant.id | json }}{% else %}null{% endif %},
  productPrice: {% if product %}{{ product.price | money_without_currency | replace: ',', '' | json }}{% else %}null{% endif %},
  productTags: {% if product %}{{ product.tags | json }}{% else %}[]{% endif %},
  prefillDevice: {{ section.settings.prefill_device | default: '' | json }},
  prefillFault: {{ section.settings.prefill_fault | default: '' | json }},
  prefillMode: {{ section.settings.prefill_mode | default: 'auto' | json }},
  skipToService: {{ section.settings.skip_to_service | default: false | json }},
  {%- if product -%}
    modelCollections: [
      {%- for col in product.collections -%}
        {%- if col.handle contains 'repair-prices' -%}
          {{ col.handle | json }},{%- endif -%}
      {%- endfor -%}
    ],
    device: {{ product.metafields.custom.wizard_device | default: section.settings.prefill_device | default: '' | json }},
    fault: {{ section.settings.prefill_fault | default: '' | json }}
  {%- elsif collection -%}
    device: {{ collection.metafields.custom.wizard_device | default: section.settings.prefill_device | default: '' | json }},
    fault: {{ collection.metafields.custom.wizard_fault | default: section.settings.prefill_fault | default: '' | json }}
  {%- else -%}
    device: {{ section.settings.prefill_device | default: '' | json }},
    fault: {{ section.settings.prefill_fault | default: '' | json }}
  {%- endif -%}
};
</script>

