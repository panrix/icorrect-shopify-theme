  function currentRepairTags() {
    var card = document.getElementById('qwResCard');
    if (card && card.dataset.tags) {
      try { return JSON.parse(card.dataset.tags); } catch (e) {}
    }
    if (S.repairType && _repairsMap[S.repairType] && _repairsMap[S.repairType].tags) {
      var t = _repairsMap[S.repairType].tags;
      return Array.isArray(t) ? t : String(t).split(',').map(function(x){ return x.trim(); });
    }
    return [];
  }

  function currentRepairPrice() {
    var card = document.getElementById('qwResCard');
    if (card && card.dataset.base) {
      var n = parseFloat(card.dataset.base);
      if (!isNaN(n)) return n;
    }
    return 0;
  }

  function selectedServiceKind() {
    var card = document.querySelector('.qw-opt-card.sel[data-opt="svc"]');
    return card ? (card.getAttribute('data-svc') || 'courier') : 'courier';
  }

  /* Quote-events beacon (#53) — outward half only, never a full postcode. */
  function outwardHalfOnly(value) {
    if (value == null || value === '') return null;
    var compact = String(value).toUpperCase().replace(/\s+/g, '');
    if (!compact) return null;
    if (compact.length >= 5 && /\d[A-Z]{2}$/.test(compact)) {
      return compact.slice(0, -3);
    }
    return compact;
  }

  function quoteNumber(n) {
    if (typeof n === 'number' && isFinite(n)) return n;
    var parsed = parseFloat(n);
    return isFinite(parsed) ? parsed : null;
  }

  function syncIcorrectQuote() {
    try {
      var q = window.__icorrectQuote || {};
      q.device = S.device || null;
      q.model = S.model || null;
      q.fault = S.fault || null;
      q.issue = S.issue || null;
      var quotedCard = document.getElementById('qwResCard');
      q.repair = (quotedCard && quotedCard.dataset.repair) || null;
      q.repair_handle = (quotedCard && quotedCard.dataset.repairHandle) || null;
      q.repair_type = (quotedCard && quotedCard.dataset.repairType) || S.repairType || null;
      q.route = (quotedCard && quotedCard.dataset.route) || S.route || null;

      var outward = (_courierQuote && _courierQuote.outward) || null;
      if (!outward) {
        var pcInput = document.getElementById('qwPostcode');
        var pc = pcInput ? String(pcInput.value || '').trim() : '';
        if (pc && window.ICorrectCourier && typeof window.ICorrectCourier.extractOutwardCode === 'function') {
          outward = window.ICorrectCourier.extractOutwardCode(pc);
        } else if (pc) {
          outward = pc;
        }
      }
      q.outward_code = outwardHalfOnly(outward);

      if (_courierQuote && _postcodeResolved) {
        q.band = _courierQuote.band || null;
        q.tier = _courierQuote.tier || null;
        q.repair_price = quoteNumber(_courierQuote.repair_price);
        if (q.repair_price == null) q.repair_price = quoteNumber(currentRepairPrice());
        q.adjustment = quoteNumber(_courierQuote.adjustment);
        q.total = quoteNumber(_courierQuote.total);
        var kind = selectedServiceKind();
        if (_courierQuote.forcedMailIn || _courierQuote.service === 'mail-in' || kind === 'mailin') {
          q.service_selected = 'mail-in';
        } else {
          q.service_selected = 'courier';
        }
        var resCard = document.getElementById('qwResCard');
        if (resCard) {
          var base = parseFloat(resCard.dataset.base || 0);
          var total = base;
          resCard.querySelectorAll('.qw-opt-card.sel').forEach(function(c) {
            if (c.getAttribute('data-opt') === 'svc') return;
            total += parseFloat(c.dataset.add || 0);
          });
          if (_courierQuote.adjustment) total += Number(_courierQuote.adjustment) || 0;
          if (isFinite(base)) q.repair_price = base;
          if (isFinite(total)) q.total = total;
        }
      } else {
        q.band = null;
        q.tier = null;
        q.repair_price = null;
        q.adjustment = null;
        q.total = null;
        q.service_selected = null;
      }

      if (q.service_selected === 'courier' && _collectionSlot.date && _collectionSlot.date.iso) {
        q.collection_date = _collectionSlot.date.iso;
        var slotProps = window.ICorrectCourierSlots
          ? window.ICorrectCourierSlots.slotCartProperties(_collectionSlot.date, _collectionSlot.part)
          : null;
        q.collection_window = slotProps ? slotProps['Collection Window'] : null;
        if (!q.collection_window && _collectionSlot.part) {
          q.collection_window = _collectionSlot.part.windowLabel || _collectionSlot.part.label || null;
        }
      } else {
        q.collection_date = null;
        q.collection_window = null;
      }

      window.__icorrectQuote = q;
    } catch (e) {}
  }

  function maybeFireQuoteShown() {
    try {
      syncIcorrectQuote();
      if (_quoteShownCaptured || !_postcodeResolved) return;
      var q = window.__icorrectQuote || {};
      if (typeof q.total !== 'number' && typeof q.repair_price !== 'number') return;
      _quoteShownCaptured = true;
      if (window.icorrectQuoteEvents && typeof window.icorrectQuoteEvents.captureQuoteShown === 'function') {
        window.icorrectQuoteEvents.captureQuoteShown();
      }
    } catch (e) {}
  }

  function fireQuoteProceeded() {
    try {
      syncIcorrectQuote();
      if (window.icorrectQuoteEvents && typeof window.icorrectQuoteEvents.captureQuoteProceeded === 'function') {
        window.icorrectQuoteEvents.captureQuoteProceeded();
      }
    } catch (e) {}
  }

  function fireQuoteEmailRequested(contact) {
    try {
      syncIcorrectQuote();
      if (window.icorrectQuoteEvents && typeof window.icorrectQuoteEvents.captureQuoteEmailRequested === 'function') {
        window.icorrectQuoteEvents.captureQuoteEmailRequested(contact);
      }
    } catch (e) {}
