  /* =============================================
     CART
     ============================================= */

  function buildCartItems() {
    var err = document.getElementById('qwServiceErr');
    if (err) err.textContent = '';
    var items = [];

    var resCard = document.getElementById('qwResCard');
    var mainVid = resCard ? parseInt(resCard.dataset.vid, 10) : null;
    if (!mainVid) return null;

    var needsColor = resCard.dataset.needsColor === '1';
    var selectedColor = '';
    if (needsColor) {
      var colorBtn = document.querySelector('#qwColorGrid .qw-color-btn.sel');
      if (!colorBtn) {
        if (err) err.textContent = 'Please select your device colour.';
        return null;
      }
      selectedColor = colorBtn.dataset.color || '';
    }

    var mainProps = {
      '_device': DN[S.device] || S.device,
      '_model': S.model || '',
      '_fault': S.fault || '',
      '_issue': S.issue || ''
    };
    if (selectedColor) mainProps['Device Color'] = selectedColor;
    items.push({ id: mainVid, quantity: 1, properties: mainProps });

    var speedCard = document.querySelector('.qw-opt-card.sel[data-opt="speed"]');
    if (speedCard) {
      var speedVid = parseInt(speedCard.dataset.vid || '0', 10);
      if (speedVid && speedVid > 0) {
        items.push({ id: speedVid, quantity: 1 });
      }
    }

    var svcCard = document.querySelector('.qw-opt-card.sel[data-opt="svc"]');
    var svcKind = svcCard ? (svcCard.getAttribute('data-svc') || 'courier') : 'courier';
    var errBox = document.getElementById('qwServiceErr') || err;

    if (svcKind === 'courier') {
      var postcodeInput = document.getElementById('qwPostcode');
      var postcode = postcodeInput ? String(postcodeInput.value || '').trim() : '';
      if (!postcode) {
        if (errBox) errBox.textContent = 'Enter your collection postcode.';
        return null;
      }
      if (!_courierQuote || _courierQuote.service !== 'courier') {
        if (errBox) errBox.textContent = 'Courier isn\'t available for that postcode — choose mail-in instead.';
        return null;
      }
      if (!_collectionSlot.date || !_collectionSlot.part) {
        if (errBox) errBox.textContent = 'Pick a collection date and window.';
        return null;
      }
      var slotProps = window.ICorrectCourierSlots
        ? window.ICorrectCourierSlots.slotCartProperties(_collectionSlot.date, _collectionSlot.part)
        : null;
      items[0].properties['Service Type'] = 'Courier collection';
      items[0].properties['Postcode'] = postcode.toUpperCase();
      items[0].properties['Band'] = _courierQuote.band || '';
      if (slotProps) {
        items[0].properties['Collection Date'] = slotProps['Collection Date'];
        items[0].properties['Collection Window'] = slotProps['Collection Window'];
      } else {
        var win = collectionWindowCopy(_courierQuote.band);
        items[0].properties['Collection Window'] = win.headline;
      }
    } else {
      items[0].properties['Service Type'] = 'Mail-in';
      var postcodeInputMi = document.getElementById('qwPostcode');
      var postcodeMi = postcodeInputMi ? String(postcodeInputMi.value || '').trim() : '';
      if (postcodeMi) items[0].properties['Postcode'] = postcodeMi.toUpperCase();
      if (_courierQuote && _courierQuote.band) items[0].properties['Band'] = _courierQuote.band;
      /* Do not add mail-in-service (Shopify £20). ≥£200 postage is already
         in the all-in quote (adjustment 0). Paid postage is the adjustment variant. */
    }

    /* Service adjustment variant — null-safe: missing ID already forced free mail-in in quote */
    if (_courierQuote && _courierQuote.adjustment > 0 && !(svcKind === 'mailin' && currentRepairPrice() >= 200)) {
      if (_courierQuote.variantMode === 'fallback-free-mail-in') {
        items[0].properties['Service Type'] = 'Mail-in';
        delete items[0].properties['Collection Window'];
      } else if (_courierQuote.variantId) {
        items.push({
          id: parseInt(_courierQuote.variantId, 10),
          quantity: 1,
          properties: {
            'Service Type': items[0].properties['Service Type'] || '',
            'Postcode': items[0].properties['Postcode'] || '',
            'Band': items[0].properties['Band'] || ''
          }
        });
      } else {
        console.warn('[quote-wizard] quoted adjustment £' + _courierQuote.adjustment + ' without variantId — not adding a £0 line');
      }
    }

    return items;
  }

  function getShopifyRoot() {
    return (window.Shopify && window.Shopify.routes ? window.Shopify.routes.root : '/');
  }

  async function ensureCleanWizardCart() {
    var root = getShopifyRoot();
    var cartRes = await fetch(root + 'cart.js', { headers: { 'Accept': 'application/json' } });
    if (!cartRes.ok) throw new Error('Could not check the current cart.');

    var cart = await cartRes.json();
    var items = cart && cart.items ? cart.items : [];
    if (!items.length) return true;

    var confirmed = window.confirm('Your cart already has items in it. Continuing with this repair booking will replace them. Do you want to continue?');
    if (!confirmed) {
      trackWizardEvent('wizard_cart_replace_cancelled', {
        cartItemCount: items.length
      });
      return false;
    }

    trackWizardEvent('wizard_cart_replace_confirmed', {
      cartItemCount: items.length
    });

    var clearRes = await fetch(root + 'cart/clear.js', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Accept': 'application/json'
      }
    });
    if (!clearRes.ok) throw new Error('Could not prepare a clean checkout. Please try again.');
    return true;
  }

  async function addToCartAndCheckout() {
    var items = buildCartItems();
    if (!items) {
      if (window.posthog) {
        var errEl = document.getElementById('qwWalkinErr');
        posthog.capture('book_now_validation_failed', buildWizardTrackPayload({
          reason: errEl && errEl.textContent ? errEl.textContent : 'unknown'
        }));
      }
      return;
    }

    trackWizardProceed();

    var btn = document.getElementById('qwBookBtn');
    if (btn) { btn.disabled = true; btn.textContent = 'Redirecting...'; }

    try {
      var shouldContinue = await ensureCleanWizardCart();
      if (!shouldContinue) {
        if (btn) { btn.disabled = false; btn.textContent = 'Proceed to checkout'; }
        return;
      }

      var addItems = items;
      try {
        if (window.icorrectQuoteEvents && typeof window.icorrectQuoteEvents.withPhCartAttribute === 'function') {
          addItems = window.icorrectQuoteEvents.withPhCartAttribute(items);
        }
      } catch (e) { addItems = items; }

      var addRes = await fetch(getShopifyRoot() + 'cart/add.js', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        body: JSON.stringify({ items: addItems })
      });

      if (!addRes.ok) {
        var errData = null;
        try { errData = await addRes.json(); } catch (e) {}
        throw new Error((errData && (errData.description || errData.message)) || 'Cart error');
      }

      await addRes.json();
      try {
        var phId = window.icorrectQuoteEvents && typeof window.icorrectQuoteEvents.phDistinctId === 'function'
          ? window.icorrectQuoteEvents.phDistinctId()
          : '';
        if (phId) {
          await fetch(getShopifyRoot() + 'cart/update.js', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Accept': 'application/json'
            },
            body: JSON.stringify({ attributes: { _ph_distinct_id: phId } })
          }).catch(function () {});
        }
      } catch (e) {}
      trackWizardSubmit('checkout', {
        route: S.route || null,
        value: getWizardTotalValue(),
        currency: 'GBP',
        item_count: items.length
      });
      trackWizardGA4('begin_checkout', {
        route: S.route || null,
        value: getWizardTotalValue(),
        currency: 'GBP',
        item_count: items.length
      });
      var checkoutUrl = '/checkout';
      if (window.posthog && posthog.get_distinct_id) {
        checkoutUrl += '?ph_distinct_id=' + encodeURIComponent(posthog.get_distinct_id());
      }
      window.location.href = checkoutUrl;
    } catch (err) {
      if (btn) { btn.disabled = false; btn.textContent = 'Proceed to checkout'; }
      alert(err.message || 'Something went wrong. Please try again.');
    }
  }

  /* =============================================
     RESOLUTION CARDS
     ============================================= */
  async function showResolution(iss, screenOpts) {
    var p = document.getElementById('qw-rP');
    if (!p) return;
    S.route = iss.route || null;
    S.repairType = iss.repairType || null;
    _resolutionSeen = true;
    _resolutionConverted = false;
    var title = (screenOpts && screenOpts.title) || 'Your repair quote';
    var sub = (screenOpts && screenOpts.sub);
    if (sub === undefined) {
      sub = iss.route === 'repair' || iss.route === 'diagnostic'
        ? 'Enter your postcode to see your all-in price and book collection.'
        : 'Next steps for your device.';
    }
    openResolutionScreen(title, sub);
    p.innerHTML = '<div class="qw-loading"><div class="qw-spinner"></div></div>';
    if (iss.route === 'repair') await showRepairCard(iss, p);
    else if (iss.route === 'diagnostic') await showDiagnosticCard(iss, p);
    else if (iss.route === 'dismiss') showDismissCard(iss, p);
    else showContactCard(iss, p);
    if (!_suppressScroll) focusQuoteEntry();
    if (window.posthog) posthog.capture('wizard_resolution', buildWizardTrackPayload({
      route: iss.route,
      resolutionLabel: iss.label
    }));
  }

  /* ---- REPAIR CARD ---- */
  async function showRepairCard(iss, container) {
    var product = resolveRepairProduct(iss.repairType, iss.label);
    if (!product) { showContactCard(iss, container); return; }

    /* Price + variant from catalogue map; optional fetch only for express upsell HTML. */
    var basePrice = product.variants && product.variants[0] ? parseFloat(product.variants[0].price) : 0;
    var mainVariantId = product.variants && product.variants[0] ? product.variants[0].id : 0;
    var fullProduct = null;
    if (!basePrice || !mainVariantId) {
      fullProduct = await fetchProduct(product.handle);
      basePrice = fullProduct ? parseFloat(fullProduct.variants[0].price) : 0;
      mainVariantId = fullProduct ? fullProduct.variants[0].id : 0;
    }

    var urgentHtml = iss.urgent ? '<div class="qw-urgent" role="alert"><span>\u26A0\uFE0F Safety concern: stop using the device and don\'t charge it.</span></div>' : '';

    /* Postcode first; price trust sits after collection so mobile can see slots + ETA + price together. */
    var expressData = await detectExpressFromPage(product.handle);
    var turnaroundHtml = buildTurnaroundCards(expressData);
    var deviceColors = getDeviceColors(S.device, S.model, iss.repairType);
    var colorHtml = buildColorSelector(deviceColors);

    var priceTrustHtml = basePrice
      ? buildPriceTrustBlock(S.device, S.model, { gate: true, priceHtml: gbp.format(basePrice) })
      : '';
    var totalHtml = basePrice
      ? ('<div class="qw-price-total-wrap" id="qwPriceTotalWrap" hidden>' +
           '<div class="qw-price-total"><span class="qw-price-total-label">Total</span>' +
           '<span class="qw-price-total-val" id="qwPriceTotal">' + gbp.format(basePrice) + '</span></div>' +
         '</div>')
      : '';
    var serviceHtml = injectServicePrice(buildServiceCards(), priceTrustHtml + totalHtml);

    container.innerHTML = urgentHtml +
      '<div class="qw-res" id="qwResCard" data-base="' + basePrice + '" data-vid="' + mainVariantId + '" data-needs-color="' + (deviceColors ? '1' : '0') + '">' +
        '<div class="qw-res-top">' +
          '<div class="qw-res-badge qw-badge-green"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>We can fix this</div>' +
          '<h3 class="qw-res-h">' + esc(product.title) + '</h3>' +
          '<p class="qw-res-p">' + esc(iss.copy) + '</p>' +
          (iss.refImages ? '<div class="qw-dustgate-imgs">' + iss.refImages.map(function(src,i){ return '<img src="' + src + '" alt="Reference image ' + (i+1) + '">'; }).join('') + '</div>' : '') +
        '</div>' +
        '<div class="qw-res-service" style="padding:0 24px 8px;">' + serviceHtml + '</div>' +
        '<div class="qw-res-extras" style="padding:0 24px 8px;">' + colorHtml + turnaroundHtml + '</div>' +
        '<div class="qw-res-cta">' +
          '<button class="qw-btn-book" id="qwBookBtn" disabled>Proceed to checkout <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg></button>' +
          '<button class="qw-btn-email" id="qwEmailQuote"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><path d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"/></svg>Email me this quote</button>' +
          '<button class="qw-btn-q" id="qwToggleCF"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><path d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>I have a question first</button>' +
        '</div>' +
        buildContactAccordion() +
      '</div>' +
      '<button class="qw-restart" id="qwRestart"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>Start over</button>';

    wireOptCards(container);
    wireColorSelector(container);
    (function stampRepairTags(){
      var resEl = document.getElementById('qwResCard');
