        if (!name || name.length < 2) {
          document.getElementById('qwEqErr').textContent = 'Please enter your name.';
          var errEl = document.getElementById('qwEqErr'); if (errEl) { errEl.hidden = false; errEl.style.display = 'block'; }
          return;
        }
        var email = document.getElementById('qwEqEmail').value.trim();
        if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
          document.getElementById('qwEqErr').textContent = 'Please enter a valid email address.';
          var errEl = document.getElementById('qwEqErr'); if (errEl) { errEl.hidden = false; errEl.style.display = 'block'; }
          return;
        }

var errHide = document.getElementById('qwEqErr'); if (errHide) { errHide.hidden = true; errHide.style.display = 'none'; }
        var sendBtn = document.getElementById('qwEqSend');
        sendBtn.disabled = true;
        sendBtn.textContent = 'Sending…';
 
        /* Read base price from resolution card */
        var resCard = document.getElementById('qwResCard');
        var basePrice = resCard ? parseFloat(resCard.dataset.base || 0) : 0;
 
        /* Read express turnaround add-on */
        var speedCard = document.querySelector('.qw-opt-card.sel[data-opt="speed"]');
        var expressName = '';
        var expressMeta = '';
        var expressPrice = 0;
        if (speedCard && parseFloat(speedCard.dataset.add || 0) > 0) {
          var sn = speedCard.querySelector('.qw-opt-name');
          var sm = speedCard.querySelector('.qw-opt-meta');
          expressName = sn ? sn.textContent.trim() : '';
          expressMeta = sm ? sm.textContent.trim() : '';
          expressPrice = parseFloat(speedCard.dataset.add);
        }
 
        /* Read service type and price */
        var svcCard = document.querySelector('.qw-opt-card.sel[data-opt="svc"]');
        var serviceName = 'Courier collection';
        var servicePrice = 0;
        if (svcCard) {
          var svn = svcCard.querySelector('.qw-opt-name');
          serviceName = svn ? svn.textContent.trim() : 'Courier collection';
          servicePrice = parseFloat(svcCard.dataset.add || 0);
        }
 
        /* Read diagnostic estimate rows */
        var estimates = [];
        document.querySelectorAll('.qw-estimate-row').forEach(function(row) {
          var spans = row.querySelectorAll('span');
          if (spans.length >= 2) {
            estimates.push({
              label: spans[0].textContent.trim(),
              value: spans[1].textContent.trim()
            });
          }
        });
 
        /* Read running total */
        var totalEl = document.getElementById('qwPriceTotal');
        var totalPrice = totalEl ? totalEl.textContent.trim() : gbp.format(basePrice);
 
        var payload = {
            source: 'quote-wizard-email-quote',
            name: name,
            email: email,
            deviceType: DN[S.device] || S.device,
            deviceModel: S.model || '',
            faultArea: S.fault || '',
            issue: S.issue || '',
            repairTitle: productTitle || '',
            route: route || 'repair',
            basePrice: basePrice,
            expressName: expressName || null,
            expressMeta: expressMeta || null,
            expressPrice: expressPrice,
            serviceName: serviceName,
            servicePrice: servicePrice,
            totalPrice: totalPrice,
            estimates: estimates.length > 0 ? JSON.stringify(estimates) : null,
            warranty: CFG.warrantyLabel || '2-year warranty',
            parts: partsClaimLabel(S.device, S.model),
            productUrl: productHandle ? 'https://www.icorrect.co.uk/products/' + productHandle : null,
            deviceColor: (function(){ var cb = document.querySelector('#qwColorGrid .qw-color-btn.sel'); return cb ? cb.dataset.color : null; })(),
            url: window.location.href,
            timestamp: new Date().toISOString()
        };
 
        function showEmailSuccess() {
          var panel = document.getElementById('qwEmailPanel');
          panel.querySelector('.qw-eq-fields').style.display = 'none';
          sendBtn.style.display = 'none';
          var okEl = document.getElementById('qwEqOk'); if (okEl) { okEl.hidden = false; okEl.style.display = 'flex'; }
          _resolutionConverted = true;
          trackWizardSubmit('email_quote', {
            route: route || null,
            value: getWizardTotalValue(),
            currency: 'GBP'
          });
          trackWizardFormSubmit('quote_wizard_email_quote', {
            form_context: 'email_quote',
            route: route || null,
            value: getWizardTotalValue(),
            currency: 'GBP'
          });
          if (window.posthog) posthog.capture('wizard_conversion', buildWizardTrackPayload({ action: 'email_quote' }));
        }
 
        postQuoteWizardWebhook(payload).then(function() {
          showEmailSuccess();
          try {
            if (typeof fireQuoteEmailRequested === 'function') {
              fireQuoteEmailRequested({
                contact_name: name,
                contact_email: email
              });
            }
          } catch (e) {}
        }).catch(function() {
          sendBtn.disabled = false; sendBtn.textContent = 'Send quote';
          document.getElementById('qwEqErr').textContent = 'Something went wrong. Please try again.';
          var errEl = document.getElementById('qwEqErr'); if (errEl) { errEl.hidden = false; errEl.style.display = 'block'; }
        });
      };
    };
  }

  /* =============================================
     [5.1] STICKY CTA ON MOBILE
     ============================================= */
  var _stickyObserver = null;
  function setupStickyCTA(price) {
    var sticky = document.getElementById('qw-sticky-cta');
    if (!sticky) return;
    sticky.innerHTML = '<span class="qw-sticky-price">' + price + '</span><button class="qw-sticky-book" onclick="document.getElementById(\'qwBookBtn\').click()">Book now</button>';

    var cta = document.querySelector('.qw-res-cta');
    if (!cta || !('IntersectionObserver' in window)) return;
    if (_stickyObserver) _stickyObserver.disconnect();
    _stickyObserver = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        sticky.classList.toggle('show', !entry.isIntersecting);
      });
    }, { threshold: 0 });
    _stickyObserver.observe(cta);
  }

  function destroyStickyCTA() {
    if (_stickyObserver) { _stickyObserver.disconnect(); _stickyObserver = null; }
    var sticky = document.getElementById('qw-sticky-cta');
    if (sticky) { sticky.classList.remove('show'); sticky.innerHTML = ''; }
  }

  /* =============================================
     RESET
     ============================================= */
  function reset() {
    S.device = null; S.model = null; S.modelGroup = null; S.fault = null; S.issue = null; S.step = 1; S.collectionHandle = null; S.route = null; S.repairType = null; _repairsMap = {};
    _courierQuote = null;
    _postcodeResolved = false;
    _quoteShownCaptured = false;
    _collectionSlot = { date: null, part: null };
    window.__icorrectQuote = {};
    _collectionProducts = [];
    _trackedSteps = {};
    clearResolutionState();
    document.querySelectorAll('.qw-dev').forEach(function(c) { c.classList.remove('sel'); });
    hideResolutionPanel();
    var tC = document.getElementById('qw-tC');
    if (tC) { tC.hidden = false; tC.innerHTML = ''; }
    destroyStickyCTA();
    go(1);
  }

  /* =============================================
     BACK BUTTONS
     ============================================= */
  var b2 = document.getElementById('qw-back2');
  if (b2) b2.onclick = function() {
    if (S.modelGroup && (MODELS[S.device] || []).length > 1) {
      renderModelGroups(S.device);
      return;
    }
    S.modelGroup = null;
    go(1);
  };
  var b3 = document.getElementById('qw-back3'); if (b3) b3.onclick = function() { go(2); };
  var b4 = document.getElementById('qw-back4');
  if (b4) b4.onclick = function() {
    /* From pricing/service screen → back to issue list (same step shell). */
    if (resolutionScreenOpen() && S.fault && S.fault !== 'Other') {
      clearResolutionState();
      S.issue = null; S.route = null; S.repairType = null;
      syncIcorrectQuote();
      delete _trackedSteps.resolution;
      destroyStickyCTA();
      renderIssues(S.device, S.fault);
      /* If pricing scrolled the chrome away above the viewport, ease back.
         Do not pull the page down when the wizard is simply below the fold. */
      requestAnimationFrame(function() {
        var anchor = document.querySelector('.qw-prog') || document.querySelector('.qw-wizard');
        if (!anchor) return;
        var rect = anchor.getBoundingClientRect();
        if (rect.bottom < 72) scrollToEl(anchor, 80, 'start');
      });
      return;
    }
    go(3);
  };

  /* =============================================
     PRE-FILL SYSTEM
     ============================================= */
  function normalizeModelKey(str) {
    return String(str || '').toLowerCase()
      .replace(/[""\'\'′]/g, '')
      .replace(/&/g, 'and')
      .replace(/inch(?:es)?/g, '')
      .replace(/[^a-z0-9]+/g, '');
  }

  function eachWizardModel(cb) {
    var devices = ['macbook', 'iphone', 'ipad', 'watch'];
    for (var d = 0; d < devices.length; d++) {
      var groups = MODELS[devices[d]] || [];
      for (var g = 0; g < groups.length; g++) {
        var models = groups[g].models || [];
        for (var m = 0; m < models.length; m++) {
          if (cb(devices[d], groups[g], models[m]) === false) return;
        }
      }
    }
  }

  function findModelByCollection(handle) {
    if (!handle) return null;
    var want = String(handle).toLowerCase();
    var exact = null;
    var fuzzy = [];
    eachWizardModel(function(device, group, model) {
      var ch = String(model.collectionHandle || '').toLowerCase();
      if (!ch) return;
      if (ch === want) { exact = { device: device, model: model, group: group }; return false; }
      /* Hub handles like macbook-pro-16 match many models — only fuzzy-pick when unique. */
      if (ch.indexOf(want) !== -1 || want.indexOf(ch) !== -1) {
        fuzzy.push({ device: device, model: model, group: group });
      }
    });
    if (exact) return exact;
    return fuzzy.length === 1 ? fuzzy[0] : null;
  }

  function findModelByName(name) {
    if (!name) return null;
    var want = normalizeModelKey(name);
    if (!want) return null;
    var exact = null;
    var contained = null; /* page/title contains the model name — prefer longest */
    var weak = null;      /* model name contains the query — last resort */
    eachWizardModel(function(device, group, model) {
      var key = normalizeModelKey(model.name);
      if (!key) return;
      if (key === want) { exact = { device: device, model: model, group: group }; return false; }
      if (want.indexOf(key) !== -1) {
        if (!contained || key.length > normalizeModelKey(contained.model.name).length) {
          contained = { device: device, model: model, group: group };
        }
        return;
      }
      if (!weak && key.indexOf(want) !== -1) {
        weak = { device: device, model: model, group: group };
      }
    });
    return exact || contained || weak;
  }

  function contextHaystack(ctx) {
    ctx = ctx || {};
    var parts = [
      ctx.productHandle,
      ctx.productTitle,
      ctx.collectionHandle,
      ctx.collectionTitle
    ];
    var tags = ctx.productTags || [];
    for (var i = 0; i < tags.length; i++) parts.push(tags[i]);
    var cols = [].concat(ctx.modelCollections || [], ctx.allCollections || []);
    for (var c = 0; c < cols.length; c++) parts.push(cols[c]);
    return parts.filter(Boolean).join(' ').toLowerCase();
  }

  /* Infer MacBook/iPhone series group from page copy (e.g. 16-inch, iPhone 12). */
  function findModelGroupFromContext(device, ctx) {
    var groups = MODELS[device] || [];
    if (!groups.length) return null;
    if (groups.length === 1) return groups[0];
    var hay = contextHaystack(ctx);
    if (!hay) return null;
    var best = null;
    var bestScore = 0;
    for (var i = 0; i < groups.length; i++) {
      var g = groups[i];
      var label = String(g.group || '');
      var score = 0;
      var normLabel = normalizeModelKey(label);
      if (normLabel && normalizeModelKey(hay).indexOf(normLabel) !== -1) score += 8;
      var inch = label.match(/(\d{2})\s*["”]|(\d{2})\s*-?\s*inch/i);
      if (inch) {
        var n = inch[1] || inch[2];
        if (new RegExp('(?:^|[^0-9])' + n + '(?:\\s|-)?(?:inch|in\\b|["”])').test(hay) || hay.indexOf(n + '-inch') !== -1 || hay.indexOf('pro-' + n) !== -1 || hay.indexOf(n + 'inch') !== -1) {
          score += 10;
        }
      }
      /* iPhone group titles like "iPhone 12" */
      var iphoneGen = label.match(/iphone\s*(\d{1,2})/i);
      if (iphoneGen && new RegExp('iphone[\\s-]*' + iphoneGen[1] + '(?![0-9])').test(hay)) score += 10;
      if (score > bestScore) { bestScore = score; best = g; }
    }
    return bestScore > 0 ? best : null;
  }

  function resolveModelFromContext(ctx, opts) {
    opts = opts || {};
    var cols = [].concat(ctx.modelCollections || []);
    if (ctx.collectionHandle) cols.push(ctx.collectionHandle);
    if (opts.includeAllCollections) cols = cols.concat(ctx.allCollections || []);
    var seen = {};
    var match = null;
    for (var i = 0; i < cols.length; i++) {
      var h = cols[i];
      if (!h || seen[h]) continue;
      seen[h] = true;
      match = findModelByCollection(h);
      if (match) return match;
    }
    if (opts.modelName) {
      match = findModelByName(opts.modelName);
      if (match) return match;
    }
    if (opts.modelSlug) {
      match = findModelByName(String(opts.modelSlug).replace(/-/g, ' '));
      if (match) return match;
    }
    /* Last resort: match page title / handle against wizard model names. */
    match = findModelByName(ctx.productTitle) || findModelByName(ctx.collectionTitle);
    if (match) return match;
    return null;
  }

  function openDeviceModels(device, ctx) {
    S.device = device;
    syncIcorrectQuote();
    renderDevices();
    var group = findModelGroupFromContext(device, ctx || CONTEXT);
    if (group) {
      pickModelGroup(device, group);
    } else {
      renderModels(device);
    }
    go(2);
  }

  function initPrefill() {
    var ctx = CONTEXT;
    _suppressScroll = true; /* Don't scroll during init - page should load from top */

    /* Section setting overrides */
    if (ctx && ctx.prefillDevice) ctx.device = ctx.device || ctx.prefillDevice;
    if (ctx && ctx.prefillFault) ctx.fault = ctx.fault || ctx.prefillFault;

    /* Collection handle → device/fault via data rules (#53 slice 3) */
    if (ctx && ctx.collectionHandle && window.ICorrectWizardPrefill && window.__QW_COLLECTION_PREFILL) {
      var cp = window.ICorrectWizardPrefill.resolveCollectionPrefill(ctx.collectionHandle, window.__QW_COLLECTION_PREFILL);
      if (cp.device && !ctx.device) ctx.device = cp.device;
      if (cp.fault && !ctx.fault) ctx.fault = cp.fault;
    }
    /* Product / title handles also carry device + fault hints (e.g. macbook-pro-16-screen). */
    if (ctx && window.ICorrectWizardPrefill && window.__QW_COLLECTION_PREFILL) {
      var hintHandles = [ctx.productHandle, ctx.productTitle, ctx.collectionTitle].concat(ctx.allCollections || []);
      for (var hi = 0; hi < hintHandles.length; hi++) {
        if (!hintHandles[hi]) continue;
        var hp = window.ICorrectWizardPrefill.resolveCollectionPrefill(hintHandles[hi], window.__QW_COLLECTION_PREFILL);
        if (hp.device && !ctx.device) ctx.device = hp.device;
        if (hp.fault && !ctx.fault) ctx.fault = hp.fault;
      }
    }

    /* CASE 0: Product page — catalogue map reverse lookup lands on service step */
    if (ctx && ctx.productHandle && window.ICorrectWizardPrefill && window.__QW_CATALOGUE) {
      var hit = window.ICorrectWizardPrefill.resolveProductPrefill(window.__QW_CATALOGUE, {
        handle: ctx.productHandle,
        variantId: ctx.productVariantId
      });
      if (hit) {
        S.device = hit.device;
        S.preRepairType = hit.fault;
        S.preFault = REPAIR_TYPE_TO_FAULT[hit.fault] || hit.fault;
        S.preVariantId = hit.variantId || null;
        if (S.preFault === '_diagnostic') S.preFault = null;
        trackWizardEntry('product_catalogue', { productHandle: ctx.productHandle, fault: hit.fault, modelName: hit.modelName || null });
        renderDevices();
        var modelMatch = resolveModelFromContext(ctx, {
          includeAllCollections: true,
          modelName: hit.modelName,
          modelSlug: hit.modelSlug
        });
        if (modelMatch) {
          pickModel(modelMatch.model.name, modelMatch.model.collectionHandle, null).then(function() {
            _suppressScroll = false;
          });
        } else {
          openDeviceModels(hit.device, ctx);
          _suppressScroll = false;
        }
        return;
      }
    }

    /* CASE 1: Product page — pre-fill device + model, derive fault from handle */
    if (ctx && ctx.productHandle) {
      var modelMatch = resolveModelFromContext(ctx, { includeAllCollections: true });
      if (modelMatch) {
        var rt = deriveRepairTypeFromHandle(ctx.productHandle);
        var faultName = rt ? REPAIR_TYPE_TO_FAULT[rt] : null;
        S.device = modelMatch.device;
        trackWizardEntry('product', {
          collectionHandle: modelMatch.model.collectionHandle,
          productHandle: ctx.productHandle
        });
        if (faultName && faultName !== '_diagnostic') S.preFault = faultName;
        renderDevices();
        pickModel(modelMatch.model.name, modelMatch.model.collectionHandle, null).then(function() {
          _suppressScroll = false;
        });
        return;
      }
      /* Product page but can't find exact model — device + best series (e.g. MacBook 16"). */
      if (ctx.device) {
        trackWizardEntry('product', {
          productHandle: ctx.productHandle,
          deviceContextOnly: true
        });
        openDeviceModels(ctx.device, ctx);
        _suppressScroll = false;
        return;
      }
    }

    /* CASE 2: Collection page — pre-fill device + model / series */
    if (ctx && ctx.collectionHandle) {
      var match = resolveModelFromContext(ctx, { includeAllCollections: true });
      if (match) {
        S.device = match.device;
        trackWizardEntry('collection', {
          collectionHandle: ctx.collectionHandle
        });
        renderDevices();
        pickModel(match.model.name, match.model.collectionHandle, null).then(function() {
          _suppressScroll = false;
        });
        return;
      }
      if (ctx.device) {
        trackWizardEntry('collection', {
          collectionHandle: ctx.collectionHandle,
          deviceContextOnly: true
        });
        if (ctx.fault) S.preFault = ctx.fault;
        openDeviceModels(ctx.device, ctx);
        _suppressScroll = false;
        return;
      }
    }

    /* CASE 3: Device context from metafield */
    if (ctx && ctx.device) {
      trackWizardEntry('device_context', {
        faultPrefill: ctx.fault || null
      });
      if (ctx.fault) S.preFault = ctx.fault;
      openDeviceModels(ctx.device, ctx);
      _suppressScroll = false;
      return;
    }

    /* CASE 4: No context — start fresh.
       Keep scroll suppressed across go(1)'s rAF pin so homepage load
       doesn't jump down into the quote module below the hero. */
    trackWizardEntry('fresh');
    renderDevices();
    go(1);
    requestAnimationFrame(function() {
      requestAnimationFrame(function() {
        _suppressScroll = false;
      });
    });
  }

  /* =============================================
     BROWSER BACK + [4.9] POSTHOG DROP-OFF
     ============================================= */
  window.addEventListener('popstate', function(e) {
    if (e.state && typeof e.state.step === 'number') {
      S.step = e.state.step;
      S.device = e.state.device || null;
      S.model = e.state.model || null;
      S.fault = e.state.fault || null;
      S.issue = null;
      S.route = null;
      S.repairType = null;
      syncIcorrectQuote();
      clearTrackedStepsAfter(e.state.step);
      document.querySelectorAll('.qw-step').forEach(function(el) { el.classList.remove('on'); });
      var stepEl = document.getElementById('qw-s' + e.state.step);
      if (stepEl) stepEl.classList.add('on');
      updateProg(e.state.step);
      updateCrumb();
    }
  });

  window.addEventListener('beforeunload', function() {
    if (!window.posthog) return;
    if (_resolutionSeen && !_resolutionConverted) {
      posthog.capture('wizard_resolution_abandoned', buildWizardTrackPayload({
        step: S.step,
        duration: Date.now() - _stepStartTime
      }));
      return;
    }
    if (S.step > 1 && !S.issue) {
      posthog.capture('wizard_abandoned', buildWizardTrackPayload({
        step: S.step,
        duration: Date.now() - _stepStartTime
      }));
    }
  });

  /* =============================================
     INIT
     ============================================= */
  wireProgDots();
  function bootPrefill() {
    var ctx = CONTEXT || {};
    var needsCatalogue = !!(ctx.productHandle || ctx.collectionHandle || ctx.device);
    if (needsCatalogue) {
      ensureCourierAssets().then(function() {
        initPrefill();
      }).catch(function() {
        initPrefill();
      });
      return;
    }
    /* Homepage / no context: paint step 1 immediately; fetch bands+map in the background. */
    initPrefill();
    ensureCourierAssets().catch(function(){});
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', bootPrefill);
  } else {
    bootPrefill();
  }

})();
</script>

