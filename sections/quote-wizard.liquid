<script>
(function () {
  var ENDPOINT = "https://api.icorrect.co.uk/api/quote-events";

  function phDistinctId() {
    try {
      if (window.posthog && typeof window.posthog.get_distinct_id === "function") {
        return String(window.posthog.get_distinct_id() || "");
      }
    } catch (e) {}
    return "";
  }

  function quotePayload(extra) {
    var q = window.__icorrectQuote || {};
    var payload = {
      session_id: phDistinctId(),
      device: q.device || null,
      model: q.model || null,
      fault: q.fault || null,
      issue: q.issue || null,
      repair: q.repair || null,
      repair_handle: q.repair_handle || q.repairHandle || null,
      repair_type: q.repair_type || q.repairType || null,
      route: q.route || null,
      outward_code: q.outward_code || q.outwardCode || null,
      band: q.band || null,
      tier: q.tier || null,
      repair_price: typeof q.repair_price === "number" ? q.repair_price : (typeof q.repairPrice === "number" ? q.repairPrice : null),
      adjustment: typeof q.adjustment === "number" ? q.adjustment : null,
      total: typeof q.total === "number" ? q.total : null,
      service_selected: q.service_selected || q.serviceSelected || null,
      collection_date: q.collection_date || q.collectionDate || null,
      collection_window: q.collection_window || q.collectionWindow || null,
      proceeded: false
    };
    if (extra) {
      for (var k in extra) payload[k] = extra[k];
    }
    Object.keys(payload).forEach(function (key) {
      if (payload[key] === null || payload[key] === "") delete payload[key];
    });
    return payload;
  }

  function captureQuoteShown() {
    var body = quotePayload({ proceeded: false });
    if (!body.session_id) return;
    fetch(ENDPOINT, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(body),
      keepalive: true,
      credentials: "omit",
      mode: "cors"
    }).catch(function () {});
  }

  function captureQuoteProceeded() {
    var body = quotePayload({ proceeded: true });
    if (!body.session_id) return;
    var blob = new Blob([JSON.stringify(body)], { type: "application/json" });
    if (navigator.sendBeacon) {
      navigator.sendBeacon(ENDPOINT, blob);
      return;
    }
    fetch(ENDPOINT, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(body),
      keepalive: true,
      credentials: "omit",
      mode: "cors"
    }).catch(function () {});
  }

  function captureQuoteEmailRequested(contact) {
    var name = contact && contact.contact_name ? String(contact.contact_name) : (contact && contact.name ? String(contact.name) : "");
    var email = contact && contact.contact_email ? String(contact.contact_email) : (contact && contact.email ? String(contact.email) : "");
    var body = quotePayload({
      quote_email_requested: true,
      contact_name: name || null,
      contact_email: email || null
    });
    if (!body.session_id) return;
    // No navigation happens on email-quote — use fetch keepalive (proven path);
    // sendBeacon's preflight fired but the POST never followed on Chromium (2026-09-13).
    fetch(ENDPOINT, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(body),
      keepalive: true,
      credentials: "omit",
      mode: "cors"
    }).catch(function () {});
  }

  function withPhCartAttribute(items) {
    var id = phDistinctId();
    if (!id) return items;
    return items.map(function (item) {
      var attrs = Object.assign({}, item.properties || {}, { _ph_distinct_id: id });
      return Object.assign({}, item, { properties: attrs });
    });
  }

  window.icorrectQuoteEvents = {
    captureQuoteShown: captureQuoteShown,
    captureQuoteProceeded: captureQuoteProceeded,
    captureQuoteEmailRequested: captureQuoteEmailRequested,
    withPhCartAttribute: withPhCartAttribute,
    phDistinctId: phDistinctId
  };
})();
</script>

