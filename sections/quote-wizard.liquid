  function serviceVariantsAsset() {
    if (window.__QW_SERVICE_ADJUSTMENTS) return window.__QW_SERVICE_ADJUSTMENTS;
    return { variants: CFG.serviceAdjustments || {} };
  }

  function quoteForService(serviceKind, postcode) {
    if (!window.ICorrectCourier || !window.__QW_BANDS) return null;
    return window.ICorrectCourier.quoteServiceAdjustment({
      postcode: postcode || '',
      productTags: currentRepairTags(),
      bands: window.__QW_BANDS,
      service: serviceKind === 'mailin' ? 'mail-in' : 'courier',
      repairPrice: currentRepairPrice(),
      variants: serviceVariantsAsset()
    });
  }

  /* Status chips only — never a fee line. Before postcode: prompt to enter one. */
  function formatServiceCardHint(quote, kind) {
    if (!_postcodeResolved || !quote) return '—';
    if (kind === 'mailin') {
      return quote.tier === 'paid' ? 'Tracked pack' : 'Free pack';
    }
    if (!quote.courierAvailable && quote.forcedMailIn) return 'Not in area';
    if (quote.service === 'courier' && quote.adjustment === 0) return 'Included';
    if (quote.service === 'courier') return 'Available';
    return '—';
  }

  /* Hide mail-in only when courier is free or strictly cheaper.
     Paid B1/B2 (<£200) must keep BOTH options: courier +£25 or mail-in +£20.
     Do not hide mail-in on mobile just because courier is available — that
     removed the cheaper mail-in choice and broke the policy. */
  function shouldHideMailInOption(quote, postcode) {
    if (!quote || quote.courierAvailable === false) return false;
    var pc = postcode || '';
    var courierQ = quote.service === 'courier' && !quote.forcedMailIn
      ? quote
      : quoteForService('courier', pc);
    if (!courierQ || courierQ.courierAvailable === false || courierQ.forcedMailIn) return false;
    var courierAdj = Number(courierQ.adjustment);
    if (!isFinite(courierAdj)) courierAdj = 0;
    /* Free courier (B1/B2 ≥£200): mail-in adds nothing — solo courier is fine. */
    if (courierAdj === 0) return true;
    var mailQuote = quoteForService('mailin', pc);
    if (!mailQuote) return false;
    var mailAdj = Number(mailQuote.adjustment);
    if (!isFinite(mailAdj)) mailAdj = 0;
    return courierAdj < mailAdj;
  }

  function setMailInOptionVisible(show) {
    var mailCard = document.querySelector('.qw-opt-card[data-svc="mailin"]');
    var courierCard = document.querySelector('.qw-opt-card[data-svc="courier"]');
    var grid = document.getElementById('qwDeliveryGrid');
    var choice = document.getElementById('qwDeliveryChoice');
    var choiceLabel = document.getElementById('qwDeliveryChoiceLabel');
    if (mailCard) {
      mailCard.hidden = !show;
      mailCard.setAttribute('aria-hidden', show ? 'false' : 'true');
      if (!show) {
        mailCard.classList.remove('sel', 'active');
      }
    }
    if (grid) grid.classList.toggle('qw-delivery-grid-solo', !show);
    /* Solo free-courier on mobile: drop choice chrome so slots + journey + price fit.
       Only reached when shouldHideMailInOption is true (courier free/cheaper). */
    if (!show && isMobileQuoteLayout()) {
      if (choice) choice.hidden = true;
      if (courierCard) courierCard.hidden = true;
      return;
    }
    if (choice) choice.hidden = false;
    /* Mobile: keep unavailable courier fully removed (desktop stays greyed). */
    if (courierCard) {
      var courierUnavailable = courierCard.classList.contains('qw-opt-disabled');
      if (courierUnavailable && isMobileQuoteLayout()) {
        courierCard.hidden = true;
        courierCard.setAttribute('aria-hidden', 'true');
        if (grid) grid.classList.add('qw-delivery-grid-solo');
      } else {
        courierCard.hidden = false;
        courierCard.setAttribute('aria-hidden', 'false');
      }
    }
    if (choiceLabel) {
      var courierVisible = !!(courierCard && !courierCard.hidden);
      choiceLabel.hidden = !show || !courierVisible;
    }
  }

  function setPriceVisibility(show) {
    var gate = document.getElementById('qwPriceGate');
