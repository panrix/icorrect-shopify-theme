{% comment %}
  Section: Apple Watch Videos
  Redesigned click-to-play 3-video panel using snippets/icorrect-video-panel.liquid.
  Preserves all existing Theme Customizer settings across Apple Watch templates.
{% endcomment %}

{%- assign watch_pad_top = section.settings.padding_top | plus: 40 -%}
{%- assign watch_pad_bottom = section.settings.padding_bottom | plus: 40 -%}

{%- render 'icorrect-video-panel',
  section: section,
  pad_top: watch_pad_top,
  pad_bottom: watch_pad_bottom,
  kicker: 'Inside Our Fitzrovia Workshop · Glass-Only Restoration',
  badge: 'Apple Watch Specialist Lab',
  tag_prefix: 'Watch Bench',
  default_heading: 'Behind the scenes',
  default_subtitle: 'Watch our videos to understand common repair issues, what to expect, and how we fix your device with care.',
  video_1_id: '7yrJjsdlegw',
  video_1_fallback_title: 'Repair your Watch, do not replace it.',
  video_1_aria: 'Apple Watch Series 9 glass-only screen repair walkthrough',
  video_1_default_desc: 'Replacing only the cracked front glass while keeping your original Apple OLED display intact and calibrated.',
  video_2_id: 'vqOHcqvPDX8',
  video_2_fallback_title: 'Treat your rear glass with care.',
  video_2_aria: 'Apple Watch rear glass and heart rate sensor repair in London',
  video_2_default_desc: 'Why cracked rear sensor glass needs prompt specialist sealing to protect the heart-rate module and water resistance.',
  video_3_id: 'oTaCDfLWTfQ',
  video_3_fallback_title: 'We care about sustainability.',
  video_3_aria: 'Sustainable Apple Watch glass-only screen restoration at iCorrect',
  video_3_default_desc: 'Precision refurbishment that saves working OLED displays and reduces unnecessary e-waste across every Watch Series.'
-%}

{% schema %}
{
  "name": "Apple Watch Videos",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Title",
      "default": "Behind the scenes"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Watch our videos to understand common repair issues, what to expect, and how we fix your device with care."
    },
    {
      "type": "text",
      "id": "video_1_title",
      "label": "Video 1 title",
      "default": "Repair your Watch, do not replace it."
    },
    {
      "type": "text",
      "id": "video_1_desc",
      "label": "Video 1 caption (optional)"
    },
    {
      "type": "text",
      "id": "video_2_title",
      "label": "Video 2 title",
      "default": "Treat your rear glass with care."
    },
    {
      "type": "text",
      "id": "video_2_desc",
      "label": "Video 2 caption (optional)"
    },
    {
      "type": "text",
      "id": "video_3_title",
      "label": "Video 3 title",
      "default": "We care about sustainability."
    },
    {
      "type": "text",
      "id": "video_3_desc",
      "label": "Video 3 caption (optional)"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "Apple Watch Videos"
    }
  ]
}
{% endschema %}
