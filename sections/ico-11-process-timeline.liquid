<section class="section section-compact section-soft timeline-band" id="process-strip">
  <div class="ic-container">
    <div class="timeline-head">
      <h2>{{ section.settings.heading | escape }}</h2>
    </div>

    <div class="timeline-rail-wrap">
      <div class="timeline-bracket-grid" aria-hidden="true">
        <div class="timeline-bracket">
          <div class="timeline-bracket-label">
            <span class="timeline-bracket-val">{{ section.settings.bracket_value | escape }}</span>
            <span class="timeline-bracket-sub">{{ section.settings.bracket_sub | escape }}</span>
          </div>
          <div class="timeline-bracket-bar"></div>
        </div>
      </div>

      <ol class="timeline-steps">
        <li class="timeline-step">
          <span class="timeline-node" aria-hidden="true"></span>
          <span class="mono-label">Step 1</span>
          <h3 class="timeline-step-title">{{ section.settings.step_1_title | escape }}</h3>
          <p>{{ section.settings.step_1_body | escape }}</p>
        </li>
        <li class="timeline-step is-workshop">
          <span class="timeline-node" aria-hidden="true"></span>
          <span class="timeline-mobile-badge">{{ section.settings.mobile_badge | escape }}</span>
          <span class="mono-label">Step 2</span>
          <h3 class="timeline-step-title">{{ section.settings.step_2_title | escape }}</h3>
          <p>{{ section.settings.step_2_body | escape }}</p>
        </li>
        <li class="timeline-step is-workshop">
          <span class="timeline-node" aria-hidden="true"></span>
          <span class="mono-label">Step 3</span>
          <h3 class="timeline-step-title">{{ section.settings.step_3_title | escape }}</h3>
          <p>{{ section.settings.step_3_body | escape }}</p>
        </li>
        <li class="timeline-step">
          <span class="timeline-node" aria-hidden="true"></span>
          <span class="mono-label">Step 4</span>
          <h3 class="timeline-step-title">{{ section.settings.step_4_title | escape }}</h3>
          <p>{{ section.settings.step_4_body | escape }}</p>
        </li>
      </ol>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "ICO-11 Process Timeline",
  "tag": "div",
  "class": "ico11-shopify",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Collected from your door, repaired in Fitzrovia in 2 working days, returned insured."
    },
    {
      "type": "text",
      "id": "bracket_value",
      "label": "Workshop bracket value",
      "default": "2 working days"
    },
    {
      "type": "text",
      "id": "bracket_sub",
      "label": "Workshop bracket subtitle",
      "default": "in our workshop"
    },
    {
      "type": "text",
      "id": "mobile_badge",
      "label": "Mobile badge text",
      "default": "2 working days in our workshop"
    },
    {
      "type": "text",
      "id": "step_1_title",
      "label": "Step 1 title",
      "default": "We collect"
    },
    {
      "type": "textarea",
      "id": "step_1_body",
      "label": "Step 1 description",
      "default": "London courier collection in selected zones, or free insured UK mail-in pack."
    },
    {
      "type": "text",
      "id": "step_2_title",
      "label": "Step 2 title",
      "default": "On the bench"
    },
    {
      "type": "textarea",
      "id": "step_2_body",
      "label": "Step 2 description",
      "default": "Genuine Apple display panel fitted inside your original lid in Fitzrovia."
    },
    {
      "type": "text",
      "id": "step_3_title",
      "label": "Step 3 title",
      "default": "Calibrated and tested"
    },
    {
      "type": "textarea",
      "id": "step_3_body",
      "label": "Step 3 description",
      "default": "True Tone, peak brightness, colour accuracy, and hinge alignment verified."
    },
    {
      "type": "text",
      "id": "step_4_title",
      "label": "Step 4 title",
      "default": "Returned insured"
    },
    {
      "type": "textarea",
      "id": "step_4_body",
      "label": "Step 4 description",
      "default": "Sent back tracked and insured with your data untouched and 2-year cover."
    }
  ],
  "presets": [
    {
      "name": "ICO-11 Process Timeline"
    }
  ]
}
{% endschema %}
