{%- liquid
  assign ti_widget_id = section.settings.trustindex_widget_id | strip
  if ti_widget_id == blank
    assign ti_widget_id = 'b831fa386ffa616e7a2620959d0'
  endif
  assign google_reviews_url = section.settings.google_url
  if google_reviews_url == blank
    assign google_reviews_url = 'https://maps.google.com/?q=iCorrect+12+Margaret+Street+Audley+House+London+W1W+8JQ'
  endif
-%}

<section class="section section-compact section-soft" id="google-reviews">
  <div class="ic-container">
    <div class="reviews-head">
      <div class="reviews-head-main">
        <span class="reviews-g-badge" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
            <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
          </svg>
        </span>
        <h2 class="section-title">{{ section.settings.heading | escape }}</h2>
      </div>
      <a
        class="btn-ghost"
        href="{{ google_reviews_url | escape }}"
        target="_blank"
        rel="noopener"
      >{{ section.settings.cta_label | escape }}<span class="visually-hidden"> (opens in a new tab)</span></a>
    </div>

    <div class="trustindex-slot" id="trustindex-reviews-slot">
      <script defer async src="https://cdn.trustindex.io/loader.js?{{ ti_widget_id | escape }}"></script>
      <p class="trustindex-fallback" id="trustindex-fallback" hidden>
        Our latest MacBook screen repair reviews are on Google.
        <a
          class="text-link"
          href="{{ google_reviews_url | escape }}"
          target="_blank"
          rel="noopener"
        >Read them on Google<span class="visually-hidden"> (opens in a new tab)</span></a>
      </p>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "ICO-11 Google Reviews",
  "tag": "div",
  "class": "ico11-shopify",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "4.8 from 750+ Google reviews"
    },
    {
      "type": "text",
      "id": "trustindex_widget_id",
      "label": "Trustindex widget ID",
      "default": "b831fa386ffa616e7a2620959d0",
      "info": "Dedicated MacBook Screen Trustindex widget ID."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "Read all reviews on Google"
    },
    {
      "type": "url",
      "id": "google_url",
      "label": "Google reviews URL",
      "info": "Leave blank to default to iCorrect Fitzrovia Google Maps listing."
    }
  ],
  "presets": [
    {
      "name": "ICO-11 Google Reviews"
    }
  ]
}
{% endschema %}
