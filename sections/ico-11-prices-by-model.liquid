{% schema %}
{
  "name": "ICO-11 Prices By Model",
  "tag": "div",
  "class": "ico11-shopify",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "MacBook screen repair prices by model"
    },
    {
      "type": "textarea",
      "id": "lead",
      "label": "Lead copy",
      "default": "Upfront fixed prices including a genuine Apple display panel, calibration, 2-year warranty, and free tracked UK mail-in. London courier is free in most zones (£25 in outer Band 4)."
    },
    {
      "type": "textarea",
      "id": "note",
      "label": "Footer note",
      "default": "All prices verified from our live catalogue and include genuine Apple display panel, calibration, and 2-year warranty."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label",
      "default": "Get your price"
    }
  ],
  "presets": [
    {
      "name": "ICO-11 Prices By Model"
    }
  ]
}
{% endschema %}
