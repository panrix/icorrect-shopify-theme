{%- comment -%}
  sections/macbook-pillar-page.liquid
  Reusable editorial section for high-intent MacBook pillar money pages
  (e.g. /pages/macbook-liquid-damage-repair, /pages/macbook-no-power-repair).
  Render once above sections/quote-wizard (part = "top") and once below (part = "bottom")
  so the untouched Shopify quote wizard sits in the validated value-first slot.
{%- endcomment -%}

{%- assign part = section.settings.part | default: 'top' -%}
{%- assign sid = section.id -%}

{%- if part == 'top' -%}
<style>
  .icp-root {
    --icp-bg-1: #ffffff;
    --icp-bg-2: #fafafa;
    --icp-bg-3: #f2f2f2;
    --icp-fg-1: #171717;
    --icp-fg-2: #4d4d4d;
    --icp-fg-3: #666666;
    --icp-fg-4: #8c8c8c;
    --icp-line: rgba(0, 0, 0, 0.08);
    --icp-line-strong: rgba(0, 0, 0, 0.16);
    --icp-accent: #0070f3;
    --icp-green: #15803d;
    --icp-star: #f59e0b;
    --icp-font-sans: "Geist", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    --icp-font-mono: "Geist Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
    font-family: var(--icp-font-sans);
    color: var(--icp-fg-1);
    line-height: 1.5;
    overflow-x: clip;
  }
  .icp-root *, .icp-root *::before, .icp-root *::after { box-sizing: border-box; }
  .icp-container {
    width: 100%;
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 24px;
  }
  .icp-mono {
    font-family: var(--icp-font-mono);
    font-size: 11px;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--icp-fg-3);
  }
  .icp-btn-dark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 10px 18px;
    min-height: 40px;
    border-radius: 6px;
    background: var(--icp-fg-1);
    color: #ffffff !important;
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    border: 0;
    cursor: pointer;
    white-space: nowrap;
  }
  .icp-btn-dark:hover { background: #333333; }
  .icp-btn-ghost {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 7px 13px;
    min-height: 36px;
    border-radius: 999px;
    border: 1px solid var(--icp-line-strong);
    background: #ffffff;
    color: var(--icp-fg-1) !important;
    font-size: 13px;
    font-weight: 500;
    text-decoration: none;
    cursor: pointer;
  }
  .icp-btn-ghost:hover { border-color: var(--icp-fg-1); background: var(--icp-bg-2); }

  /* Hero */
  .icp-hero {
    padding: 24px 0 40px;
    background: var(--icp-bg-1);
    border-bottom: 1px solid var(--icp-line);
  }
  .icp-breadcrumb {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    margin-bottom: 14px;
    font-family: var(--icp-font-mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--icp-fg-4);
  }
  .icp-breadcrumb a { color: var(--icp-fg-3); text-decoration: none; }
  .icp-breadcrumb a:hover { color: var(--icp-fg-1); }

  .icp-trust-strip {
    margin: 0 0 22px;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    background: var(--icp-bg-2);
    border: 1px solid var(--icp-line);
    border-radius: 10px;
    overflow: hidden;
  }
  .icp-trust-cell {
    padding: 10px 12px;
    display: flex;
    align-items: center;
    gap: 9px;
    border-right: 1px solid var(--icp-line);
    min-width: 0;
  }
  .icp-trust-cell:last-child { border-right: 0; }
  .icp-trust-link {
    display: flex;
    align-items: center;
    gap: 9px;
    text-decoration: none;
    color: inherit;
    width: 100%;
  }
  .icp-trust-score {
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1;
    color: var(--icp-fg-1);
    flex-shrink: 0;
  }
  .icp-trust-stars { display: inline-flex; gap: 2px; line-height: 1; margin-bottom: 2px; }
  .icp-trust-icon {
    width: 26px;
    height: 26px;
    border-radius: 6px;
    background: #ffffff;
    border: 1px solid var(--icp-line);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: var(--icp-fg-1);
  }
  .icp-trust-copy { display: flex; flex-direction: column; min-width: 0; }
  .icp-trust-copy strong { font-size: 12.5px; font-weight: 600; color: var(--icp-fg-1); line-height: 1.25; }
  .icp-trust-copy span { font-size: 11px; color: var(--icp-fg-3); line-height: 1.25; }

  .icp-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: 36px;
    align-items: center;
  }
  .icp-hero-grid > * { min-width: 0; }
  .icp-h1 {
    margin: 0 0 10px;
    font-size: 42px;
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.04em;
    color: var(--icp-fg-1);
  }
  .icp-lead {
    margin: 0 0 18px;
    font-size: 16px;
    line-height: 1.55;
    color: var(--icp-fg-2);
    max-width: 50ch;
  }
  .icp-highlights {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .icp-highlights li { min-width: 0; }
  .icp-chip {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 10px 12px;
    border-radius: 6px;
    border: 1px solid var(--icp-line);
    background: #ffffff;
    text-decoration: none;
    color: inherit;
  }
  .icp-chip:hover { border-color: var(--icp-fg-1); background: var(--icp-bg-2); }
  .icp-chip-label { font-size: 11.5px; font-weight: 500; color: var(--icp-fg-3); }
  .icp-chip-val { font-size: 14.5px; font-weight: 600; color: var(--icp-fg-1); letter-spacing: -0.02em; }
  .icp-note { margin: 10px 0 0; font-size: 12.5px; color: var(--icp-fg-3); }
  .icp-cta-row {
    margin-top: 16px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
  }

  /* Right Hero Card (Emergency / Diagnostic Steps) */
  .icp-stage {
    background: var(--icp-bg-2);
    border: 1px solid var(--icp-line);
    border-radius: 14px;
    padding: 20px;
  }
  .icp-stage-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 14px;
    flex-wrap: wrap;
  }
  .icp-stage-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 3px 9px;
    border-radius: 999px;
    background: #eff6ff;
    border: 1px solid #bfdbfe;
    font-family: var(--icp-font-mono);
    font-size: 10.5px;
    color: #0369a1;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }
  .icp-step-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .icp-step-item {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 12px;
    border-radius: 8px;
    background: #ffffff;
    border: 1px solid var(--icp-line);
  }
  .icp-step-num {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--icp-fg-1);
    color: #ffffff;
    font-family: var(--icp-font-mono);
    font-size: 11px;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 1px;
  }
  .icp-step-item strong { display: block; font-size: 13.5px; color: var(--icp-fg-1); margin-bottom: 2px; }
  .icp-step-item span { display: block; font-size: 12.5px; color: var(--icp-fg-2); line-height: 1.45; }

  /* 3 Proof Pillars */
  .icp-pillars {
    margin-top: 26px;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }
  .icp-pillar {
    background: var(--icp-bg-2);
    border: 1px solid var(--icp-line);
    border-radius: 10px;
    overflow: hidden;
  }
  .icp-pillar-btn {
    width: 100%;
    border: 0;
    background: transparent;
    padding: 15px 16px 6px;
    text-align: left;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    cursor: default;
  }
  .icp-pillar-title { font-size: 14.5px; font-weight: 600; color: var(--icp-fg-1); line-height: 1.3; }
  .icp-pillar-plus { display: none; font-family: var(--icp-font-mono); font-size: 16px; color: var(--icp-fg-3); }
  .icp-pillar-body { padding: 0 16px 15px; font-size: 13.5px; color: var(--icp-fg-2); line-height: 1.5; }
  .icp-pillar-body p { margin: 0; }

  /* Sections */
  .icp-section { padding: 52px 0; border-bottom: 1px solid var(--icp-line); background: var(--icp-bg-1); }
  .icp-section-soft { background: var(--icp-bg-2); }
  .icp-section-dark { background: #171717; color: #ffffff; border-bottom: 1px solid rgba(255, 255, 255, 0.1); }
  .icp-section-head { max-width: 680px; margin-bottom: 24px; }
  .icp-h2 {
    margin: 6px 0 8px;
    font-size: 30px;
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.035em;
    color: var(--icp-fg-1);
  }
  .icp-section-dark .icp-h2 { color: #ffffff; }
  .icp-section-lead { margin: 0; font-size: 15px; color: var(--icp-fg-2); line-height: 1.55; }
  .icp-section-dark .icp-section-lead { color: rgba(255, 255, 255, 0.72); }

  /* Reviews */
  .icp-reviews-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 12px; flex-wrap: wrap; margin-bottom: 16px; }
  .icp-trustindex-slot {
    border: 1px solid var(--icp-line);
    border-radius: 12px;
    background: #ffffff;
    min-height: 200px;
    padding: 20px;
  }

  /* Expandable Comparison Table */
  .icp-compare-card {
    border: 1px solid var(--icp-line);
    border-radius: 10px;
    background: #ffffff;
    overflow: hidden;
  }
  .icp-compare-scroll { overflow-x: auto; }
  .icp-compare-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13.5px;
    text-align: left;
  }
  .icp-compare-table th, .icp-compare-table td {
    padding: 12px 16px;
    border-bottom: 1px solid var(--icp-line);
    vertical-align: top;
  }
  .icp-compare-table th {
    font-family: var(--icp-font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--icp-fg-3);
    background: var(--icp-bg-2);
  }
  .icp-compare-table .is-icorrect {
    background: #f8fbff;
    color: var(--icp-fg-1);
    font-weight: 500;
  }
  .icp-extra-row { display: none; }
  .icp-compare-card.is-expanded .icp-extra-row { display: table-row; }
  .icp-expand-btn {
    width: 100%;
    border: 0;
    background: var(--icp-bg-2);
    color: var(--icp-fg-1);
    padding: 12px 16px;
    font-size: 13.5px;
    font-weight: 500;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    cursor: pointer;
  }
  .icp-expand-btn:hover { background: var(--icp-bg-3); }

  /* Expandable 2-Year Warranty */
  .icp-warranty {
    margin-top: 16px;
    background: #ffffff;
    border: 1px solid var(--icp-line);
    border-radius: 10px;
    overflow: hidden;
  }
  .icp-warranty-btn {
    width: 100%;
    border: 0;
    background: transparent;
    padding: 18px 22px;
    text-align: left;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    cursor: pointer;
  }
  .icp-warranty-btn:hover { background: var(--icp-bg-2); }
  .icp-warranty-btn h3 { margin: 4px 0 0; font-size: 19px; font-weight: 600; letter-spacing: -0.025em; color: var(--icp-fg-1); }
  .icp-warranty-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    border-radius: 6px;
    border: 1px solid var(--icp-line-strong);
    background: #ffffff;
    font-size: 12.5px;
    font-weight: 500;
    color: var(--icp-fg-1);
    white-space: nowrap;
    flex-shrink: 0;
  }
  .icp-warranty-body {
    display: none;
    padding: 0 22px 20px;
    border-top: 1px solid var(--icp-line);
  }
  .icp-warranty.is-open .icp-warranty-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    gap: 18px 24px;
    align-items: center;
    padding-top: 16px;
  }
  .icp-warranty-body p { margin: 0; font-size: 13.5px; color: var(--icp-fg-2); line-height: 1.55; }
  .icp-checks {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px 14px;
    font-size: 13.5px;
    color: var(--icp-fg-2);
  }
  .icp-checks li { display: flex; align-items: flex-start; gap: 7px; }
  .icp-check-mark { color: var(--icp-green); font-weight: 600; flex-shrink: 0; }

  /* Find your model (Ricky's exact Claude Code container) */
  .icp-identify { padding: 64px 0; border-bottom: 1px solid var(--icp-line); background: var(--icp-bg-1); }
  .icp-identify-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 48px;
    align-items: center;
  }
  .icp-identify-grid > * { min-width: 0; }
  .icp-identify-visual {
    background: #e5e7eb;
    border-radius: 16px;
    padding: 40px 28px;
    border: 1px solid var(--icp-line);
    aspect-ratio: 4 / 3;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .icp-identify-plate {
    background: #e5e5e5;
    padding: 16px 20px;
    border-radius: 6px;
    font-family: var(--icp-font-mono);
    color: #4d4d4d;
    display: flex;
    flex-direction: column;
    gap: 4px;
    border: 1px solid rgba(0, 0, 0, 0.1);
  }
  .icp-plate-line { font-size: 11px; }
  .icp-plate-line.is-muted { color: #737373; }
  .icp-plate-line.is-small { font-size: 9.5px; }
  .icp-plate-line.is-hl { font-size: 13px; color: #171717; margin-top: 6px; }
  .icp-plate-badge {
    background: #ffffff;
    padding: 2px 6px;
    border-radius: 3px;
    border: 2px solid #171717;
    color: #171717;
    font-weight: 600;
  }
  .icp-identify-hint { margin-top: 14px; font-size: 11px; color: #171717; }
  .icp-identify-form { display: flex; gap: 8px; max-width: 420px; margin-top: 16px; }
  .icp-identify-form input {
    flex: 1;
    min-width: 0;
    padding: 11px 14px;
    border: 1px solid var(--icp-line-strong);
    border-radius: 8px;
    background: #ffffff;
    font-size: 15px;
    color: var(--icp-fg-1);
  }
  .icp-identify-result {
    margin-top: 12px;
    max-width: 420px;
    padding: 12px 14px;
    border-radius: 8px;
    border: 1px solid var(--icp-line-strong);
    background: var(--icp-bg-2);
    font-size: 13.5px;
    display: none;
  }
  .icp-identify-result.is-visible { display: flex; align-items: center; justify-content: space-between; gap: 10px; flex-wrap: wrap; }
  .icp-identify-foot { margin-top: 12px; font-size: 13px; color: var(--icp-fg-3); }
  .icp-identify-foot a { color: var(--icp-accent); text-decoration: none; }

  /* 4-Step Process Flowchart */
  .icp-flow {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 18px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .icp-flow-node { display: flex; flex-direction: column; gap: 10px; min-width: 0; }
  .icp-flow-head { display: flex; align-items: center; gap: 10px; }
  .icp-flow-badge {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--icp-fg-1);
    color: #ffffff;
    font-family: var(--icp-font-mono);
    font-size: 12px;
    font-weight: 600;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .icp-flow-tag {
    font-family: var(--icp-font-mono);
    font-size: 10.5px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--icp-accent);
  }
  .icp-flow-node h3 { margin: 0 0 4px; font-size: 15.5px; font-weight: 600; }
  .icp-flow-node p { margin: 0; font-size: 13.5px; color: var(--icp-fg-2); line-height: 1.5; }

  /* Dark FAQ Accordion */
  .icp-faq-list { display: flex; flex-direction: column; border-top: 1px solid rgba(255, 255, 255, 0.14); }
  .icp-faq-item { border-bottom: 1px solid rgba(255, 255, 255, 0.14); }
  .icp-faq-btn {
    width: 100%;
    background: transparent;
    border: 0;
    color: #ffffff;
    padding: 18px 0;
    text-align: left;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    font-size: 15.5px;
    font-weight: 500;
    cursor: pointer;
  }
  .icp-faq-icon { font-family: var(--icp-font-mono); font-size: 18px; color: rgba(255, 255, 255, 0.65); flex-shrink: 0; }
  .icp-faq-answer { display: none; padding: 0 0 18px; font-size: 14px; line-height: 1.6; color: rgba(255, 255, 255, 0.78); max-width: 76ch; }
  .icp-faq-item.is-open .icp-faq-answer { display: block; }

  /* Workshop & Internal Links Footer */
  .icp-footer-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); gap: 24px; align-items: start; }
  .icp-workshop-card, .icp-links-card {
    background: #ffffff;
    border: 1px solid var(--icp-line);
    border-radius: 10px;
    padding: 20px;
  }
  .icp-workshop-card h3 { margin: 6px 0 8px; font-size: 20px; font-weight: 600; }
  .icp-hours { display: grid; grid-template-columns: 110px 1fr; gap: 4px 12px; font-size: 13.5px; color: var(--icp-fg-2); margin-top: 12px; }
  .icp-links-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
  .icp-links-card h4 { margin: 0 0 8px; font-size: 13.5px; font-weight: 600; }
  .icp-links-card ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 6px; font-size: 13px; }
  .icp-links-card a { color: var(--icp-fg-2); text-decoration: none; }
  .icp-links-card a:hover { color: var(--icp-accent); text-decoration: underline; }

  @media (max-width: 960px) {
    .icp-trust-strip { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .icp-trust-cell:nth-child(1), .icp-trust-cell:nth-child(2) { border-bottom: 1px solid var(--icp-line); }
    .icp-trust-cell:nth-child(2), .icp-trust-cell:nth-child(4) { border-right: 0; }
    .icp-hero-grid, .icp-identify-grid, .icp-footer-grid, .icp-pillars, .icp-flow { grid-template-columns: minmax(0, 1fr); }
    .icp-warranty.is-open .icp-warranty-body { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 600px) {
    .icp-container { padding: 0 16px; }
    .icp-h1 { font-size: 30px; }
    .icp-h2 { font-size: 24px; }
    .icp-lead { font-size: 14.5px; }
    .icp-highlights { grid-template-columns: minmax(0, 1fr); }
    .icp-pillar-btn { padding: 13px 14px; cursor: pointer; }
    .icp-pillar-plus { display: inline-block; }
    .icp-pillar-body { display: none; padding: 0 14px 13px; font-size: 13px; }
    .icp-pillar.is-open .icp-pillar-body { display: block; }
    .icp-warranty-btn { padding: 16px; flex-direction: column; align-items: flex-start; gap: 10px; }
    .icp-checks, .icp-links-grid { grid-template-columns: minmax(0, 1fr); }
    .icp-identify-form { flex-direction: column; }
    .icp-identify-form .icp-btn-dark { width: 100%; }
