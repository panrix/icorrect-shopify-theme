          {%- assign diag_idx = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'diag_stage' -%}
              {%- assign diag_idx = diag_idx | plus: 1 -%}
              <li>
                <button
                  type="button"
                  class="icp-diag-step-btn{% if diag_idx == 1 %} is-active{% endif %}"
                  data-diag-index="{{ diag_idx }}"
                  data-diag-stage-label="0{{ diag_idx }} / 04"
                  data-diag-reading-key="{{ block.settings.reading_key | escape }}"
                  data-diag-reading-val="{{ block.settings.reading_val | escape }}"
                  data-diag-note-title="{{ block.settings.note_title | escape }}"
                  data-diag-note-body="{{ block.settings.note_body | escape }}"
                  aria-pressed="{% if diag_idx == 1 %}true{% else %}false{% endif %}"
                  {{ block.shopify_attributes }}>
                  <span class="icp-diag-num">0{{ diag_idx }}</span>
                  <div class="icp-diag-step-copy">
                    <span class="icp-diag-step-tag">{{ block.settings.tag | escape }}</span>
                    <h3>{{ block.settings.title | escape }}</h3>
                    <p>{{ block.settings.description | escape }}</p>
                  </div>
                </button>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ol>

        <div class="icp-inspector" aria-live="polite">
          <div class="icp-inspector-bar">
            <span>Fitzrovia Bench · Stage <strong data-inspector-stage>01 / 04</strong></span>
            <span class="icp-inspector-live"><span class="icp-reel-dot" aria-hidden="true"></span>In-House Bench</span>
          </div>
          <div class="icp-inspector-stage-img">
            {%- assign img_idx = 0 -%}
            {%- for block in section.blocks -%}
              {%- if block.type == 'diag_stage' -%}
                {%- assign img_idx = img_idx | plus: 1 -%}
                {%- assign stage_img = block.settings.image | default: 'macbook-bench-ammeter.webp' -%}
                <img
                  src="{{ stage_img | asset_url }}"
                  alt="{{ block.settings.image_alt | default: block.settings.title | escape }}"
                  data-inspector-img="{{ img_idx }}"
                  class="{% if img_idx == 1 %}is-active{% endif %}"
                  width="960"
                  height="720"
                  loading="lazy">
              {%- endif -%}
            {%- endfor -%}
            <div class="icp-inspector-reading">
              <strong data-inspector-rkey>USB-C Meter</strong>
              <span data-inspector-rval>20.08V / 0.000A</span>
            </div>
          </div>
          <div class="icp-inspector-foot">
            <strong data-inspector-title>What this reading tells our technician</strong>
            <p data-inspector-body>Before removing a single screw, power-delivery negotiation tells us whether the fault sits in the USB-C controller stage or deeper on the main power rails.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 7. Dark FAQ Accordion -->
  <section class="icp-section icp-section-dark" id="faqs">
    <div class="icp-container">
      <div class="icp-section-head">
        <span class="icp-mono" style="color:rgba(255,255,255,0.55);">Frequently Asked Questions</span>
        <h2 class="icp-h2">Straight answers before you book.</h2>
        <p class="icp-section-lead">{{ section.settings.faq_lead | escape }}</p>
      </div>
      <div class="icp-faq-list">
        {%- for block in section.blocks -%}
          {%- if block.type == 'faq' -%}
            <div class="icp-faq-item{% if forloop.first %} is-open{% endif %}" {{ block.shopify_attributes }}>
              <button type="button" class="icp-faq-btn" aria-expanded="{% if forloop.first %}true{% else %}false{% endif %}">
                <span>{{ block.settings.question | escape }}</span>
                <span class="icp-faq-icon">{% if forloop.first %}-{% else %}+{% endif %}</span>
              </button>
              <div class="icp-faq-answer">{{ block.settings.answer | escape }}</div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>

  <!-- 8. Fitzrovia Workshop & Cross-Links Across Top 3 Pillars -->
  <section class="icp-section icp-section-soft">
    <div class="icp-container icp-footer-grid">
      <div class="icp-workshop-card">
        <span class="icp-mono">Fitzrovia Workshop · Never Outsourced</span>
        <h3>iCorrect London</h3>
        <p style="margin:0;font-size:14px;color:var(--icp-fg-2);">12 Margaret Street, Audley House, Fitzrovia, London W1W 8JQ<br>Phone: 020 7099 8517 | Email: support@icorrect.co.uk</p>
        <div class="icp-hours">
          <strong>Mon to Thu</strong><span>9am to 6pm</span>
          <strong>Friday</strong><span>10am to 6pm</span>
          <strong>Sat &amp; Sun</strong><span>Closed</span>
        </div>
      </div>

      <div class="icp-links-grid">
        <div class="icp-links-card">
          <h4>Core MacBook Repairs</h4>
          <ul>
            <li><a href="/pages/macbook-liquid-damage-repair">MacBook Liquid Damage Repair</a></li>
            <li><a href="/pages/macbook-no-power-repair">Dead &amp; No Power MacBook Repair</a></li>
            <li><a href="/collections/macbook-screen-repair-prices">MacBook Screen Repair (Genuine Panel)</a></li>
            <li><a href="/pages/macbook-repairs">All MacBook Repairs Hub</a></li>
          </ul>
        </div>
        <div class="icp-links-card">
          <h4>More MacBook Services</h4>
          <ul>
            <li><a href="/pages/advanced-diagnostic">Advanced Logic Board Diagnostics</a></li>
            <li><a href="/collections/macbook-diagnostic-prices">MacBook Diagnostic Prices</a></li>
            <li><a href="/collections/macbook-battery-repair-prices">MacBook Battery Replacement</a></li>
            <li><a href="/pages/corporate-service">Corporate MacBook Repair Accounts</a></li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <a class="icp-floating-cta" id="icp-floating-cta" href="#quote-section" aria-label="Jump to diagnostic quote wizard">Get your quote &rarr;</a>
</div>

<script>
  (function () {
    if (window.__icpBound) return;
    window.__icpBound = true;

    /* Mobile accordions for 3 proof cards */
    document.querySelectorAll("[data-icp-pillar]").forEach(function (card) {
      var btn = card.querySelector(".icp-pillar-btn");
      var plus = card.querySelector(".icp-pillar-plus");
      if (!btn) return;
      btn.addEventListener("click", function () {
        if (window.innerWidth > 600) return;
        var open = !card.classList.contains("is-open");
        card.classList.toggle("is-open", open);
        btn.setAttribute("aria-expanded", String(open));
        if (plus) plus.textContent = open ? "-" : "+";
      });
    });

    /* Expandable comparison table */
    document.querySelectorAll("[data-icp-compare-toggle]").forEach(function (btn) {
      var id = btn.getAttribute("data-icp-compare-toggle");
      var card = document.getElementById("icp-compare-card-" + id);
      var label = document.querySelector("[data-icp-compare-label='" + id + "']");
      var icon = document.querySelector("[data-icp-compare-icon='" + id + "']");
      if (!card) return;
      btn.addEventListener("click", function () {
        var expanded = !card.classList.contains("is-expanded");
        card.classList.toggle("is-expanded", expanded);
        btn.setAttribute("aria-expanded", String(expanded));
        if (label) label.textContent = expanded ? "Show fewer comparisons" : "Show more comparisons";
        if (icon) icon.textContent = expanded ? "-" : "+";
      });
    });

    /* Expandable 2-year warranty card */
    function setWarranty(id, open) {
      var box = document.getElementById("icp-warranty-" + id);
      var btn = document.querySelector("[data-icp-warranty-toggle='" + id + "']");
      var label = document.querySelector("[data-icp-warranty-label='" + id + "']");
      var icon = document.querySelector("[data-icp-warranty-icon='" + id + "']");
      if (!box || !btn) return;
      box.classList.toggle("is-open", open);
      btn.setAttribute("aria-expanded", String(open));
      if (label) label.textContent = open ? "Hide details" : "See what's covered";
      if (icon) icon.textContent = open ? "-" : "+";
    }
    document.querySelectorAll("[data-icp-warranty-toggle]").forEach(function (btn) {
      var id = btn.getAttribute("data-icp-warranty-toggle");
      btn.addEventListener("click", function () {
        var box = document.getElementById("icp-warranty-" + id);
        setWarranty(id, !box.classList.contains("is-open"));
      });
    });

    /* Before / After case study toggle */
    document.querySelectorAll("[data-icp-case]").forEach(function (card) {
      var img = card.querySelector(".icp-case-media img");
      var badge = card.querySelector("[data-case-badge]");
      var btns = card.querySelectorAll("[data-ba-mode]");
      if (!img || !btns.length) return;
      btns.forEach(function (btn) {
        btn.addEventListener("click", function () {
          var mode = btn.getAttribute("data-ba-mode");
          var nextSrc = mode === "after" ? img.getAttribute("data-after-src") : img.getAttribute("data-before-src");
          if (nextSrc) img.setAttribute("src", nextSrc);
          if (badge && btn.getAttribute("data-badge-text")) {
            badge.textContent = btn.getAttribute("data-badge-text");
          }
          btns.forEach(function (b) { b.classList.toggle("is-active", b === btn); });
        });
      });
    });

    /* Click-to-play Fitzrovia repair walkthrough reel */
    document.querySelectorAll("[data-icp-reel-wrap]").forEach(function (wrap) {
      var cover = wrap.querySelector("[data-icp-reel-play]");
      var video = wrap.querySelector("video");
      if (!cover || !video) return;
      cover.addEventListener("click", function () {
        cover.classList.add("is-hidden");
        video.play().catch(function () {});
      });
    });

    /* Interactive 4-stage logic board fault-finding inspector */
    document.querySelectorAll("[data-icp-diag]").forEach(function (root) {
      var btns = root.querySelectorAll("[data-diag-index]");
      var imgs = root.querySelectorAll("[data-inspector-img]");
      var stageEl = root.querySelector("[data-inspector-stage]");
      var rKey = root.querySelector("[data-inspector-rkey]");
      var rVal = root.querySelector("[data-inspector-rval]");
      var titleEl = root.querySelector("[data-inspector-title]");
      var bodyEl = root.querySelector("[data-inspector-body]");
      function activate(btn) {
        var idx = btn.getAttribute("data-diag-index");
        btns.forEach(function (b) {
          var on = b === btn;
          b.classList.toggle("is-active", on);
          b.setAttribute("aria-pressed", String(on));
        });
        imgs.forEach(function (im) {
          im.classList.toggle("is-active", im.getAttribute("data-inspector-img") === idx);
        });
        if (stageEl) stageEl.textContent = btn.getAttribute("data-diag-stage-label") || "";
        if (rKey) rKey.textContent = btn.getAttribute("data-diag-reading-key") || "";
        if (rVal) rVal.textContent = btn.getAttribute("data-diag-reading-val") || "";
        if (titleEl) titleEl.textContent = btn.getAttribute("data-diag-note-title") || "";
        if (bodyEl) bodyEl.textContent = btn.getAttribute("data-diag-note-body") || "";
      }
      if (btns.length) activate(btns[0]);
      btns.forEach(function (btn) {
        btn.addEventListener("click", function () { activate(btn); });
      });
    });

    /* FAQ accordion */
    document.querySelectorAll(".icp-faq-btn").forEach(function (btn) {
      btn.addEventListener("click", function () {
        var item = btn.closest(".icp-faq-item");
        var open = !item.classList.contains("is-open");
        item.classList.toggle("is-open", open);
        btn.setAttribute("aria-expanded", String(open));
        var ic = btn.querySelector(".icp-faq-icon");
        if (ic) ic.textContent = open ? "-" : "+";
      });
    });

    /* Scroll-aware matte dark floating CTA (ICO-11 v10) */
    var floatingCta = document.getElementById("icp-floating-cta");
    var heroEl = document.querySelector(".icp-hero");
    var quoteEl = document.getElementById("quote-section");
    if (floatingCta && heroEl) {
      function updateFloat() {
        var heroBottom = heroEl.getBoundingClientRect().bottom;
        var quoteNear = false;
        if (quoteEl) {
          var qr = quoteEl.getBoundingClientRect();
          quoteNear = qr.top < window.innerHeight * 0.7 && qr.bottom > 120;
        }
        floatingCta.classList.toggle("is-visible", heroBottom < 80 && !quoteNear);
      }
      window.addEventListener("scroll", updateFloat, { passive: true });
      window.addEventListener("resize", updateFloat, { passive: true });
      updateFloat();
    }

    /* Find your model code matcher */
    var MODELS = [
      { code: "A3240", name: 'MacBook Air 13" M4 (2025)' },
      { code: "A3113", name: 'MacBook Air 13" M3 (2024)' },
      { code: "A2681", name: 'MacBook Air 13" M2 (2022)' },
      { code: "A2337", name: 'MacBook Air 13" M1 (2020)' },
      { code: "A2179", name: 'MacBook Air 13" (2020)' },
      { code: "A1932", name: 'MacBook Air 13" (2018-2019)' },
      { code: "A3241", name: 'MacBook Air 15" M4 (2025)' },
      { code: "A3114", name: 'MacBook Air 15" M3 (2024)' },
      { code: "A2941", name: 'MacBook Air 15" M2 (2023)' },
      { code: "A2338", name: 'MacBook Pro 13" M1 / M2 (2020-2022)' },
      { code: "A2289", name: 'MacBook Pro 13" (2020)' },
      { code: "A2251", name: 'MacBook Pro 13" (2020)' },
      { code: "A3112", name: 'MacBook Pro 14" M4 (2024)' },
      { code: "A2992", name: 'MacBook Pro 14" M3 Pro/Max (2023)' },
      { code: "A2918", name: 'MacBook Pro 14" M3 (2023)' },
      { code: "A2779", name: 'MacBook Pro 14" M2 Pro/Max (2023)' },
      { code: "A2442", name: 'MacBook Pro 14" M1 Pro/Max (2021)' },
      { code: "A3403", name: 'MacBook Pro 16" M4 Pro/Max (2024)' },
      { code: "A3186", name: 'MacBook Pro 16" M4 Pro/Max (2024)' },
      { code: "A2991", name: 'MacBook Pro 16" M3 Pro/Max (2023)' },
      { code: "A2780", name: 'MacBook Pro 16" M2 Pro/Max (2023)' },
      { code: "A2485", name: 'MacBook Pro 16" M1 Pro/Max (2021)' },
      { code: "A2141", name: 'MacBook Pro 16" (2019)' }
    ];
    document.querySelectorAll("[data-icp-identify-form]").forEach(function (form) {
      var id = form.getAttribute("data-icp-identify-form");
      var input = form.querySelector("input");
      var out = document.querySelector("[data-icp-identify-result='" + id + "']");
      form.addEventListener("submit", function (e) {
        e.preventDefault();
        var raw = (input.value || "").trim().toUpperCase();
        if (!raw || !out) return;
        var match = MODELS.find(function (m) { return m.code === raw || raw.indexOf(m.code) !== -1; });
        out.classList.add("is-visible");
        if (match) {
          out.innerHTML = '<span><strong>' + match.name + ' (' + match.code + ')</strong> matched</span><a class="icp-btn-dark" style="min-height:34px;padding:6px 12px;font-size:13px;" href="#quote-section">Select in quote wizard &rarr;</a>';
        } else {
          out.innerHTML = '<span>Could not match <strong>' + raw.replace(/[<>&"]/g, "") + '</strong> directly. Select your model in the <a href="#quote-section" style="color:#0b63ce;font-weight:500;">quote wizard above</a>.</span>';
        }
      });
    });
  })();
</script>
{%- endif -%}

