{%- comment -%}
  sections/macbook-pillar-page.liquid
  Reusable editorial section for high-intent MacBook pillar money pages
  (e.g. /pages/macbook-liquid-damage-repair, /pages/macbook-no-power-repair).
  Aligned with ICO-11 v10 design system (trust bar below hero, Fitzrovia Never Outsourced,
  styled live Trustindex reviews, compact expandable logistics bar, real Fitzrovia bench
  case studies with Before/After + Ricky's repair walkthrough video, and interactive
  4-stage logic board fault-finding breakdown).
  Render once above sections/quote-wizard (part = "top") and once below (part = "bottom")
  so the untouched Shopify quote wizard sits in the validated value-first slot.
{%- endcomment -%}

{%- assign part = section.settings.part | default: 'top' -%}
{%- assign sid = section.id -%}

{%- if part == 'top' -%}
<style>
  .icp-root {
    --icp-bg-1: #ffffff;
    --icp-bg-2: #fafafa;
    --icp-bg-3: #f4f4f5;
    --icp-fg-1: #171717;
    --icp-fg-2: #4d4d4d;
    --icp-fg-3: #666666;
    --icp-fg-4: #808080;
    --icp-line: rgba(0, 0, 0, 0.08);
    --icp-line-strong: rgba(0, 0, 0, 0.16);
    --icp-accent: #0b63ce;
    --icp-accent-hover: #0952ab;
    --icp-accent-soft: #eff6ff;
    --icp-accent-border: #bfdbfe;
    --icp-green: #047857;
    --icp-green-dot: #10b981;
    --icp-star: #f59e0b;
    --icp-shadow-card: 0 0 0 1px rgba(0, 0, 0, 0.08), 0 2px 4px rgba(0, 0, 0, 0.03);
    --icp-font-sans: "Geist", -apple-system, BlinkMacSystemFont, "Helvetica Neue", Arial, sans-serif;
    --icp-font-mono: "Geist Mono", ui-monospace, SFMono-Regular, Menlo, Monaco, monospace;
    font-family: var(--icp-font-sans);
    color: var(--icp-fg-1);
    line-height: 1.5;
    font-size: 15px;
    -webkit-font-smoothing: antialiased;
    overflow-x: clip;
  }
  .icp-root *, .icp-root *::before, .icp-root *::after { box-sizing: border-box; }
  .icp-root img, .icp-root svg, .icp-root video { display: block; max-width: 100%; }
  .icp-container {
    width: 100%;
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 24px;
  }
  .icp-mono {
    font-family: var(--icp-font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--icp-fg-3);
  }
  .icp-btn-dark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 8px 18px;
    min-height: 42px;
    border-radius: 6px;
    background: #111827;
    color: #ffffff !important;
    border: 1px solid #111827;
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    cursor: pointer;
    white-space: nowrap;
    transition: background 140ms ease;
  }
  .icp-btn-dark:hover { background: #1f2937; }
  .icp-btn-ghost {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 6px 12px;
    min-height: 36px;
    border-radius: 999px;
    border: 1px solid #e2e5ea;
    background: #f5f6f8;
    color: #1f2937 !important;
    font-size: 13px;
    font-weight: 500;
    text-decoration: none;
    cursor: pointer;
    white-space: nowrap;
    transition: border-color 140ms ease, background 140ms ease, color 140ms ease;
  }
  .icp-btn-ghost:hover { border-color: #cbd5e1; background: #eceef2; color: #111827 !important; }

  /* Floating Scroll-Aware CTA (ICO-11 v10) */
  .icp-floating-cta {
    position: fixed;
    right: 24px;
    bottom: 24px;
    z-index: 60;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    height: 48px;
    padding: 0 22px;
    border-radius: 999px;
    background: #111827;
    color: #ffffff !important;
    border: 1px solid rgba(255, 255, 255, 0.12);
    font-family: var(--icp-font-sans);
    font-size: 14.5px;
    font-weight: 500;
    letter-spacing: -0.01em;
    text-decoration: none;
    white-space: nowrap;
    box-shadow: 0 12px 28px rgba(17, 24, 39, 0.28), 0 2px 8px rgba(0, 0, 0, 0.16);
    opacity: 0;
    transform: translateY(14px);
    pointer-events: none;
    visibility: hidden;
    transition: opacity 220ms ease, transform 220ms ease, visibility 220ms ease, background 140ms ease;
  }
  .icp-floating-cta:hover { background: #1f2937; }
  .icp-floating-cta.is-visible {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
    visibility: visible;
  }

  /* 1. HERO BAND */
  .icp-hero {
    padding: 24px 0 40px;
    background: #ffffff;
    border-bottom: 1px solid var(--icp-line);
  }
  .icp-breadcrumb {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    margin-bottom: 16px;
    font-family: var(--icp-font-mono);
    font-size: 11px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: #6b7280;
  }
  .icp-breadcrumb a { color: #6b7280; text-decoration: none; }
  .icp-breadcrumb a:hover { color: #111827; }
  .icp-breadcrumb-current { color: #111827; font-weight: 500; }

  .icp-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.04fr);
    column-gap: 40px;
    row-gap: 0;
    align-items: center;
  }
  .icp-hero-grid > * { min-width: 0; }
  .icp-hero-grid > .icp-trust-strip { grid-column: 1 / -1; }
  .icp-h1 {
    margin: 0 0 10px;
    font-size: 44px;
    font-weight: 600;
    line-height: 1.06;
    letter-spacing: -0.04em;
    color: var(--icp-fg-1);
    text-wrap: balance;
  }
  .icp-lead {
    margin: 0 0 18px;
    font-size: 16.5px;
    line-height: 1.5;
    color: var(--icp-fg-2);
    max-width: 48ch;
    text-wrap: pretty;
  }
  /* Calm Neutral Hardware Spec Tiles (ICO-11 v11/v12) */
  .icp-spec-strip {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
    list-style: none;
    margin: 0;
    padding: 0;
    width: 100%;
  }
  .icp-spec-strip li { min-width: 0; }
  .icp-spec-tile {
    width: 100%;
    text-align: left;
    padding: 10px 12px;
    border-radius: 6px;
    border: 1px solid #d1d5db;
    background: linear-gradient(180deg, #f8f9fa 0%, #f1f3f5 100%);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.85), 0 1px 2px rgba(0, 0, 0, 0.03);
    text-decoration: none;
    display: flex;
    flex-direction: column;
    gap: 2px;
    color: inherit;
    transition: border-color 140ms ease, background 140ms ease, box-shadow 140ms ease;
  }
  .icp-spec-tile:hover {
    border-color: #9ca3af;
    background: linear-gradient(180deg, #ffffff 0%, #f3f4f6 100%);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.95), 0 3px 10px rgba(17, 24, 39, 0.07);
  }
  .icp-spec-label {
    font-size: 12px;
    font-weight: 500;
    color: #4b5563;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .icp-spec-val {
    font-size: 14.5px;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: #111827;
  }
  .icp-note { margin: 9px 0 0; font-size: 12px; color: var(--icp-fg-3); }
  .icp-cta-row {
    margin-top: 15px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
  }

  /* Right Hero Isometric Logic Board Diagram Stage (ICO-11 v12) */
  .icp-diagram-stage {
    background: #f8fafc;
    border: 1px solid #e5e7eb;
    border-radius: 16px;
    padding: 14px 18px 16px;
    width: 100%;
  }
  .icp-diagram-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 6px;
    flex-wrap: wrap;
  }
  .icp-stage-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 3px 9px;
    border-radius: 999px;
    background: #eff6ff;
    border: 1px solid #bfdbfe;
    font-family: var(--icp-font-mono);
    font-size: 10.5px;
    font-weight: 500;
    color: var(--icp-accent);
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }
  .icp-stage-pill-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--icp-accent);
  }
  .icp-diagram-frame {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
  }
  .icp-diagram-frame img {
    width: 100%;
    max-width: 520px;
    height: auto;
    object-fit: contain;
    margin: 0 auto;
  }
  .icp-diagram-caption {
    margin-top: 8px;
    padding-top: 10px;
    border-top: 1px solid var(--icp-line);
    display: flex;
    align-items: flex-start;
    gap: 8px;
    font-size: 12px;
    line-height: 1.45;
    color: var(--icp-fg-3);
  }
  .icp-caption-swatch {
    width: 10px;
    height: 10px;
    border-radius: 2px;
    background: #38598C;
    flex-shrink: 0;
    margin-top: 3px;
  }

  /* 4-BADGE TRUST STRIP: DIRECTLY BELOW HERO, ABOVE 3 PROOF CARDS (ICO-11 v10) */
  .icp-trust-strip {
    margin: 28px 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.03);
    overflow: hidden;
  }
  .icp-trust-cell {
    padding: 13px 16px;
    display: flex;
    align-items: center;
    gap: 11px;
    border-right: 1px solid #e5e7eb;
    min-width: 0;
  }
  .icp-trust-cell:last-child { border-right: 0; }
  .icp-trust-link {
    display: flex;
    align-items: center;
    gap: 11px;
    text-decoration: none;
    color: inherit;
    width: 100%;
    min-width: 0;
  }
  .icp-trust-link:hover .icp-trust-icon { border-color: #cbd5e1; background: #ffffff; }
  .icp-trust-icon {
    width: 30px;
    height: 30px;
    border-radius: 8px;
    background: #f8fafc;
    border: 1px solid #e5e7eb;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: #111827;
    transition: border-color 140ms ease, background 140ms ease;
  }
  .icp-trust-copy { display: flex; flex-direction: column; gap: 1px; min-width: 0; }
  .icp-trust-copy strong { font-size: 13px; font-weight: 600; letter-spacing: -0.015em; color: #111827; line-height: 1.25; }
  .icp-trust-copy span { font-size: 11.5px; color: #6b7280; line-height: 1.25; }
  .icp-trust-rating-title { display: inline-flex; align-items: center; gap: 5px; flex-wrap: nowrap; }
  .icp-trust-stars-inline { display: inline-flex; align-items: center; gap: 1.5px; line-height: 1; transform: translateY(-0.5px); }

  /* 3 Board-Level Proof Cards (Desktop cards, Mobile compact accordions) */
  .icp-pillars {
    margin-top: 14px;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }
  .icp-pillar {
    background: var(--icp-bg-2);
    border: 1px solid var(--icp-line);
    border-radius: 10px;
    overflow: hidden;
  }
  .icp-pillar-btn {
    width: 100%;
    border: 0;
    background: transparent;
    padding: 15px 16px 6px;
    text-align: left;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    cursor: default;
  }
  .icp-pillar-title { font-size: 14.5px; font-weight: 600; color: var(--icp-fg-1); line-height: 1.3; }
  .icp-pillar-plus { display: none; font-family: var(--icp-font-mono); font-size: 16px; color: var(--icp-fg-3); flex-shrink: 0; }
  .icp-pillar-body { padding: 0 16px 15px; font-size: 13.5px; color: var(--icp-fg-2); line-height: 1.5; }
  .icp-pillar-body p { margin: 0; }

  /* Board-Level Fitzrovia Workshop + UK Courier Isometric Section (ICO-11 v12) */
  .icp-workshop-block { margin-top: 48px; }
  .icp-visual-pair {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }
  .icp-visual-card {
    background: #ffffff;
    border: 1px solid var(--icp-line);
    border-radius: 14px;
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    box-shadow: var(--icp-shadow-card);
    min-width: 0;
  }
  .icp-visual-card-img {
    background: var(--icp-bg-2);
    border-radius: 10px;
    padding: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 210px;
  }
  .icp-visual-card-img img {
    max-height: 200px;
    width: auto;
    height: auto;
  }
  .icp-visual-card h3 {
    margin: 4px 0 4px;
    font-size: 18px;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--icp-fg-1);
  }
  .icp-visual-card p {
    margin: 0;
    font-size: 14px;
    color: var(--icp-fg-2);
    line-height: 1.5;
  }

  /* Sections */
  .icp-section { padding: 54px 0; border-bottom: 1px solid var(--icp-line); background: var(--icp-bg-1); }
  .icp-section-soft { background: var(--icp-bg-2); }
  .icp-section-dark { background: #171717; color: #ffffff; border-bottom: 1px solid rgba(255, 255, 255, 0.1); }
  .icp-section-head { max-width: 700px; margin-bottom: 26px; }
  .icp-h2 {
    margin: 6px 0 8px;
    font-size: 30px;
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.035em;
    color: var(--icp-fg-1);
    text-wrap: balance;
  }
  .icp-section-dark .icp-h2 { color: #ffffff; }
  .icp-section-lead { margin: 0; font-size: 15.5px; color: var(--icp-fg-2); line-height: 1.55; }
  .icp-section-dark .icp-section-lead { color: rgba(255, 255, 255, 0.72); }

  /* 2. VERIFIED GOOGLE REVIEWS (STYLED LIVE TRUSTINDEX - ICO-11 v10) */
  .icp-reviews-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 14px;
    flex-wrap: wrap;
    margin-bottom: 18px;
  }
  .icp-reviews-head-main { display: flex; align-items: center; gap: 12px; min-width: 0; }
  .icp-reviews-g-badge {
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: #ffffff;
    border: 1px solid #e5e7eb;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.03);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .icp-reviews-title-row { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; margin-top: 2px; }
  .icp-reviews-stars-pill {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    padding: 4px 8px;
    border-radius: 999px;
    background: #ffffff;
    border: 1px solid #e5e7eb;
    line-height: 1;
  }
  .icp-trustindex-slot { width: 100%; min-height: 240px; overflow-x: clip; }
  .icp-reviews-wrap .ti-widget,
  .icp-reviews-wrap .ti-widget * { font-family: var(--icp-font-sans) !important; }
  .icp-reviews-wrap .ti-widget .ti-widget-header,
  .icp-reviews-wrap .ti-widget .ti-header { display: none !important; }
  .icp-reviews-wrap .ti-widget .ti-widget-container { margin-top: 0 !important; margin-bottom: 0 !important; }
  .icp-reviews-wrap .ti-widget .ti-reviews-container { margin-top: 0 !important; }
  .icp-reviews-wrap .ti-widget .ti-reviews-container-wrapper { padding-top: 4px !important; padding-bottom: 12px !important; }
  .icp-reviews-wrap .ti-widget .ti-review-item > .ti-inner {
    background: #ffffff !important;
    border: 1px solid #e5e7eb !important;
    border-radius: 16px !important;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.03), 0 4px 14px rgba(0, 0, 0, 0.03) !important;
    padding: 20px 22px !important;
  }
  .icp-reviews-wrap .ti-widget .ti-name { font-size: 14px !important; font-weight: 600 !important; color: #111827 !important; }
  .icp-reviews-wrap .ti-widget .ti-date { font-size: 12px !important; color: #6b7280 !important; }
  .icp-reviews-wrap .ti-widget .ti-review-content { font-size: 14px !important; line-height: 1.55 !important; color: #374151 !important; }
  .icp-reviews-wrap .ti-widget .ti-read-more,
  .icp-reviews-wrap .ti-widget .ti-read-more span { font-size: 12.5px !important; font-weight: 500 !important; color: var(--icp-accent) !important; opacity: 1 !important; }
  .icp-reviews-wrap .ti-widget .ti-controls .ti-prev,
  .icp-reviews-wrap .ti-widget .ti-controls .ti-next {
    background: #ffffff !important;
    border: 1px solid #e5e7eb !important;
    border-radius: 999px !important;
    width: 34px !important;
    height: 34px !important;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08) !important;
  }
  .icp-reviews-wrap .ti-widget .ti-controls-line { background: #e5e7eb !important; height: 3px !important; border-radius: 999px !important; margin-top: 8px !important; }
  .icp-reviews-wrap .ti-widget .ti-controls-line .dot { background: #111827 !important; height: 3px !important; border-radius: 999px !important; }

  /* 3. EXPANDABLE COMPARISON TABLE + 2-YEAR WARRANTY */
  .icp-compare-card {
    border: 1px solid var(--icp-line);
    border-radius: 10px;
    background: #ffffff;
    box-shadow: var(--icp-shadow-card);
    overflow: hidden;
  }
  .icp-compare-scroll { overflow-x: auto; }
  .icp-compare-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13.5px;
    text-align: left;
  }
  .icp-compare-table th, .icp-compare-table td {
    padding: 12px 16px;
    border-bottom: 1px solid var(--icp-line);
    vertical-align: top;
  }
  .icp-compare-table th {
    font-family: var(--icp-font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--icp-fg-3);
    background: var(--icp-bg-2);
  }
  .icp-compare-table th.is-icorrect,
  .icp-compare-table td.is-icorrect {
    background: #f8fbff;
    color: var(--icp-fg-1);
    font-weight: 500;
  }
  .icp-extra-row { display: none; }
  .icp-compare-card.is-expanded .icp-extra-row { display: table-row; }
  .icp-expand-btn {
    width: 100%;
    border: 0;
    background: var(--icp-bg-2);
    color: var(--icp-fg-1);
    padding: 12px 16px;
    font-size: 13.5px;
    font-weight: 500;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    cursor: pointer;
    transition: background 140ms ease;
  }
  .icp-expand-btn:hover { background: var(--icp-bg-3); }

  /* Expandable 2-Year Warranty */
  .icp-warranty {
    margin-top: 16px;
    background: #ffffff;
    border: 1px solid var(--icp-line);
    border-radius: 10px;
    box-shadow: var(--icp-shadow-card);
    overflow: hidden;
  }
  .icp-warranty-btn {
    width: 100%;
    border: 0;
    background: transparent;
    padding: 18px 22px;
    text-align: left;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    cursor: pointer;
    transition: background 140ms ease;
  }
  .icp-warranty-btn:hover { background: var(--icp-bg-2); }
  .icp-warranty-btn h3 { margin: 4px 0 0; font-size: 19px; font-weight: 600; letter-spacing: -0.025em; color: var(--icp-fg-1); }
  .icp-warranty-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    border-radius: 6px;
    border: 1px solid var(--icp-line-strong);
    background: #ffffff;
    font-size: 12.5px;
    font-weight: 500;
    color: var(--icp-fg-1);
    white-space: nowrap;
    flex-shrink: 0;
  }
  .icp-warranty-body {
    display: none;
    padding: 0 22px 20px;
    border-top: 1px solid var(--icp-line);
  }
  .icp-warranty.is-open .icp-warranty-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    gap: 18px 24px;
    align-items: center;
    padding-top: 16px;
  }
  .icp-warranty-body p { margin: 0; font-size: 13.5px; color: var(--icp-fg-2); line-height: 1.55; }
  .icp-checks {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px 14px;
    font-size: 13.5px;
    color: var(--icp-fg-2);
  }
  .icp-checks li { display: flex; align-items: flex-start; gap: 7px; }
  .icp-check-mark { color: var(--icp-green); font-weight: 600; flex-shrink: 0; }

  /* 4. FIND YOUR MODEL (Ricky's exact Claude Code container) */
  .icp-identify { padding: 56px 0; border-bottom: 1px solid var(--icp-line); background: var(--icp-bg-1); }
  .icp-identify-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 48px;
    align-items: center;
  }
  .icp-identify-grid > * { min-width: 0; }
  .icp-identify-visual {
    background: #e5e7eb;
    border-radius: 16px;
    padding: 40px 28px;
    border: 1px solid var(--icp-line);
    aspect-ratio: 4 / 3;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .icp-identify-plate {
    background: #e5e5e5;
    padding: 16px 20px;
    border-radius: 6px;
    font-family: var(--icp-font-mono);
    color: #4d4d4d;
    display: flex;
    flex-direction: column;
    gap: 4px;
    border: 1px solid rgba(0, 0, 0, 0.1);
  }
  .icp-plate-line { font-size: 11px; }
  .icp-plate-line.is-muted { color: #737373; }
  .icp-plate-line.is-small { font-size: 9.5px; }
  .icp-plate-line.is-hl { font-size: 13px; color: #171717; margin-top: 6px; }
  .icp-plate-badge {
    background: #ffffff;
    padding: 2px 6px;
    border-radius: 3px;
    border: 2px solid #171717;
    color: #171717;
    font-weight: 600;
  }
  .icp-identify-hint { margin-top: 14px; font-size: 11px; color: #171717; }
  .icp-identify-form { display: flex; gap: 8px; max-width: 420px; margin-top: 16px; }
  .icp-identify-form input {
    flex: 1;
    min-width: 0;
    padding: 11px 14px;
    border: 1px solid var(--icp-line-strong);
    border-radius: 8px;
    background: #ffffff;
    font-size: 15px;
    color: var(--icp-fg-1);
  }
  .icp-identify-result {
    margin-top: 12px;
    max-width: 420px;
    padding: 12px 14px;
    border-radius: 8px;
    border: 1px solid var(--icp-line-strong);
    background: var(--icp-bg-2);
    font-size: 13.5px;
    display: none;
  }
  .icp-identify-result.is-visible { display: flex; align-items: center; justify-content: space-between; gap: 10px; flex-wrap: wrap; }
  .icp-identify-foot { margin-top: 12px; font-size: 13px; color: var(--icp-fg-3); }
  .icp-identify-foot a { color: var(--icp-accent); text-decoration: none; }

  /* 5. FROM OUR FITZROVIA BENCH: REAL REPAIR CASE STUDIES + VIDEO WALKTHROUGH */
  .icp-cases-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }
  .icp-case-card {
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 14px;
    overflow: hidden;
    box-shadow: var(--icp-shadow-card);
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .icp-case-media {
    position: relative;
    aspect-ratio: 4 / 3;
    background: #0f172a;
    overflow: hidden;
  }
  .icp-case-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .icp-case-media-badge {
    position: absolute;
    bottom: 12px;
    left: 12px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    border-radius: 999px;
    background: rgba(17, 24, 39, 0.86);
    backdrop-filter: blur(6px);
    border: 1px solid rgba(255, 255, 255, 0.16);
    font-family: var(--icp-font-mono);
    font-size: 10.5px;
    font-weight: 500;
    color: #ffffff;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    max-width: calc(100% - 165px);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .icp-ba-switch {
    position: absolute;
    right: 12px;
    bottom: 12px;
    display: inline-flex;
    padding: 3px;
    border-radius: 999px;
    background: rgba(17, 24, 39, 0.86);
    backdrop-filter: blur(6px);
    border: 1px solid rgba(255, 255, 255, 0.18);
    gap: 3px;
  }
  .icp-ba-btn {
    border: 0;
    background: transparent;
    color: rgba(255, 255, 255, 0.78);
    font-family: var(--icp-font-mono);
    font-size: 10.5px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 5px 10px;
    border-radius: 999px;
    cursor: pointer;
    transition: background 140ms ease, color 140ms ease;
  }
  .icp-ba-btn.is-active { background: #ffffff; color: #111827; }
  .icp-case-body {
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    flex: 1;
  }
  .icp-case-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    flex-wrap: wrap;
  }
  .icp-case-model {
    font-family: var(--icp-font-mono);
    font-size: 11px;
    font-weight: 600;
    color: var(--icp-accent);
    background: var(--icp-accent-soft);
    border: 1px solid var(--icp-accent-border);
    padding: 3px 8px;
    border-radius: 999px;
  }
  .icp-case-status {
    font-family: var(--icp-font-mono);
    font-size: 10.5px;
    font-weight: 600;
    color: var(--icp-green);
    background: #e6f6ec;
    padding: 3px 8px;
    border-radius: 999px;
  }
  .icp-case-card h3 {
    margin: 0;
    font-size: 18px;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: #111827;
    line-height: 1.25;
  }
  .icp-case-rows {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
    border-top: 1px solid var(--icp-line);
    padding-top: 12px;
  }
  .icp-case-rows li {
    display: grid;
    grid-template-columns: 92px minmax(0, 1fr);
    gap: 10px;
    font-size: 13px;
    line-height: 1.45;
  }
  .icp-case-rows dt,
  .icp-case-row-label {
    font-family: var(--icp-font-mono);
    font-size: 10.5px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--icp-fg-3);
    padding-top: 2px;
  }
  .icp-case-row-val { color: var(--icp-fg-2); }
  .icp-case-row-val strong { color: #111827; font-weight: 600; }

  /* Behind-the-Scenes Workshop Reel Strip */
  .icp-reel-card {
    margin-top: 20px;
    background: #111827;
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 16px;
    padding: 24px;
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: 28px;
    align-items: center;
  }
  .icp-reel-card > * { min-width: 0; }
  .icp-reel-kicker {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 4px 10px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.14);
    font-family: var(--icp-font-mono);
    font-size: 10.5px;
    color: #93c5fd;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .icp-reel-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--icp-green-dot); }
  .icp-reel-card h3 {
    margin: 12px 0 8px;
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.2;
    color: #ffffff;
  }
  .icp-reel-card p { margin: 0 0 14px; font-size: 14px; line-height: 1.55; color: rgba(255, 255, 255, 0.78); }
  .icp-reel-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
    margin: 0 0 18px;
    padding: 0;
  }
  .icp-reel-tags li {
    padding: 5px 10px;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.12);
    font-family: var(--icp-font-mono);
    font-size: 11px;
    color: rgba(255, 255, 255, 0.9);
  }
  .icp-reel-player-wrap {
    position: relative;
    border-radius: 12px;
    overflow: hidden;
    background: #000000;
    border: 1px solid rgba(255, 255, 255, 0.16);
    aspect-ratio: 4 / 3;
  }
  .icp-reel-player-wrap video {
    width: 100%;
    height: 100%;
    object-fit: contain;
    background: #0b0f19;
  }
  .icp-reel-cover {
    position: absolute;
    inset: 0;
    border: 0;
    padding: 0;
    background: transparent;
    cursor: pointer;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .icp-reel-cover img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.76);
    transition: transform 240ms ease, filter 240ms ease;
  }
  .icp-reel-cover:hover img { transform: scale(1.02); filter: brightness(0.84); }
  .icp-reel-play-pill {
    position: relative;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 12px 18px;
    border-radius: 999px;
    background: rgba(17, 24, 39, 0.9);
    border: 1px solid rgba(255, 255, 255, 0.25);
    color: #ffffff;
    font-size: 13.5px;
    font-weight: 600;
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.4);
  }
  .icp-reel-cover.is-hidden { display: none; }

  /* 6. INTERACTIVE 4-STAGE FAULT-FINDING BENCH BREAKDOWN (REPLACES GENERIC PROCESS) */
  .icp-diag-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    gap: 24px;
    align-items: start;
  }
  .icp-diag-grid > * { min-width: 0; }
  .icp-diag-steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .icp-diag-step-btn {
    width: 100%;
    text-align: left;
    padding: 16px 18px;
    border-radius: 12px;
    border: 1px solid #e5e7eb;
    background: #ffffff;
    cursor: pointer;
    display: flex;
    align-items: flex-start;
    gap: 14px;
    transition: border-color 140ms ease, box-shadow 140ms ease, background 140ms ease;
  }
  .icp-diag-step-btn:hover { border-color: #cbd5e1; background: #fcfcfd; }
  .icp-diag-step-btn.is-active {
    border-color: var(--icp-accent);
    background: #f8fbff;
    box-shadow: 0 0 0 1px var(--icp-accent), 0 8px 20px -10px rgba(11, 99, 206, 0.22);
  }
  .icp-diag-num {
    width: 30px;
    height: 30px;
    border-radius: 8px;
    background: #f4f4f5;
    border: 1px solid #e5e7eb;
    color: #111827;
    font-family: var(--icp-font-mono);
    font-size: 11.5px;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 1px;
  }
  .icp-diag-step-btn.is-active .icp-diag-num {
    background: var(--icp-accent);
    border-color: var(--icp-accent);
    color: #ffffff;
  }
  .icp-diag-step-copy { min-width: 0; flex: 1; }
  .icp-diag-step-tag {
    display: inline-block;
    font-family: var(--icp-font-mono);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--icp-accent);
    margin-bottom: 3px;
  }
  .icp-diag-step-copy h3 {
    margin: 0 0 4px;
    font-size: 15.5px;
    font-weight: 600;
    color: #111827;
    line-height: 1.25;
  }
  .icp-diag-step-copy p {
    margin: 0;
    font-size: 13px;
    color: var(--icp-fg-2);
    line-height: 1.5;
  }

  /* Live Bench Inspector Panel */
  .icp-inspector {
    background: #0f172a;
    border: 1px solid #1e293b;
    border-radius: 16px;
    overflow: hidden;
    color: #ffffff;
    box-shadow: 0 18px 40px -20px rgba(15, 23, 42, 0.45);
    position: sticky;
    top: 76px;
  }
  .icp-inspector-bar {
    padding: 12px 16px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    font-family: var(--icp-font-mono);
    font-size: 10.5px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: rgba(255, 255, 255, 0.72);
  }
  .icp-inspector-live {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: #34d399;
  }
  .icp-inspector-stage-img {
    position: relative;
    aspect-ratio: 4 / 3;
    background: #020617;
    overflow: hidden;
  }
  .icp-inspector-stage-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: none;
  }
  .icp-inspector-stage-img img.is-active { display: block; }
  .icp-inspector-reading {
    position: absolute;
    left: 12px;
    bottom: 12px;
    right: 12px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    flex-wrap: wrap;
    padding: 9px 12px;
    border-radius: 10px;
    background: rgba(2, 6, 23, 0.84);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.15);
    font-family: var(--icp-font-mono);
    font-size: 11px;
  }
  .icp-inspector-reading strong { color: #38bdf8; font-weight: 600; }
  .icp-inspector-reading span { color: rgba(255, 255, 255, 0.84); }
  .icp-inspector-foot {
    padding: 16px 18px 18px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .icp-inspector-foot strong { font-size: 14.5px; font-weight: 600; color: #ffffff; }
  .icp-inspector-foot p { margin: 0; font-size: 13px; color: rgba(255, 255, 255, 0.75); line-height: 1.5; }

  /* Dark FAQ Accordion */
  .icp-faq-list { display: flex; flex-direction: column; border-top: 1px solid rgba(255, 255, 255, 0.14); }
  .icp-faq-item { border-bottom: 1px solid rgba(255, 255, 255, 0.14); }
  .icp-faq-btn {
    width: 100%;
    background: transparent;
    border: 0;
    color: #ffffff;
    padding: 18px 0;
    text-align: left;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    font-size: 15.5px;
    font-weight: 500;
    cursor: pointer;
  }
  .icp-faq-icon { font-family: var(--icp-font-mono); font-size: 18px; color: rgba(255, 255, 255, 0.65); flex-shrink: 0; }
  .icp-faq-answer { display: none; padding: 0 0 18px; font-size: 14px; line-height: 1.6; color: rgba(255, 255, 255, 0.78); max-width: 76ch; }
  .icp-faq-item.is-open .icp-faq-answer { display: block; }

  /* Workshop & Internal Links Footer */
  .icp-footer-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); gap: 24px; align-items: start; }
  .icp-workshop-card, .icp-links-card {
    background: #ffffff;
    border: 1px solid var(--icp-line);
    border-radius: 10px;
    padding: 20px;
  }
  .icp-workshop-card h3 { margin: 6px 0 8px; font-size: 20px; font-weight: 600; }
  .icp-hours { display: grid; grid-template-columns: 110px 1fr; gap: 4px 12px; font-size: 13.5px; color: var(--icp-fg-2); margin-top: 12px; }
  .icp-links-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
  .icp-links-card h4 { margin: 0 0 8px; font-size: 13.5px; font-weight: 600; }
  .icp-links-card ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 6px; font-size: 13px; }
  .icp-links-card a { color: var(--icp-fg-2); text-decoration: none; }
  .icp-links-card a:hover { color: var(--icp-accent); text-decoration: underline; }

  @media (max-width: 960px) {
    .icp-hero-grid,
    .icp-visual-pair,
    .icp-identify-grid,
    .icp-footer-grid,
    .icp-pillars,
    .icp-cases-grid,
    .icp-reel-card,
    .icp-diag-grid { grid-template-columns: minmax(0, 1fr); }
    .icp-hero-grid > .icp-diagram-stage { margin-top: 22px; }
    .icp-inspector { position: static; }
    .icp-trust-strip { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .icp-trust-cell:nth-child(1), .icp-trust-cell:nth-child(2) { border-bottom: 1px solid #e5e7eb; }
    .icp-trust-cell:nth-child(2), .icp-trust-cell:nth-child(4) { border-right: 0; }
    .icp-warranty.is-open .icp-warranty-body { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 768px) {
    .icp-hero-copy { order: 1; }
    .icp-hero-grid > .icp-trust-strip { order: 2; margin-top: 18px; }
    .icp-hero-grid > .icp-diagram-stage { order: 3; margin-top: 16px; }
  }
  @media (max-width: 600px) {
    .icp-container { padding: 0 16px; }
    .icp-hero { padding: 16px 0 28px; }
    .icp-h1 { font-size: 30px; margin-bottom: 8px; }
    .icp-h2 { font-size: 24px; }
    .icp-lead { font-size: 14.5px; margin-bottom: 14px; }
    .icp-spec-strip { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 6px; }
    .icp-spec-tile { padding: 8px 8px; }
    .icp-spec-label { font-size: 10px; }
    .icp-spec-val { font-size: 12px; }
    .icp-diagram-stage { padding: 12px 14px; }
    .icp-trust-cell { padding: 11px 12px; gap: 9px; }
    .icp-trust-copy strong { font-size: 12px; }
    .icp-trust-copy span { font-size: 10.5px; }
    .icp-pillar-btn { padding: 13px 14px; cursor: pointer; }
    .icp-pillar-plus { display: inline-block; }
    .icp-pillar-body { display: none; padding: 0 14px 13px; font-size: 13px; }
    .icp-pillar.is-open .icp-pillar-body { display: block; }
    .icp-visual-card { padding: 16px; }
    .icp-visual-card-img { min-height: 165px; padding: 12px; }
    .icp-warranty-btn { padding: 16px; flex-direction: column; align-items: flex-start; gap: 10px; }
    .icp-checks, .icp-links-grid { grid-template-columns: minmax(0, 1fr); }
    .icp-identify-form { flex-direction: column; }
    .icp-identify-form .icp-btn-dark { width: 100%; }
    .icp-case-rows li { grid-template-columns: minmax(0, 1fr); gap: 2px; }
    .icp-reel-card { padding: 18px; }
    .icp-floating-cta { right: 16px; bottom: 16px; height: 44px; padding: 0 18px; font-size: 13.5px; }
  }
</style>

<div class="icp-root" data-icp-root="{{ sid }}">
  <section class="icp-hero" id="icp-hero-{{ sid }}">
    <div class="icp-container">
      <nav class="icp-breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span>/</span>
        <a href="/pages/macbook-repairs">MacBook Repairs</a>
        <span>/</span>
        <span class="icp-breadcrumb-current">{{ section.settings.breadcrumb_label | escape }}</span>
      </nav>

      <div class="icp-hero-grid">
        <div class="icp-hero-copy">
          <h1 class="icp-h1">{{ section.settings.hero_title | escape }}</h1>
          <p class="icp-lead">{{ section.settings.hero_lead | escape }}</p>

          <ul class="icp-spec-strip" role="list">
            <li>
              <a class="icp-spec-tile" href="#quote-section">
                <span class="icp-spec-label">{{ section.settings.chip1_label | escape }}</span>
                <span class="icp-spec-val">{{ section.settings.chip1_value | escape }}</span>
              </a>
            </li>
            <li>
              <a class="icp-spec-tile" href="#quote-section">
                <span class="icp-spec-label">{{ section.settings.chip2_label | escape }}</span>
                <span class="icp-spec-val">{{ section.settings.chip2_value | escape }}</span>
              </a>
            </li>
            <li>
              <a class="icp-spec-tile" href="#quote-section">
                <span class="icp-spec-label">{{ section.settings.chip3_label | escape }}</span>
                <span class="icp-spec-val">{{ section.settings.chip3_value | escape }}</span>
              </a>
            </li>
          </ul>
          <p class="icp-note">{{ section.settings.hero_note | escape }}</p>

          <div class="icp-cta-row">
            <a class="icp-btn-dark" href="#quote-section">Get your repair quote &rarr;</a>
            <a class="icp-btn-ghost" href="#bench-cases">See real bench repairs</a>
          </div>
        </div>

