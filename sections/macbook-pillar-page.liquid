        {%- for block in faq_blocks -%}
          {%- assign is_open = false -%}
          {%- if forloop.first -%}{%- assign is_open = true -%}{%- endif -%}
          <div class="icp-faq-item{% if is_open %} is-open{% endif %}" {{ block.shopify_attributes }}>
            <button
              type="button"
              class="icp-faq-btn"
              aria-expanded="{% if is_open %}true{% else %}false{% endif %}"
              aria-controls="icp-faq-panel-{{ section.id }}-{{ forloop.index }}"
              id="icp-faq-btn-{{ section.id }}-{{ forloop.index }}"
            >
              <span>{{ block.settings.question }}</span>
              <span class="icp-chev icp-faq-icon" aria-hidden="true"></span>
            </button>
            <div
              class="icp-faq-answer"
              id="icp-faq-panel-{{ section.id }}-{{ forloop.index }}"
              role="region"
              aria-labelledby="icp-faq-btn-{{ section.id }}-{{ forloop.index }}"
            >
              {{ block.settings.answer }}
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </section>
  {%- endif -%}

  <!-- BAND 11: PRICING PLATES + RELATED STRIP (#fafafa) -->
  <section class="icp-section icp-section-soft" id="prices">
    <div class="icp-container">
      <div class="icp-section-head">
        <h2 class="icp-section-title">{{ section.settings.prices_heading | default: 'Clear diagnostic and repair pricing' }}</h2>
        {%- if section.settings.prices_lead != blank -%}
          <p class="icp-section-lead">{{ section.settings.prices_lead }}</p>
        {%- endif -%}
      </div>

      <ul class="icp-price-strip" aria-label="Diagnostic and repair prices">
        <li>
          <div class="icp-price-chip">
            <span class="icp-price-chip-model">Diagnostic</span>
            <span class="icp-price-chip-val">£49</span>
            <span class="icp-price-chip-sub">Credited in full if you go ahead</span>
          </div>
        </li>
        <li>
          <div class="icp-price-chip">
            <span class="icp-price-chip-model">Board repair</span>
            <span class="icp-price-chip-val">from £249</span>
            <span class="icp-price-chip-sub">Fixed written quote before any repair</span>
          </div>
        </li>
        <li>
          <div class="icp-price-chip">
            <span class="icp-price-chip-model">Collection and return</span>
            <span class="icp-price-chip-val">Included</span>
            <span class="icp-price-chip-sub">Insured UK courier, even if you decline</span>
          </div>
        </li>
      </ul>

      {%- assign related_blocks = section.blocks | where: 'type', 'related_link' -%}
      {%- if related_blocks.size > 0 -%}
      <div class="icp-related-strip">
        <div class="icp-related-strip-head">
          <h3>Related MacBook repairs</h3>
        </div>
        <ul class="icp-related-links-row">
          {%- for block in related_blocks -%}
          <li {{ block.shopify_attributes }}>
            <a href="{{ block.settings.url }}">
              <span>{{ block.settings.label }}</span>
              <span class="icp-chev-right" aria-hidden="true"></span>
            </a>
          </li>
          {%- endfor -%}
        </ul>
      </div>
      {%- endif -%}
    </div>
  </section>

  <!-- BAND 12: DARK CLOSING CTA (#111827, compact) -->
  <section class="icp-section icp-section-dark icp-section-compact" id="closing-cta">
    <div class="icp-container">
      <div class="icp-closing-cta-band">
        <div class="icp-closing-cta-top">
          <h2>{{ section.settings.closing_heading }}</h2>
          <a class="icp-btn-white" href="#quote-section">{{ cta_label }}</a>
        </div>
        <ul class="icp-closing-stamps" aria-label="Booking summary">
          <li class="icp-closing-stamp">
            <span class="icp-closing-stamp-val">£49 diagnostic</span>
            <span class="icp-closing-stamp-sub">Credited to repair, collection and return included</span>
          </li>
          <li class="icp-closing-stamp">
            <span class="icp-closing-stamp-val">1 working day</span>
            <span class="icp-closing-stamp-sub">Written fault report and fixed repair quote</span>
          </li>
          <li class="icp-closing-stamp">
            <span class="icp-closing-stamp-val">2-year warranty</span>
            <span class="icp-closing-stamp-sub">On the repaired circuits and replaced components</span>
          </li>
        </ul>
      </div>
    </div>
  </section>

  {%- if in_preview_wrapper == true or section.settings.show_footer_bar -%}
  <!-- BAND 13: COMPACT DARK FOOTER (#0b101b) -->
  <footer class="icp-site-footer">
    <div class="icp-container icp-site-footer-inner">
      <span>iCorrect &middot; 12 Margaret Street, Fitzrovia, London W1W 8JQ &middot; Mon to Fri 9am to 6pm. Sat &amp; Sun Closed.</span>
      <span><a href="tel:+442070998517">020 7099 8517</a> &middot; <a href="/pages/macbook-repairs">MacBook repairs</a></span>
    </div>
  </footer>
  {%- endif -%}

  <!-- MOBILE-ONLY DOCKED BOTTOM CTA BAR (<= 768px) -->
  <div class="icp-mobile-sticky-bar" id="icp-mobile-sticky-bar" aria-hidden="true">
    <a class="icp-btn-dark" id="icp-mobile-sticky-cta" href="#quote-section" tabindex="-1">{{ cta_label }}</a>
  </div>

  <script>
    (function () {
      if (window.__icpPillarInit) return;
      window.__icpPillarInit = true;

      /* Mobile docked CTA bar: visible only <= 768px when scrolled past hero and outside wizard, closing CTA, and footer */
      var mobileBar = document.getElementById("icp-mobile-sticky-bar");
      var mobileCta = document.getElementById("icp-mobile-sticky-cta");
      var heroActions = document.getElementById("hero-actions");
      var quoteSection = document.getElementById("quote-section");
      var closingCta = document.getElementById("closing-cta");
      var siteFooter = document.querySelector(".icp-site-footer, footer");
      var heroInView = true;
      var quoteInView = false;
      var closingInView = false;
      var footerInView = false;

      function syncMobileBar() {
        if (!mobileBar || !mobileCta) return;
        var isMobile = window.innerWidth <= 768;
        var show = isMobile && !heroInView && !quoteInView && !closingInView && !footerInView;
        mobileBar.classList.toggle("is-visible", show);
        mobileBar.setAttribute("aria-hidden", String(!show));
        if (show) mobileCta.removeAttribute("tabindex");
        else mobileCta.setAttribute("tabindex", "-1");
      }

      if ("IntersectionObserver" in window) {
        if (heroActions) {
          new IntersectionObserver(function (entries) {
            heroInView = entries[entries.length - 1].isIntersecting;
            syncMobileBar();
          }, { rootMargin: "-52px 0px 0px 0px" }).observe(heroActions);
        }
        if (quoteSection) {
          new IntersectionObserver(function (entries) {
            quoteInView = entries[entries.length - 1].isIntersecting;
            syncMobileBar();
          }, { rootMargin: "-52px 0px 0px 0px", threshold: 0.01 }).observe(quoteSection);
        }
        if (closingCta) {
          new IntersectionObserver(function (entries) {
            closingInView = entries[entries.length - 1].isIntersecting;
            syncMobileBar();
          }, { rootMargin: "0px 0px 40px 0px", threshold: 0.01 }).observe(closingCta);
        }
        if (siteFooter) {
          new IntersectionObserver(function (entries) {
            footerInView = entries[entries.length - 1].isIntersecting;
            syncMobileBar();
          }, { rootMargin: "0px 0px 40px 0px", threshold: 0.01 }).observe(siteFooter);
        }
      } else {
        window.addEventListener("scroll", function () {
          heroInView = window.scrollY <= 220;
          syncMobileBar();
        }, { passive: true });
      }
      window.addEventListener("resize", syncMobileBar, { passive: true });
      syncMobileBar();

      /* Trustindex widget: collapse empty slot and show fallback link if loader has not mounted after 4s */
      var tiSlot = document.getElementById("trustindex-reviews-slot");
      var tiFallback = document.getElementById("trustindex-fallback");
      var tiTimedOut = false;
      function syncReviewsSlot() {
        if (!tiSlot || !tiFallback) return;
        var mounted = !!tiSlot.querySelector(".ti-widget");
        tiSlot.classList.toggle("is-empty", tiTimedOut && !mounted);
        tiFallback.hidden = mounted || !tiTimedOut;
      }
      if (tiSlot && tiFallback) {
        window.setTimeout(function () { tiTimedOut = true; syncReviewsSlot(); }, 4000);
        if ("MutationObserver" in window) {
          new MutationObserver(syncReviewsSlot).observe(tiSlot, { childList: true, subtree: true });
        }
      }

      /* White FAQ accordion */
      document.querySelectorAll("[data-icp-faq-list] .icp-faq-btn").forEach(function (btn) {
        btn.addEventListener("click", function () {
          var item = btn.closest(".icp-faq-item");
          if (!item) return;
          var open = !item.classList.contains("is-open");
          item.classList.toggle("is-open", open);
          btn.setAttribute("aria-expanded", String(open));
        });
      });

      /* Model A-number finder */
      var MODELS = {
        A3240: 'MacBook Air 13" M4 (2025)',
        A3241: 'MacBook Air 15" M4 (2025)',
        A3113: 'MacBook Air 13" M3 (2024)',
        A3114: 'MacBook Air 15" M3 (2024)',
        A2941: 'MacBook Air 15" M2 (2023)',
        A2681: 'MacBook Air 13" M2 (2022)',
        A2337: 'MacBook Air 13" M1 (2020)',
        A2179: 'MacBook Air 13" (2020)',
        A1932: 'MacBook Air 13" (2018 to 2019)',
        A3112: 'MacBook Pro 14" M4 (2024)',
        A3401: 'MacBook Pro 14" M4 Pro (2024)',
        A3185: 'MacBook Pro 14" M4 Max (2024)',
        A3403: 'MacBook Pro 16" M4 Pro (2024)',
        A3186: 'MacBook Pro 16" M4 Max (2024)',
        A2918: 'MacBook Pro 14" M3 (2023)',
        A2992: 'MacBook Pro 14" M3 Pro / Max (2023)',
        A2991: 'MacBook Pro 16" M3 Pro / Max (2023)',
        A2779: 'MacBook Pro 14" M2 Pro / Max (2023)',
        A2780: 'MacBook Pro 16" M2 Pro / Max (2023)',
        A2442: 'MacBook Pro 14" M1 Pro / Max (2021)',
        A2485: 'MacBook Pro 16" M1 Pro / Max (2021)',
        A2338: 'MacBook Pro 13" M1 / M2 (2020 to 2022)',
        A2251: 'MacBook Pro 13" (2020)',
        A2289: 'MacBook Pro 13" (2020)',
        A2141: 'MacBook Pro 16" (2019)',
        A2159: 'MacBook Pro 13" (2019)',
        A1989: 'MacBook Pro 13" (2018 to 2019)',
        A1990: 'MacBook Pro 15" (2018 to 2019)',
        A1706: 'MacBook Pro 13" (2016 to 2017)',
        A1707: 'MacBook Pro 15" (2016 to 2017)',
        A1708: 'MacBook Pro 13" (2016 to 2017)'
      };

      document.querySelectorAll("[data-icp-identify-form]").forEach(function (form) {
        var input = form.querySelector("input");
        var err = form.parentNode.querySelector(".icp-identify-error");
        var res = form.parentNode.querySelector("[data-icp-identify-result]");
        if (!input || !err || !res) return;

        form.addEventListener("submit", function (e) {
          e.preventDefault();
          var raw = (input.value || "").trim().toUpperCase().replace(/\s+/g, "");
          if (/^\d{4}$/.test(raw)) raw = "A" + raw;
          if (!/^A\d{4}$/.test(raw)) {
            input.setAttribute("aria-invalid", "true");
            err.textContent = "Enter a 4-digit A-number from the underside of your MacBook, for example A2442.";
            err.hidden = false;
            res.classList.remove("is-visible");
            res.innerHTML = "";
            input.focus();
            return;
          }
          var name = MODELS[raw];
          if (!name) {
            input.setAttribute("aria-invalid", "true");
            err.textContent = "We did not recognise " + raw + ". Choose your MacBook directly in the quote tool below or call 020 7099 8517.";
            err.hidden = false;
            res.classList.remove("is-visible");
            res.innerHTML = "";
            return;
          }
          input.removeAttribute("aria-invalid");
          err.hidden = true;
          err.textContent = "";
          res.innerHTML =
            "<span><strong>" + name + " (" + raw + ").</strong> Diagnostic £49, board repairs from £249.</span>" +
            '<a class="icp-btn-ghost" href="#quote-section">Open in quote tool</a>';
          res.classList.add("is-visible");
        });
      });
    })();
  </script>

  {%- endif -%}
</div>

