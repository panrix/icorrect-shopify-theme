{% comment %}
  Section: Homepage Videos
  Redesigned click-to-play 3-video panel using snippets/icorrect-video-panel.liquid.
  Preserves all existing Theme Customizer settings across templates.
{% endcomment %}

{%- render 'icorrect-video-panel',
  section: section,
  kicker: 'Inside Our Fitzrovia Workshop · Never Outsourced',
  badge: 'Fitzrovia Bench · In-House',
  tag_prefix: 'Fitzrovia Bench',
  default_heading: 'Behind the scenes',
  default_subtitle: 'Watch our workshop videos to see how we diagnose and repair Apple devices to component level.',
  video_1_id: '9Wemn_gR5IE',
  video_1_fallback_title: 'Microelectronics repair at specialist level',
  video_1_aria: 'Why microelectronics repair keeps original Apple hardware alive',
  video_1_default_desc: 'Why our Fitzrovia technicians focus on component-level microelectronics repair rather than swapping whole assemblies.',
  video_2_id: 'SVbeyRWUeh0',
  video_2_fallback_title: 'A more sustainable repair approach',
  video_2_aria: 'How component-level MacBook repair is more sustainable than full replacement',
  video_2_default_desc: 'Fixing the single failed circuit or display panel instead of scrapping working Apple hardware.',
  video_3_id: 'SdkVy0q5XsQ',
  video_3_fallback_title: 'Too broken for the Apple Store? Just right for us',
  video_3_aria: 'Component-level repairs for Apple devices quoted for full replacement',
  video_3_default_desc: 'How board-level diagnostics recover liquid-damaged and dead Apple devices when full replacement is quoted.'
-%}

{% schema %}
{
  "name": "Homepage Videos",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Title",
      "default": "Behind the scenes"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Watch our videos to understand common repair issues, what to expect, and how we fix your device with care."
    },
    {
      "type": "text",
      "id": "video_1_title",
      "label": "Video 1 title (under video)",
      "default": "Microelectronics repair at specialist level"
    },
    {
      "type": "text",
      "id": "video_1_desc",
      "label": "Video 1 caption (optional)"
    },
    {
      "type": "text",
      "id": "video_2_title",
      "label": "Video 2 title (under video)",
      "default": "A more sustainable repair approach"
    },
    {
      "type": "text",
      "id": "video_2_desc",
      "label": "Video 2 caption (optional)"
    },
    {
      "type": "text",
      "id": "video_3_title",
      "label": "Video 3 title (under video)",
      "default": "Too broken for the Apple Store? Just right for us"
    },
    {
      "type": "text",
      "id": "video_3_desc",
      "label": "Video 3 caption (optional)"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "Homepage Videos"
    }
  ]
}
{% endschema %}
